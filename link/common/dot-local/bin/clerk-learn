#!/usr/bin/env python3
"""clerk learn — append a run's learning to the file the next run reads.

The block's shape is fixed, and so is where it goes: `tasks/learnings.md`, beside the
breakdowns, in the repo the learnings are about. That path hangs off the *repo root*, and
by the time this step runs the session is standing in a worktree, which is not that
directory. A run that resolves it by hand from its cwd writes a file nothing will ever
read again, and nothing about the result says so — the append succeeds, the text is
there, and the next run reads the real file and finds it empty.

So the path is asked for rather than derived, defaulting to what `clerk prepare` resolves
(from the repo root, whatever the cwd) and taking --path for the case that override
exists to serve: a caller fanning several runs over one story gives each its own file,
because they share a git-common-dir and would otherwise append over each other.

What stays judgment is the whole of the content — whether a candidate survives the
falsifiable filter, and whether it duplicates an existing entry *in substance*. This only
settles the mechanical half of that second one: an exact title collision, refused rather
than appended twice. `--list` prints what is already there so substance can be judged
before writing.

The file only ever grew, and it is read whole by the run that plans the next story: at 225
entries one was 40k words, so a decompose carried fifty thousand tokens of history before
it saw the story. `--index` answers that — every entry's title, type and apply-when, which
is a sixth of the bytes and the whole of what picking needs — and `--show` fetches the
bodies worth reading. `--drop` is the other half: nothing could retire an entry that had
gone stale, so a learning written against code since rewritten stayed true-sounding
forever.

Dispatched to by `clerk` when invoked as `clerk learn`, and runnable on its own.
"""

import re
import sys
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from clerk_lib import Parser, die, emit, facts, git  # noqa: E402

TYPES = ["convention", "recurring-finding", "constraint", "pattern"]

HEADER = "# Implementation learnings\n"

TITLE = re.compile(r"^## +(.*?)\s*$")
FIELD = re.compile(r"^- ([A-Za-z ]+): (.*)$", re.M)


def resolve_path(explicit):
    if explicit:
        return Path(explicit).expanduser()
    p = facts().get("learnings_path")
    if not p:
        die("clerk prepare resolved no learnings_path; pass --path")
    return Path(p)


def in_repo_history(path):
    """Whether git would ever track this file: inside the repo, and not ignored."""
    r = git("rev-parse", "--path-format=absolute", "--git-common-dir")
    if r.returncode != 0:
        return False
    root = Path(r.stdout.strip()).parent
    try:
        path.resolve().relative_to(root.resolve())
    except ValueError:
        return False
    return git("check-ignore", "-q", str(path), cwd=root).returncode != 0


def existing_titles(path):
    if not path.is_file():
        return []
    return [m.group(1) for line in path.read_text().splitlines() if (m := TITLE.match(line))]


def entries(path):
    """Each recorded entry as (title, field dict, raw block). The file is append-only
    markdown, so a block runs from its heading to the next one."""
    if not path.is_file():
        return []
    lines = path.read_text().splitlines(keepends=True)
    starts = [i for i, l in enumerate(lines) if TITLE.match(l)]
    out = []
    for n, i in enumerate(starts):
        end = starts[n + 1] if n + 1 < len(starts) else len(lines)
        block = "".join(lines[i:end])
        fields = {m.group(1).strip().lower().replace(" ", "_"): m.group(2).strip()
                  for m in FIELD.finditer(block)}
        out.append((TITLE.match(lines[i]).group(1), fields, block.rstrip("\n")))
    return out


def cut(path, title):
    """Remove one entry, returning its block or None."""
    lines = path.read_text().splitlines(keepends=True)
    starts = [i for i, l in enumerate(lines) if (m := TITLE.match(l)) and m.group(1) == title]
    if not starts:
        return None
    start = starts[0]
    end = next((i for i in range(start + 1, len(lines)) if TITLE.match(lines[i])), len(lines))
    block = "".join(lines[start:end])
    path.write_text("".join(lines[:start]) + "".join(lines[end:]))
    return block.rstrip("\n")


def main():
    ap = Parser()
    ap.add_argument("--type", choices=TYPES)
    ap.add_argument("--title")
    ap.add_argument("--learning")
    ap.add_argument("--apply-when", dest="apply_when")
    ap.add_argument("--task", default="", help="the task number(s) this was observed in")
    ap.add_argument("--feature", default="", help="the feature the run was building")
    ap.add_argument("--path", help="the learnings file; defaults to what clerk prepare resolves")
    ap.add_argument("--replace", action="store_true", help="rewrite an entry with this title")
    ap.add_argument("--list", action="store_true", help="what is already recorded")
    ap.add_argument("--index", action="store_true", help="title, type and apply-when per entry")
    ap.add_argument("--show", action="append", default=[], metavar="TITLE",
                    help="the full entry with this title; repeatable")
    ap.add_argument("--drop", metavar="TITLE", help="remove the entry with this title")
    args = ap.parse_args()

    if args.help:
        print(__doc__.strip())
        print("\nUSAGE\n  clerk learn --type <t> --title <s> --learning <s> --apply-when <s>"
              "\n              [--task N[,M]] [--feature <s>] [--path <f>] [--replace]"
              "\n  clerk learn --list [--path <f>]           titles only"
              "\n  clerk learn --index [--path <f>]          title, type and apply-when: what picking needs"
              "\n  clerk learn --show <title> [--show <t>]   the full entry for the ones worth reading"
              "\n  clerk learn --drop <title>                retire an entry that has gone stale"
              f"\n\nTYPES\n  {' · '.join(TYPES)}")
        return 0

    path = resolve_path(args.path)

    if args.list:
        emit({"ok": True, "path": str(path), "exists": path.is_file(),
              "titles": existing_titles(path)})

    if args.index:
        rows = [{"title": ttl, "type": f.get("type"), "apply_when": f.get("apply_when"),
                 "recorded": f.get("recorded"), "observed": f.get("observed")}
                for ttl, f, _ in entries(path)]
        emit({"ok": True, "path": str(path), "exists": path.is_file(), "entries": len(rows),
              "index": rows,
              "note": "read `apply_when` to pick, then `clerk learn --show <title>` for the "
                      "bodies. Passing every body to a planner costs far more than it teaches"})

    if args.show:
        by_title = {ttl: block for ttl, _, block in entries(path)}
        found = {t_: by_title[t_] for t_ in args.show if t_ in by_title}
        missing = [t_ for t_ in args.show if t_ not in by_title]
        emit({"ok": not missing, "path": str(path), "entries": found, "not_found": missing},
             0 if not missing else 3)

    if args.drop:
        if not path.is_file():
            die(f"no learnings file at {path}", 1)
        block = cut(path, args.drop)
        if block is None:
            emit({"ok": False, "reason": "no-such-title", "title": args.drop,
                  "detail": "nothing recorded under that title; read --index for what is there"}, 3)
        emit({"ok": True, "path": str(path), "dropped": args.drop, "block": block,
              "entries": len(existing_titles(path)),
              "note": "retiring a learning changes what every later run in this repo reads, "
                      "the same as writing one — commit it if the file is tracked"})

    missing = [n for n, v in (("--type", args.type), ("--title", args.title),
                              ("--learning", args.learning),
                              ("--apply-when", args.apply_when)) if not v]
    if missing:
        die(f"missing {', '.join(missing)} — every field of the block is required, because "
            f"an entry without one is the entry a later run cannot act on")

    titles = existing_titles(path)
    if args.title in titles and not args.replace:
        emit({"ok": False, "reason": "duplicate-title", "title": args.title,
              "detail": "already recorded. Dedup on substance is yours to judge — read it with "
                        "--list, then either fold your wording into it with --replace or give "
                        "this one its own title"}, 3)

    # The dash joins two parts, so it only belongs when there are two. A run that names
    # its feature and not a task is ordinary — the learning came from the whole of it
    # rather than one step — and it was rendering as "Observed: — US-014", which reads
    # like the task number went missing.
    observed = " — ".join(x for x in [
        f"task {args.task}" if args.task else "",
        args.feature,
    ] if x) or "this run"

    block = (f"\n## {args.title}\n"
             f"- Type: {args.type}\n"
             f"- Recorded: {datetime.now(timezone.utc).strftime('%Y-%m-%d')}\n"
             f"- Observed: {observed}\n"
             f"- Learning: {args.learning}\n"
             f"- Apply when: {args.apply_when}\n")

    path.parent.mkdir(parents=True, exist_ok=True)
    replaced = False
    if args.replace and args.title in titles:
        lines = path.read_text().splitlines(keepends=True)
        starts = [i for i, l in enumerate(lines) if (m := TITLE.match(l)) and m.group(1) == args.title]
        start = starts[0]
        end = next((i for i in range(start + 1, len(lines)) if TITLE.match(lines[i])), len(lines))
        path.write_text("".join(lines[:start]) + block.lstrip("\n") + "".join(lines[end:]))
        replaced = True
    else:
        if not path.is_file():
            path.write_text(HEADER)
        with path.open("a") as fh:
            fh.write(block)

    # Whether to commit it is a decision and stays with the caller: writing changes what
    # your next run reads, committing changes what everyone's does. Containment is asked
    # first, because `git check-ignore` answers "not ignored" for a path outside the repo
    # entirely, and reading that as "tracked" would tell the caller to commit a file git
    # has never heard of.
    tracked = in_repo_history(path)
    emit({"ok": True, "path": str(path), "title": args.title, "type": args.type,
          "replaced": replaced, "entries": len(existing_titles(path)),
          "in_tree": tracked,
          "note": ("this file is in the repo and not ignored, so committing it is what makes "
                   "teammates inherit the learning — and leaving it uncommitted leaves the "
                   "tree dirty for the next run" if tracked else
                   "git will not keep this file — it is ignored, or outside the repo — so "
                   "nothing here dirties the tree and nothing here reaches a teammate")})


if __name__ == "__main__":
    sys.exit(main())
