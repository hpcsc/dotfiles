.netrwhist
*.log
__pycache__
.idea
bin
# ...but not the stow package that ships executables to ~/.local/bin. The bare `bin`
# above is unanchored, so it swallowed this whole package and nothing in it could ever
# be committed or stowed.
!link/common/dot-local/bin/
*.alfredworkflow
.task

# Working documents — proposals, notes, diagram sources. clerk treats a dirty tree as a
# blocker at ground, verify and land, so an untracked scratch directory would stop every
# run in this repo until it was cleared.
.scratches/

# Claude Code downloads the skills of the claude.ai account here, through the ~/.claude/skills symlink.
link/common/claude/.claude/skills/synced/

# fnox: machine-specific secret overrides sit beside config.toml
link/common/dot-config/.config/fnox/local.toml
