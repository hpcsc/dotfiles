#!/usr/bin/env python3
"""clerk lint — the conventions that can be checked rather than reviewed.

Every rule here was already written down and already enforced by a reviewer reading code
and forming a judgment. That works, and it is the most expensive way to apply a rule that
a regex settles: an audit raised 773 findings to confirm 282, and each refuted one cost a
verifier agent minutes of execution to establish that nothing was wrong. A rule checked
here never enters that pipeline — no agent, no verification, no false positive to refute.

So the bar for adding a rule is not "is this in the guidelines" but "does this decide
without judgment". A check that needs a human to say "well, it depends" belongs in a
guideline for a reviewer to weigh, not in this file.

Rules:
  comment-plan-position   a comment naming code by its plan position, ticket or task
  test-umbrella           scenario-named sibling tests that belong under one umbrella
  type-methods-split      a method living apart from the file declaring its type
  certainty-unevidenced   a task assessed high/medium certainty with no precedent behind it

Dispatched to by `clerk` when invoked as `clerk lint`, and runnable on its own.
"""

import json
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from clerk_lib import Parser, die, facts, git  # noqa: E402


# ---------------------------------------------------------------------------
# What to look at
# ---------------------------------------------------------------------------

def diff_range(root, base, staged):
    if staged:
        return ["--cached"]
    if base:
        return [f"{base}...HEAD"]
    for ref in ("origin/HEAD", "origin/main", "origin/master", "main", "master"):
        r = git("merge-base", "HEAD", ref, cwd=root)
        if r.returncode == 0 and r.stdout.strip():
            return [f"{r.stdout.strip()}...HEAD"]
    return ["--cached"]


def normalise(root, p):
    """A path every rule can resolve against root. `./x` and `x` name the same file; an
    absolute path inside the tree is made relative to it, and one outside is left alone —
    `Path(root) / <absolute>` is that absolute path, so it still resolves.

    Spelt out rather than `lstrip("./")`, which strips characters and not a prefix: it eats
    the leading dot of `.github/workflows/ci.yml` and every leading slash of an absolute
    path, leaving a relative path that matches nothing. A rule that silently checks nothing
    is indistinguishable from a rule that found nothing wrong."""
    q = Path(p)
    if q.is_absolute():
        try:
            return str(q.resolve().relative_to(Path(root).resolve()))
        except (ValueError, OSError):
            return str(q)
    s = str(q)
    return s[2:] if s.startswith("./") else s


def changed_files(root, rng):
    r = git("diff", "--name-only", "--diff-filter=ACMR", *rng, cwd=root)
    if r.returncode != 0:
        # Not an empty set. A diff that could not run would otherwise report "clean — 0
        # file(s)" with exit 0, and `clerk finish` would take that as a pass.
        die(f"git diff {' '.join(rng)} failed: {r.stderr.strip() or 'no reason given'}")
    return [l for l in r.stdout.splitlines() if l]


def added_lines(root, path, rng):
    """(line number in the new file, text) for lines this change introduced. Linting whole
    files instead would report every comment written before the rule existed, which is the
    fastest way to have a check switched off."""
    r = git("diff", "-U0", *rng, "--", path, cwd=root)
    if r.returncode != 0:
        die(f"git diff {' '.join(rng)} -- {path} failed: {r.stderr.strip() or 'no reason given'}")
    lines, n = [], 0
    for raw in r.stdout.splitlines():
        h = re.match(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", raw)
        if h:
            n = int(h.group(1))
            continue
        if raw.startswith("+++") or raw.startswith("---"):
            continue
        if raw.startswith("+"):
            lines.append((n, raw[1:]))
            n += 1
    return lines


# ---------------------------------------------------------------------------
# comment-plan-position
# ---------------------------------------------------------------------------

LINE_COMMENT = {".go": "//", ".js": "//", ".jsx": "//", ".ts": "//", ".tsx": "//",
                ".java": "//", ".rs": "//", ".c": "//", ".h": "//", ".cpp": "//",
                ".py": "#", ".sh": "#", ".bash": "#", ".zsh": "#", ".rb": "#",
                ".yaml": "#", ".yml": "#", ".ex": "#", ".exs": "#", ".cue": "//"}

STRINGS = re.compile(r'"(?:[^"\\]|\\.)*"|\'(?:[^\'\\]|\\.)*\'|`[^`]*`')

# Standards that read exactly like a ticket id. Without these, every mention of UTF-8 or
# RFC 2616 is reported as a ticket reference.
NOT_A_TICKET = {"UTF", "SHA", "RFC", "ISO", "HTTP", "HTTPS", "MD", "AES", "RSA", "PKCS",
                "IEEE", "ANSI", "ASCII", "UTC", "GMT", "ISBN", "EAN", "SP", "NIST",
                "FIPS", "CVE", "IPV", "TLS", "SSL", "X", "EC", "PBKDF", "HMAC", "BASE"}

PATTERNS = [
    (re.compile(r"\b(?:PR|pr)\s+\d+\b"), "names a pull request"),
    (re.compile(r"\b[Tt]ask\s+\d+\b"), "names a task by its number"),
    (re.compile(r"\b[Ss]tep\s+\d+\b"), "names a step by its number"),
    (re.compile(r"\b[Pp]hase\s+\d+\b"), "names a phase by its number"),
    (re.compile(r"\b[Ww]ave\s+\d+\b"), "names a wave by its number"),
    (re.compile(r"\b(?:deliverable|slice)\s+\d+\b", re.I), "names a deliverable by its position"),
    (re.compile(r"\bdesign\s+(?:note|doc|document)\b", re.I), "cites a design document"),
    (re.compile(r"\bthe\s+new\s+(?:helper|function|func|method|type|struct|interface|field|"
                r"var|variable|param|parameter|arg|argument|file|package|test|case|branch|"
                r"flag|hook|handler|column|table|endpoint|route)\b", re.I),
     "names code as \"the new\" one, which stops being true"),
    (re.compile(r"\b(?:added|removed|renamed|changed|updated)\s+(?:for|the\s+old|in\s+this\s+(?:PR|commit|change))\b", re.I),
     "narrates the change rather than the code"),
]

TICKET = re.compile(r"\b([A-Z][A-Z0-9]{1,9})-(\d+)\b")

HEREDOC_SUFFIXES = {".sh", ".bash", ".zsh"}
# (?<!<) and (?!<): a here-string `<<<word` is not a heredoc and must not open one.
HEREDOC = re.compile(r"(?<!<)<<-?(?!<)\s*(?:'([A-Za-z_][A-Za-z0-9_]*)'"
                     r"|\"([A-Za-z_][A-Za-z0-9_]*)\"|([A-Za-z_][A-Za-z0-9_]*))")


def heredoc_lines(text):
    """Line numbers of heredoc bodies. A `#` there is content the script writes out, not a
    comment — a fixture breakdown with `### Task 1:` headings is the usual case."""
    inside, term, strip_tabs = set(), None, False
    for n, line in enumerate(text.splitlines(), 1):
        if term is not None:
            inside.add(n)
            if (line.lstrip("\t") if strip_tabs else line) == term:
                term = None
            continue
        quoted = [m.span() for m in STRINGS.finditer(line)]
        blanked = STRINGS.sub(lambda m: " " * len(m.group(0)), line)
        comment_at = blanked.find("#")
        for m in HEREDOC.finditer(line):
            if any(a <= m.start() < b for a, b in quoted):
                continue
            if 0 <= comment_at < m.start():
                break
            term = m.group(1) or m.group(2) or m.group(3)
            strip_tabs = m.group(0).startswith("<<-")
            break
    return inside


def new_side_text(root, path, rng):
    """The file as the diff's new side has it: the index under --cached, else HEAD."""
    spec = f":{path}" if rng == ["--cached"] else f"HEAD:{path}"
    r = git("show", spec, cwd=root)
    return r.stdout if r.returncode == 0 else ""


def comment_text(line, marker):
    """The comment part of a line, or None. String literals are stripped first so a URL
    containing // is not read as the start of a comment."""
    stripped = STRINGS.sub(lambda m: " " * len(m.group(0)), line)
    i = stripped.find(marker)
    if i < 0:
        # /* ... */ on one line, the other shape a reviewer would call a comment.
        m = re.search(r"/\*(.*?)\*/", stripped)
        return m.group(1) if m else None
    return line[i + len(marker):]


def check_comments(root, path, rng):
    marker = LINE_COMMENT.get(Path(path).suffix)
    if not marker:
        return []
    out = []
    skip = heredoc_lines(new_side_text(root, path, rng)) if Path(path).suffix in HEREDOC_SUFFIXES else set()
    for n, line in added_lines(root, path, rng):
        if n in skip:
            continue
        text = comment_text(line, marker)
        if not text or not text.strip():
            continue
        for pat, why in PATTERNS:
            m = pat.search(text)
            if m:
                out.append((path, n, "comment-plan-position",
                            f"{why}: \"{m.group(0).strip()}\""))
                break
        else:
            m = TICKET.search(text)
            if m and m.group(1) not in NOT_A_TICKET:
                out.append((path, n, "comment-plan-position",
                            f"cites a ticket id: \"{m.group(0)}\""))
    return out


# ---------------------------------------------------------------------------
# test-umbrella
# ---------------------------------------------------------------------------

GO_TEST = re.compile(r"^func\s+(Test[A-Z]\w*)\s*\(")
CAMEL = re.compile(r"[A-Z][a-z0-9]*")

# Third-person verbs that start a scenario name. Precision matters more than recall here:
# TestUser / TestUserService / TestUserRepo are three types and must not be reported, while
# TestReactorOpensNewCase / TestReactorAttachesToExistingCase are one type's scenarios.
SCENARIO_VERBS = {
    "Opens", "Closes", "Returns", "Creates", "Rejects", "Accepts", "Handles", "Sends",
    "Fails", "Succeeds", "Adds", "Removes", "Updates", "Deletes", "Marks", "Skips",
    "Ignores", "Keeps", "Stops", "Starts", "Emits", "Writes", "Reads", "Parses",
    "Validates", "Attaches", "Detaches", "Sets", "Gets", "Finds", "Lists", "Counts",
    "Applies", "Records", "Reports", "Resolves", "Carries", "Drops", "Allows", "Denies",
    "Refuses", "Raises", "Panics", "Waits", "Retries", "Loads", "Saves", "Stores",
    "Fetches", "Renders", "Formats", "Encodes", "Decodes", "Filters", "Sorts", "Merges",
    "Splits", "Copies", "Moves", "Locks", "Unlocks", "Flushes", "Truncates", "Expires",
}


def check_test_umbrella(root, path):
    if not path.endswith("_test.go"):
        return []
    try:
        text = (Path(root) / path).read_text()
    except OSError:
        return []
    tests = []
    for i, line in enumerate(text.splitlines(), 1):
        m = GO_TEST.match(line)
        if m:
            tests.append((m.group(1), i))
    groups = {}
    for name, ln in tests:
        words = CAMEL.findall(name[len("Test"):])
        if words:
            groups.setdefault(words[0], []).append((name, ln, words))
    out = []
    for head, members in sorted(groups.items()):
        if len(members) < 3:
            continue
        scenarios = [m for m in members if len(m[2]) > 1 and m[2][1] in SCENARIO_VERBS]
        if len(scenarios) < 2:
            continue
        names = ", ".join(m[0] for m in members)
        out.append((path, members[0][1], "test-umbrella",
                    f"{len(members)} top-level tests share Test{head} and read as scenarios "
                    f"({names}) — one Test{head} wrapping them with t.Run is the convention"))
    return out


# ---------------------------------------------------------------------------
# type-methods-split
# ---------------------------------------------------------------------------

# These two see a line, not a declaration, and two idiomatic shapes get past them: a
# grouped `type ( ... )` block, where the names are indented and `type` is on its own
# line, and a generic `type Box[T any]`, where no space follows the name. Both produce a
# FALSE NEGATIVE — the rule reports clean rather than reporting a doubt — so read a clean
# result here as "no split found in the shapes below", not as "no split". Fixing it means
# a go/ast pass, where TypeSpec and FuncDecl.Recv answer both without string handling.
GO_TYPE = re.compile(r"^type\s+(\w+)\s")
GO_METHOD = re.compile(r"^func\s+\(\s*\w*\s*\*?(\w+)")
GENERATED = re.compile(r"^//\s*Code generated .* DO NOT EDIT\.", re.M)
BUILD_TAG = re.compile(r"^//(?:go:build|\s*\+build)", re.M)


def go_package_files(root, path):
    d = (Path(root) / path).parent
    try:
        return sorted(p for p in d.glob("*.go") if not p.name.endswith("_test.go"))
    except OSError:
        return []


def check_type_methods(root, path, seen_pkgs, scope):
    """A method on T living outside T's file. Reported against the file holding the stray
    method, since that is the one to move it out of.

    The whole package has to be read to know where a type is declared, but only splits
    touching a file under review are reported: a package can hold a layout that predates
    this rule, and re-reporting all of it on every unrelated change is how a check gets
    switched off."""
    if not path.endswith(".go") or path.endswith("_test.go"):
        return []
    d = str((Path(root) / path).parent)
    if d in seen_pkgs:
        return []
    seen_pkgs.add(d)

    declared, methods = {}, []
    for f in go_package_files(root, path):
        try:
            text = f.read_text()
        except OSError:
            continue
        # Both exemptions the guideline names: neither can live in the declaring file.
        if GENERATED.search(text) or BUILD_TAG.search(text):
            continue
        for i, line in enumerate(text.splitlines(), 1):
            t = GO_TYPE.match(line)
            if t:
                declared.setdefault(t.group(1), (f.name, i))
                continue
            m = GO_METHOD.match(line)
            if m:
                methods.append((m.group(1), f.name, i))

    # One finding per (stray file, declaring file). Five methods moved out of one type's
    # file is one structural decision and one fix; reporting it five times would bury the
    # rest of the run under a single problem.
    groups = {}
    for recv, fname, ln in methods:
        home = declared.get(recv)
        if home and home[0] != fname:
            g = groups.setdefault((fname, home[0]), {"line": ln, "types": []})
            g["line"] = min(g["line"], ln)
            if recv not in g["types"]:
                g["types"].append(recv)

    out = []
    parent = Path(path).parent
    for (fname, home), g in sorted(groups.items()):
        if str(parent / fname) not in scope and str(parent / home) not in scope:
            continue
        types = ", ".join(g["types"])
        out.append((str(parent / fname), g["line"], "type-methods-split",
                    f"adds methods to {types}, declared in {home} — extract a collaborator "
                    f"with its own name and constructor instead of a second file carrying "
                    f"the same receiver"))
    return out


# ---------------------------------------------------------------------------
# certainty-unevidenced — a plan's assessment with nothing behind it.
#
# The other three rules read code. This one reads the breakdown's task record, before any code
# exists, because that is where the mistake it catches is made and where fixing it costs a
# line rather than a run.
#
# `certainty` steers how hard a run drives itself, and it is assessed by the party with
# every incentive to say `high`: a plan whose tasks are all routine is a tidy plan. The
# guard is that `high` and `medium` both require a named precedent — so the field is only
# as honest as that requirement is enforced, and a requirement stated in prose for an agent
# to self-check is enforced exactly as often as the agent remembers it.
#
# Two things decide here without judgment, and nothing else does. Whether the variation a
# `medium` claims is really uncovered by the precedent is a judgment, so it stays a
# quality standard the agent weighs; whether a precedent was named at all, and whether the
# file it names is really there, are lookups.
# ---------------------------------------------------------------------------

NEEDS_PRECEDENT = ("high", "medium")
LINE_RANGE = re.compile(r":\d+(?:-\d+)?$")


def task_record_tasks(root, path):
    """The task array, if this file is a breakdown task record. Shape rather than location:
    `tasks/` is conventional but a repo may hold breakdowns elsewhere, and a rule that
    silently checks nothing because a path did not match is worse than one that is off."""
    if not path.endswith(".json"):
        return None
    try:
        doc = json.loads((Path(root) / path).read_text())
    except (OSError, json.JSONDecodeError, UnicodeDecodeError):
        return None
    if not isinstance(doc, dict):
        return None
    tasks = doc.get("tasks")
    if not isinstance(tasks, list) or not tasks:
        return None
    if not all(isinstance(t, dict) and "n" in t for t in tasks):
        return None
    return tasks


def certainty_lines(root, path):
    """Line number per task number, so a finding points at the assessment rather than at
    the top of the file. Falls back to line 1 for a task whose key is not on its own line."""
    at, cur, out = {}, None, {}
    try:
        text = (Path(root) / path).read_text()
    except OSError:
        return {}
    for i, line in enumerate(text.splitlines(), 1):
        m = re.search(r'"n"\s*:\s*(\d+)', line)
        if m:
            cur = int(m.group(1))
            at.setdefault(cur, i)
        if cur is not None and '"certainty"' in line:
            out.setdefault(cur, i)
    return {n: out.get(n, at.get(n, 1)) for n in at}


def check_certainty(root, path):
    tasks = task_record_tasks(root, path)
    if tasks is None:
        return []
    lines = certainty_lines(root, path)
    out = []
    for t in tasks:
        n = t["n"]
        line = lines.get(n, 1)
        certainty = t.get("certainty")
        if certainty is None:
            # Planned before the field existed. Reported by `clerk status` as unassessed,
            # which is the honest thing to say about it; inventing a finding here would
            # make every legacy breakdown fail a check it could not have passed.
            continue
        refs = t.get("patterns_to_follow")
        refs = refs if isinstance(refs, list) else []
        if certainty in NEEDS_PRECEDENT and not refs:
            out.append((path, line, "certainty-unevidenced",
                        f"task {n} is certainty '{certainty}' with an empty patterns_to_follow — "
                        f"name the precedent by file and line, or the task is 'low'"))
            continue
        for ref in refs:
            if not isinstance(ref, str) or not ref.strip():
                out.append((path, line, "certainty-unevidenced",
                            f"task {n} has an empty entry in patterns_to_follow"))
                continue
            ref = ref.strip()
            # A precedent an earlier task in this breakdown creates cannot exist yet, so it
            # is named as a task instead of a path. Anything else must resolve on disk: a
            # plausible path that is not there is an invented precedent, which is exactly
            # what the requirement to name one exists to prevent.
            if re.fullmatch(r"task:\d+", ref):
                if int(ref.split(":")[1]) not in {x["n"] for x in tasks}:
                    out.append((path, line, "certainty-unevidenced",
                                f"task {n} cites {ref}, which is not a task in this breakdown"))
                continue
            target = LINE_RANGE.sub("", ref)
            if not (Path(root) / target).exists():
                out.append((path, line, "certainty-unevidenced",
                            f"task {n} cites '{ref}' as a precedent, and {target} does not exist — "
                            f"a precedent that cannot be opened was not found, it was written"))
    return out


# ---------------------------------------------------------------------------

RULES = ("comment-plan-position", "test-umbrella", "type-methods-split",
         "certainty-unevidenced")


def main(argv):
    ap = Parser()
    ap.add_argument("--staged", action="store_true", help="the index, not a range")
    ap.add_argument("--base", metavar="REF", help="lint REF...HEAD; default: the merge-base with the default branch")
    ap.add_argument("--rule", action="append", default=[], choices=RULES, metavar="NAME",
                    help="repeatable; only these rules")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("paths", nargs="*", help="files to lint instead of the changed set")
    args = ap.parse_args(argv)
    if args.help:
        print(__doc__.strip())
        print("\nUSAGE\n  clerk lint [--staged | --base <ref>] [--rule <name>]... [--json] [<path>...]")
        return 0
    staged, as_json, base, only, paths = args.staged, args.json, args.base, args.rule, args.paths

    # build_tree, never repo_root: inside a worktree they differ, and repo_root is the main
    # checkout. Linting there reads another branch's index and disk — --cached finds nothing
    # staged, and the file rules parse files this branch already deleted.
    repo = facts()
    root = repo.get("build_tree") or repo.get("repo_root")
    if not root:
        die("not a git repository")

    rng = diff_range(root, base, staged)
    # dict.fromkeys, not set(): overlapping roots on the command line hand the same file
    # in twice, and every finding in it would be reported twice.
    files = list(dict.fromkeys(normalise(root, p) for p in (paths or changed_files(root, rng))))
    wanted = set(only or RULES)
    scope = set(files)

    findings, seen_pkgs = [], set()
    for f in files:
        if "comment-plan-position" in wanted:
            findings += check_comments(root, f, rng)
        if "test-umbrella" in wanted:
            findings += check_test_umbrella(root, f)
        if "type-methods-split" in wanted:
            findings += check_type_methods(root, f, seen_pkgs, scope)
        if "certainty-unevidenced" in wanted:
            findings += check_certainty(root, f)

    findings.sort(key=lambda x: (x[0], x[1]))

    if as_json:
        print(json.dumps([{"file": f, "line": n, "rule": r, "message": m}
                          for f, n, r, m in findings], indent=2))
    else:
        for f, n, r, m in findings:
            print(f"{f}:{n}: [{r}] {m}")
        if not findings:
            print(f"clean — {len(files)} file(s), {len(wanted)} rule(s)")
    return 1 if findings else 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Exception as e:  # noqa: BLE001
        # A traceback exits 1, and exit 1 is this command's "a finding": `clerk finish`
        # would refuse the task over an empty list of findings. Anything unplanned is 2.
        die(f"internal error: {type(e).__name__}: {e}")
