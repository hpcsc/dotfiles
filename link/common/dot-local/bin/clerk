#!/usr/bin/env python3
"""clerk — the deterministic mechanics of an implementation run.

It keeps the docket and checks the paperwork; it never judges the work. Everything here
is something a program does more reliably than a prompt: resolving facts about the repo,
selecting the next unblocked task, deciding whether a branch may land. Writing the code,
reviewing it, and deciding a fix is right stay with the model.

This file is the dispatcher. `clerk <name>` runs the executable `clerk-<name>` — on PATH,
or beside this file — the way git runs `git-<name>`. A command whose running is evidence
`clerk step` reads is run rather than exec'd, so its exit can be appended to the run's
event log on the way out, and the four that close a step carry the step that follows in
their reply, computed in this process rather than by a second call.

If you are an agent reading this to work out what a command would have done: don't. The
files under <git-dir>/clerk are internal bookkeeping, not an interface, and doing a
failed command's work by hand defeats the point of it being a command — the guarantees
live in doing the steps together, not in the end state resembling theirs. When a command
fails, report the failure and stop.
"""

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
from clerk_lib import VERSION, plugin_bin  # noqa: E402

# Commands whose running is evidence `clerk step` reads. Listed rather than "all of
# them": the reads — step itself, status, prepare, audit, stack, story — run many times a
# step and say nothing about progress, and the list is what keeps their cost at zero.
LOGGED = {"isolate", "finish", "receipt", "verify", "land", "guidelines", "lint", "fixup", "learn"}
# Commands whose success closes a step. Their reply carries the step that follows, as
# `clerk step` would print it — under `next`, or `after_commit` for finish, whose own next
# move is the commit clerk cannot make. Computed after the event is logged, so the row
# reads the evidence this very command produced.
INLINE_NEXT = {"finish": "after_commit", "isolate": "next", "land": "next", "learn": "next"}

USAGE = """\
clerk — deterministic mechanics for an implementation run

A run is driven by `clerk step`: open it once with `clerk step start <slug> --request
"<the request, verbatim>"`, then call `clerk step`, do what it says, and call it again
until it reports finished. Every command is a subcommand listed below; `clerk <name>
--help` describes each. Every flag that takes a value is written --flag <value>.

Per-repo flag defaults — in_place, integrate, review_breakdown, gears — come from
tasks/clerk.json (tracked, a team decision) or tasks/.environment (gitignored,
machine-local), in that order, and the request typed to `clerk step start` outranks
both. `clerk prepare` reports the resolved values as `flags` and where each came from as
`flag_sources`.

Everything here is mechanical. Judgment — writing code, reviewing it, deciding a fix
is right — stays with the caller.
"""


def plugin_desc(path, name):
    """What a plugin says it is: the first line of its docstring reading `clerk <name> — …`,
    read from the file so the listing cannot go stale."""
    try:
        with open(path, errors="replace") as fh:
            for i, line in enumerate(fh):
                if i > 40:
                    break
                line = line.lstrip('"')
                if line.startswith(f"clerk {name} — "):
                    return line[len(f"clerk {name} — "):].rstrip()
    except OSError:
        pass
    return ""


def list_plugins():
    seen = {}
    for d in os.environ.get("PATH", "").split(":") + [str(HERE)]:
        p = Path(d)
        if not p.is_dir():
            continue
        for f in sorted(p.glob("clerk-*")):
            name = f.name[len("clerk-"):]
            if name in seen or not f.is_file() or not os.access(f, os.X_OK):
                continue
            seen[name] = plugin_desc(f, name)
    print("\nSUBCOMMANDS  (clerk-<name> on PATH, or beside clerk; `clerk <name> --help` for each)")
    for name, desc in seen.items():
        print(f"  clerk {name:<12} {desc}")
    if not seen:
        print("  (none installed)")


def next_for(key):
    """The step that follows, computed here: what `clerk step` would print."""
    try:
        from clerk_ledger import build_ctx
        from clerk_steps import next_step
        return {key: next_step(build_ctx())}
    except SystemExit:
        return {}
    except Exception:  # noqa: BLE001 — the reply stands without the hint
        return {}


def run_logged(name, exe, argv):
    from clerk_repo import ledger_dir, ledger_log
    # Resolved BEFORE the command runs: `land --integrate` ends on the default branch,
    # where the run can no longer be named by the branch it just merged.
    ldir = ledger_dir()
    r = subprocess.run([exe, *argv], stdout=subprocess.PIPE, text=True)
    out = r.stdout
    # Exit 2 is a usage error in every command, and a usage error is not evidence of
    # anything.
    if r.returncode != 2:
        ledger_log(ldir, name, r.returncode, argv)
    if r.returncode == 0 and ldir and name in INLINE_NEXT:
        try:
            reply = json.loads(out)
        except json.JSONDecodeError:
            reply = None
        if isinstance(reply, dict):
            reply.update(next_for(INLINE_NEXT[name]))
            out = json.dumps(reply, indent=2) + "\n"
    sys.stdout.write(out)
    sys.stdout.flush()
    return r.returncode


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE, end="")
        list_plugins()
        return 0
    if argv[0] == "version":
        print(f"clerk {VERSION}")
        return 0
    if not shutil.which("git"):
        print("clerk: missing required tool: git", file=sys.stderr)
        return 2
    name, rest = argv[0], argv[1:]
    exe = plugin_bin(name)
    if not exe:
        print(f"clerk: unknown command '{name}' (try: clerk help)", file=sys.stderr)
        return 2
    if name in LOGGED:
        return run_logged(name, exe, rest)
    os.execv(exe, [exe, *rest])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
