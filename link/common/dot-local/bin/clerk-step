#!/usr/bin/env python3
"""clerk step — which step of an implement run comes next, computed rather than remembered.

The implement skill is a long procedure, and the order of its steps lived only in the
model's reading of it. clerk enforced a rule inside a few steps — one task in flight, the
receipt at HEAD before landing — and nothing enforced the transitions between them, so a
model that does not hold long instructions well skipped a step and nothing noticed.

This command holds the order: the table in clerk_steps.py, evaluated against the ledger
in clerk_ledger.py. Steps whose completion is a judgment — the plan is bound, the story
was re-read — are recorded here with `--done`, the way `gate` takes `--audit-accepted`:
asserted and stamped with the code tree it applies to, never inferred.
"""

import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from clerk_lib import clerk, die, emit, git, gitout, parse, resolve_tasks_arg  # noqa: E402
from clerk_ledger import (CALLERS, Run, build_ctx, detect_harness, now, open_run_summaries,  # noqa: E402
                          run_summary, runs_root, session_id)
from clerk_steps import (ROWS, active_rows, facts_for, file_hash, instructions_for,  # noqa: E402
                         lint_sidecar, next_step)


def cmd_start(slug, request, harness):
    if not slug or not request:
        die("--start <slug> needs --request \"<the request, verbatim>\"")
    cwd = os.getcwd()
    if git("check-ref-format", "--branch", slug, cwd=cwd).returncode != 0:
        die(f"'{slug}' is not a usable branch name")
    common = gitout("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=cwd)
    if not common:
        die("not a git repository")
    rc, prep, err = clerk("prepare", cwd=cwd)
    if rc != 0 or not prep:
        die(f"clerk prepare failed: {err}")
    if slug == prep.get("default_branch"):
        die(f"'{slug}' is the default branch; a run needs a branch of its own")
    run = Run(runs_root(common) / slug)
    if run.exists() and not run.finished:
        emit({"started": False, "reason": f"run '{slug}' is open — continue it with `clerk step`, or `clerk step --rm {slug}` to abandon it",
              "run": run_summary(run, cwd)}, 3)
    if run.exists():
        for p in run.dir.iterdir():
            p.unlink()
    run.write("run.json", {"slug": slug, "request": request, "started_at": now(), "launch_cwd": cwd,
                           "launch_branch": prep.get("branch"), "harness": harness or detect_harness(),
                           "session_id": session_id(), "finished": False})
    return {"started": True, "run": slug, "ledger": str(run.dir), "request": request,
            "next": next_step(build_ctx(slug, harness))}


def done_ground(ctx, argv):
    o, _ = parse(argv, {"--caller": "value", "--dom": "bool", "--state": "bool"})
    if o["--caller"] not in CALLERS:
        die(f"--caller must be one of {', '.join(CALLERS)}")
    ctx.run.mark("ground", {"caller": o["--caller"], "dom": o["--dom"], "state": o["--state"],
                            "at": now(), "code_tree": ctx.head_ct})
    return {"done": "ground", "caller": o["--caller"]}


def done_decompose(ctx, argv):
    o, _ = parse(argv, {"--tasks-file": "value", "--approved": "bool"})
    if not o["--tasks-file"]:
        die("--done decompose needs --tasks-file <tasks/<story>.md>")
    tf = resolve_tasks_arg(o["--tasks-file"], ctx.prepare.get("tasks_home") or ctx.cwd)
    if not tf.exists():
        die(f"no breakdown at {o['--tasks-file']}", 1)
    tf = tf.resolve()
    side = tf.with_suffix(".json")
    if not side.exists():
        emit({"bound": False, "reason": f"no sidecar beside {tf} — run `clerk sidecar` to recover one, then bind again"}, 1)
    findings = lint_sidecar(side, ctx.cwd)
    if findings:
        emit({"bound": False, "reason": "lint certainty-unevidenced reports findings — correct the assessment, do not delete the reference",
              "findings": findings}, 1)
    prev = ctx.run.read("breakdown.json") or {}
    approved = bool(o["--approved"]) or bool(prev.get("approved"))
    ctx.run.write("breakdown.json", {"tasks_file": str(tf), "sidecar": str(side), "approved": approved,
                                     "lint_hash": file_hash(side), "at": now()})
    rc, st, _ = clerk("status", "--tasks-file", str(tf), cwd=ctx.cwd)
    return {"bound": True, "tasks_file": str(tf), "approved": approved,
            "plan": (st or {}).get("progress"), "gears": (st or {}).get("gears")}


def done_pause(ctx, argv):
    _, rest = parse(argv, {})
    if len(rest) != 1 or not rest[0].isdigit():
        die("--done pause <n>")
    taken = ctx.run.done.get("pause") or {}
    taken[rest[0]] = {"at": now(), "code_tree": ctx.head_ct}
    ctx.run.mark("pause", taken)
    return {"done": "pause", "n": int(rest[0])}


def done_match_request(ctx, argv):
    o, _ = parse(argv, {"--mismatch": "list", "--resolved": "bool"})
    rec = ctx.run.read("match-request.json") or {}
    if o["--resolved"]:
        if rec.get("code_tree") != ctx.head_ct:
            die("nothing to resolve: nothing is recorded at this code tree", 1)
        rec["resolved"] = True
        rec["resolved_at"] = now()
    else:
        rec = {"code_tree": ctx.head_ct, "at": now(), "mismatches": o["--mismatch"], "resolved": False}
    ctx.run.write("match-request.json", rec)
    return {"done": "match-request", "mismatches": rec["mismatches"], "resolved": rec["resolved"]}


def done_verify_residue(ctx, argv):
    ctx.run.mark("verify-residue", {"at": now(), "code_tree": ctx.head_ct})
    return {"done": "verify-residue"}


def done_learn(ctx, argv):
    o, _ = parse(argv, {"--none": "bool"})
    ctx.run.mark("learn", {"none": o["--none"], "at": now()})
    return {"done": "learn", "none": o["--none"]}


# The steps whose completion is a judgment: recorded with `--done`, never derived.
DONE = {"ground": done_ground, "decompose": done_decompose, "pause": done_pause, "match-request": done_match_request,
        "verify-residue": done_verify_residue, "learn": done_learn}


def cmd_done(ctx, step_id, argv):
    if ctx.run is None:
        die("no run is open here — `clerk step --start <slug> --request ...` first", 3)
    handler = DONE.get(step_id)
    if handler is None:
        die(f"unknown step '{step_id}' — --done takes {', '.join(DONE)}")
    payload = handler(ctx, argv)
    payload["next"] = next_step(ctx)
    return payload


def cmd_status(ctx):
    """Every row, evaluated in order and only up to the first that is not done: every later
    row reads state the earlier ones produce, and verify runs git grep over the diff. The
    context is read-only, so looking records nothing."""
    if ctx.run is None:
        return {"run": None, "step": "start", "open_runs": open_run_summaries(ctx)}
    rows = []
    current = "finished"
    active = dict(active_rows(ctx))
    for name, fn in ROWS:
        if name not in active:
            rows.append({"step": name, "done": True, "note": "landed"})
            continue
        if current != "finished":
            rows.append({"step": name, "done": None})
            continue
        r = fn(ctx)
        rows.append({k: v for k, v in r.items() if k in ("step", "done", "why_not_done", "n", "mode", "fallback", "path", "progress", "blocked")})
        if not r["done"]:
            current = r["step"]
    return {"run": ctx.run.slug, "request": ctx.run.meta.get("request"), "finished": ctx.run.finished,
            "current": current, "rows": rows}


def cmd_step(ctx):
    """The next step, or `start` when no run is open here."""
    if ctx.run is None:
        return {"run": None, "step": "start", "stop": False, "blocked": False,
                "why_not_done": "no run is open for this branch",
                "done_by": "clerk step --start <slug> --request \"<the request, verbatim>\"",
                "open_runs": open_run_summaries(ctx), "resume": ctx.prepare.get("resume"),
                "instructions": instructions_for("start", ctx.harness), "facts": facts_for(ctx)}
    return next_step(ctx)


def cmd_rm(slug):
    cwd = os.getcwd()
    common = gitout("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=cwd)
    if not common:
        die("not a git repository")
    run = Run(runs_root(common) / slug)
    if not run.exists():
        die(f"no run '{slug}'")
    for p in run.dir.iterdir():
        p.unlink()
    run.dir.rmdir()
    return {"removed": slug}


STEP_SPEC = {"--start": "value", "--request": "value", "--done": "value", "--status": "bool",
             "--rm": "value", "--run": "value", "--harness": "value", "--full": "bool",
             "-h": "bool", "--help": "bool"}


def main_step(argv):
    """Every branch ends in emit(), which prints and exits; nothing falls through."""
    if "--done" in argv:
        # --done's own flags belong to the step; split them off before parsing ours.
        i = argv.index("--done")
        o, _ = parse(argv[: i + 2], STEP_SPEC)
        ctx = build_ctx(o["--run"], o["--harness"], full=o["--full"])
        emit(cmd_done(ctx, o["--done"], argv[i + 2:]))
    o, rest = parse(argv, STEP_SPEC)
    if o["-h"] or o["--help"]:
        print(__doc__.strip().splitlines()[0])
        print("\nusage: clerk step [--start <slug> --request <text>] [--done <step> ...] [--status] [--full] [--rm <slug>] [--run <slug>] [--harness <name>]")
        sys.exit(0)
    if rest:
        die(f"unexpected argument '{rest[0]}'")
    if o["--start"]:
        emit(cmd_start(o["--start"], o["--request"], o["--harness"]))
    if o["--rm"]:
        emit(cmd_rm(o["--rm"]))
    ctx = build_ctx(o["--run"], o["--harness"], read_only=bool(o["--status"]), full=bool(o["--full"]))
    if o["--status"]:
        emit(cmd_status(ctx))
    emit(cmd_step(ctx))


if __name__ == "__main__":
    main_step(sys.argv[1:])
