# fzf-pick a deliverable of an in-flight story; enter starts it or opens the run already on it.
# Display: <state> w<wave> <done/total> <id>  <story>; hidden tail fields drive preview and action.
# What enter does for each state is deliverable-open's decision.
local rows
rows=$(clerk story 2>/dev/null | jq -r '
  .[] | .story_slug as $story | .deliverables[] |
  [ .state, "w\(.wave)", "\(.done)/\(.total)", .id, $story, .tasks_file, tojson ] | @tsv')

if [ -z "${rows}" ]; then
  echo "no deliverable found — no unarchived plan.yaml under tasks/, or not in a git repo" >&2
  return 1
fi

local selected=$(
  printf '%s\n' "${rows}" | fzf --ansi --delimiter='\t' --with-nth=1,2,3,4,5 \
    --header='deliverables — enter: open or start with /implement · tasks preview →' \
    --preview='bat --style=plain --color=always {6} 2>/dev/null || cat {6}' \
    --preview-window=right,60%
)

if [ -z "${selected}" ]; then
  return
fi

deliverable-open "$(printf '%s' "${selected}" | cut -f5)" "$(printf '%s' "${selected}" | cut -f7)"
