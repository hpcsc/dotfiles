---
config:
  layout: elk
  securityLevel: loose
  themeVariables:
    edgeLabelBackground: "#FFFFFF"
  elk:
    mergeEdges: false
    nodePlacementStrategy: BRANDES_KOEPF
---
flowchart TB

    %% Event flow: orange pills are events, bare gears are automations.
    %% A green edge is a gate — the automation emits that event only when the
    %% gate passes. Plain edges are "this event is consumed by that automation".
    %% ---
    %% RENDERER NOTE: the gear is the mdi:cog icon, and the renderer must load
    %% its icon set: mmdc --iconPacks @iconify-json/mdi. edgeLabelBackground is
    %% white because Mermaid paints the icon's caption on it, a grey box by
    %% default. GitHub loads no icon set. For GitHub, write each automation as
    %%   automation["TheAutomation"]
    %% with classDef automation fill:#E1D5E7,stroke:#9673A6,color:#16201B,
    %% and take edgeLabelBackground out of the frontmatter.
    %% ---
    %% PARSER TRAPS, each of which costs a render:
    %%   - `flowchart` must be the first line after the frontmatter. A %% comment
    %%     block above it fails with "Expecting 'NEWLINE', 'SPACE', 'GRAPH'".
    %%   - A bare %% line in the body renders as a visible node. Use `%% ---`.
    %%   - An icon renders as a blue "?" box when the renderer did not load its
    %%     icon set. mmdc needs --iconPacks @iconify-json/mdi on every render.
    %%   - Keep edge labels to two short lines; Mermaid lays them out as objects,
    %%     and long ones inflate the ranks into long detours.
    %% ---
    %% Qualifiers too long for an edge label belong here, not on the picture.

    %% ---------- nodes ----------
    trigger(["SomethingHappened"])
    automation@{ icon: "mdi:cog", label: "TheAutomation<br/><small>an optional sub-line</small>", pos: "b", h: 36 }
    emitted(["SomethingElseHappened"])
    downstream@{ icon: "mdi:cog", label: "DownstreamAutomation<br/><small style='color:#A33A2A'>no gate — runs for everything</small>", pos: "b", h: 36 }
    deadEnd(["NobodyConsumesThis<br/><small>projections only</small>"])
    store["Scheduler<br/><small>a store or an external service</small>"]
    absent["nothing is written<br/><small>an emission that never happens</small>"]

    %% ---------- edges ----------
    trigger --> automation
    automation -- "GATE_NAME<br/>and only when …" --> emitted
    emitted --> downstream
    downstream --> deadEnd
    automation -- "writes" --> store
    store -- "a message at the deadline" --> downstream
    automation -. "the gate did not pass" .-> absent

    %% ---------- styling ----------
    %% Event orange is Event Storming's; keep it exactly. The automation class
    %% paints no shape, which is what makes an automation read as a bare gear.
    classDef event fill:#FFE0C0,stroke:#B44E12,stroke-width:1.5px,color:#16201B
    classDef automation fill:none,stroke:none,color:#16201B
    classDef dead fill:#FFE0C0,stroke:#A33A2A,stroke-width:1.6px,stroke-dasharray:5 4,color:#16201B
    %% A store is not an event, and neither is an emission that never happens.
    %% Both are boxes: only a fact in the log gets a pill.
    classDef store fill:#ECEFED,stroke:#5A6861,stroke-width:1.3px,color:#16201B
    classDef absent fill:#FFFFFF,stroke:#A33A2A,stroke-width:1.5px,stroke-dasharray:5 4,color:#16201B

    class trigger,emitted event
    class automation,downstream automation
    class deadEnd dead
    class store store
    class absent absent

    %% Colour the gated edges green. linkStyle indexes are 0-based in the order
    %% the edges are declared above — recount them after inserting an edge.
    linkStyle 1 stroke:#14705A,stroke-width:2.5px
