#!/usr/bin/env python3
"""clerk step — which step of an implement run comes next, computed rather than remembered.

The implement skill is a long procedure, and the order of its steps lived only in the
model's reading of it. clerk enforced a rule inside a few steps — one task in flight, the
receipt at HEAD before landing — and nothing enforced the transitions between them, so a
model that does not hold long instructions well skipped a step and nothing noticed.

This command holds the order. It evaluates a fixed table of steps from the top, against
git state and a ledger under the common git dir, and returns the first step that is not
done together with the instructions for it. There is no counter to advance: position is
recomputed on every call, so a stopped run continues with the same call, and the model
cannot move past a step by saying so. Steps whose completion is a judgment — the plan is
bound, the story was re-read — are recorded with `--done`, the way `gate` takes
`--audit-accepted`: asserted and stamped with the code tree it applies to, never inferred.

The ledger lives in <git-common-dir>/clerk/runs/<slug>/ and the slug is the branch name,
which is the pairing `clerk prepare` already uses to match a worktree to its breakdown. It
sits in the common dir rather than the worktree's because the last steps of a run — the
fast-forward and the learnings — happen in the main checkout after the worktree is gone.

Receipts and acceptances are compared by code tree, the HEAD tree minus the breakdown
files under tasks/, not by SHA: the Theory section lands as a tasks/-only commit after the
last green, and a SHA comparison would call that green stale and send the run back to the
suite for a documentation change. The tree is clerk's code_tree(), read from `prepare`.

Invoked as `clerk step`, and as `clerk audit` through the clerk-audit symlink:

clerk audit — the rounds and the acceptance that the audit step reads.
"""

import hashlib
import json
from dataclasses import dataclass, field
import os
import re
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from clerk_lib import NAME, clerk, die, emit, git, gitout  # noqa: E402
import clerk_audit_panel as panel  # noqa: E402

CALLERS = ("ui", "inbound", "outbound", "async", "exported")

VALIDATE_QUESTIONS = [
    "What does the story ask for that this branch does not do?",
    "Where does the branch satisfy a task's acceptance criteria by measuring a proxy for what was asked rather than the thing itself?",
    "Where did a criterion the story stated as a category become a list in the breakdown? Check the list against the source that defines the set.",
    "Which test fails when a criterion is violated? Name one per criterion, and make the headline one fail.",
]


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# --------------------------------------------------------------------------------
# git
# --------------------------------------------------------------------------------

def ref_exists(branch, cwd):
    return git("show-ref", "--verify", "--quiet", f"refs/heads/{branch}", cwd=cwd).returncode == 0


def is_ancestor(branch, of, cwd):
    return git("merge-base", "--is-ancestor", branch, of, cwd=cwd).returncode == 0


def detect_harness():
    h = os.environ.get("CLERK_HARNESS")
    if h:
        return h
    if os.environ.get("CLAUDECODE"):
        return "claude"
    if any(k.startswith("OPENCODE") for k in os.environ):
        return "opencode"
    return "claude"


# --------------------------------------------------------------------------------
# The ledger
# --------------------------------------------------------------------------------

class Run:
    def __init__(self, path):
        self.dir = Path(path)
        self.slug = self.dir.name

    def exists(self):
        return (self.dir / "run.json").exists()

    def read(self, name, default=None):
        p = self.dir / name
        if not p.exists():
            return default
        try:
            return json.loads(p.read_text())
        except json.JSONDecodeError:
            die(f"ledger file {p} is not valid JSON — report this and stop; do not repair it by hand")

    def write(self, name, obj):
        self.dir.mkdir(parents=True, exist_ok=True)
        tmp = self.dir / f"{name}.tmp"
        tmp.write_text(json.dumps(obj, indent=2) + "\n")
        tmp.replace(self.dir / name)

    @property
    def meta(self):
        return self.read("run.json", {})

    @property
    def finished(self):
        return bool(self.meta.get("finished"))

    @property
    def done(self):
        return self.read("done.json", {})

    def mark(self, key, record):
        d = self.done
        d[key] = record
        self.write("done.json", d)


def runs_root(common):
    return Path(common) / "clerk" / "runs"


def run_summary(run, cwd):
    bd = run.read("breakdown.json")
    progress = None
    side_path = Path(bd["sidecar"]) if bd else None
    if side_path and not side_path.exists():
        cand = side_path.parent / "completed" / side_path.name
        side_path = cand if cand.exists() else side_path
    if side_path and side_path.exists():
        side = json.loads(side_path.read_text())
        tasks = side.get("tasks", [])
        progress = {"done": sum(1 for t in tasks if t.get("done")), "total": len(tasks)}
    return {"slug": run.slug, "request": run.meta.get("request"), "started_at": run.meta.get("started_at"),
            "finished": run.finished, "branch_exists": ref_exists(run.slug, cwd),
            "breakdown": bd["tasks_file"] if bd else None, "tasks": progress}


# --------------------------------------------------------------------------------
# The event log: what clerk commands ran for this run, appended by clerk itself
# --------------------------------------------------------------------------------

def events(run):
    p = run.dir / "events.jsonl"
    if not p.exists():
        return []
    out = []
    for line in p.read_text().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return out


def flag_value(argv, flag):
    if flag in argv:
        i = argv.index(flag)
        if i + 1 < len(argv):
            return argv[i + 1]
    return None


def guidelines_read(run):
    """The `clerk guidelines` run that counts: it succeeded and named the caller pattern."""
    for e in events(run):
        if e.get("cmd") != "guidelines" or e.get("exit") != 0:
            continue
        argv = e.get("argv", [])
        caller = flag_value(argv, "--caller")
        if caller in CALLERS:
            return {"caller": caller, "dom": "--dom" in argv, "state": "--state" in argv, "at": e.get("at"),
                    "source": "clerk guidelines"}
    return None


def learn_written(run):
    for e in events(run):
        if e.get("cmd") == "learn" and e.get("exit") == 0 and "--title" in e.get("argv", []):
            return {"at": e.get("at"), "title": flag_value(e.get("argv", []), "--title"), "source": "clerk learn"}
    return None


def task_signals(run):
    """Per task, the two observed signals the method reads as the plan being wrong about
    it: `clerk finish N --retried` (the first shape reached for was not the one that went
    green) and a lint finding — a `lint --staged` that reported after N was finished, or a
    `finish N` that refused. Returns ({n: {...}}, [n in finish order])."""
    signals = {}
    order = []
    last_done = None
    for e in events(run):
        cmd, argv, rc = e.get("cmd"), e.get("argv", []), e.get("exit")
        if cmd == "lint" and "--staged" in argv and rc == 1 and last_done is not None:
            signals[last_done]["lint_findings"] = True
        if cmd == "finish" and argv and str(argv[0]).isdigit():
            n = int(argv[0])
            sig = signals.setdefault(n, {"retried": False, "lint_findings": False, "attempts": 0})
            sig["attempts"] += 1
            if rc == 1:
                sig["lint_findings"] = True
            elif rc == 0:
                sig["retried"] = sig["retried"] or "--retried" in argv
                if n not in order:
                    order.append(n)
                last_done = n
    return signals, order


def gear(signals, order):
    """`low` once a task showed a signal, `normal` again after two clean tasks in a row —
    a pause that arrives on every task stops carrying information."""
    low, streak = False, 0
    for n in order:
        sig = signals.get(n, {})
        if sig.get("retried") or sig.get("lint_findings"):
            low, streak = True, 0
        else:
            streak += 1
            if low and streak >= 2:
                low, streak = False, 0
    return "low" if low else "normal"


def fixup_ambiguities(run):
    return sum(1 for e in events(run) if e.get("cmd") == "fixup" and e.get("exit") == 3)


# --------------------------------------------------------------------------------
# Context: the facts every step reads
# --------------------------------------------------------------------------------

@dataclass
class Ctx:
    """The facts every step reads, resolved once per call. Most are `clerk prepare`'s —
    the run this tree belongs to, the receipt it holds, HEAD's code tree — so the rule
    behind each lives in clerk and is applied here, not reimplemented."""
    cwd: str
    common: str
    git_dir: str = None
    branch: str = None
    head: str = None
    head_ct: str = None
    default: str = None
    run: Run = None
    prepare: dict = field(default_factory=dict)
    flags: dict = field(default_factory=dict)
    work_tree: str = None
    repo_root: str = None
    in_worktree: bool = False
    harness: str = None
    read_only: bool = False  # --status: look without recording anything
    full: bool = False  # --full: print the step's text even if this session has seen it


def build_ctx(explicit_run=None, harness=None, read_only=False, full=False):
    cwd = os.getcwd()
    common = gitout("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=cwd)
    if not common:
        die("not a git repository")
    # `clerk prepare` is the facts, and with the request it is the facts with the run's
    # flags applied — so it is asked once to find the run, and again once the run is known.
    rc, prep, err = clerk("prepare", cwd=cwd)
    if rc != 0 or not prep:
        die(f"clerk prepare failed: {err or 'no output'}")
    ctx = Ctx(cwd=cwd, common=common, git_dir=gitout("rev-parse", "--absolute-git-dir", cwd=cwd),
              branch=prep.get("branch") or None, head=gitout("rev-parse", "HEAD", cwd=cwd),
              default=prep.get("default_branch"), prepare=prep, read_only=read_only, full=full)
    ctx.run = resolve_run(ctx, explicit_run)
    if ctx.run is not None:
        request = ctx.run.meta.get("request") or ""
        rc, prep, err = clerk("prepare", "--request", request, cwd=cwd)
        if rc != 0 or not prep:
            die(f"clerk prepare failed: {err or 'no output'}")
        ctx.prepare = prep
    ctx.head_ct = prep.get("code_tree")
    ctx.flags = prep.get("flags", {})
    ctx.work_tree = prep.get("work_tree")
    ctx.repo_root = prep.get("repo_root")
    ctx.in_worktree = bool(prep.get("in_worktree"))
    ctx.harness = harness or (ctx.run.meta.get("harness") if ctx.run else None) or detect_harness()
    return ctx


def resolve_run(ctx, explicit):
    """Which ledger this call belongs to: `--run`, else the one `clerk prepare` resolved
    (named by the branch, or the single open run from the default branch). Several open
    runs from there is a choice the caller has to make, the way `prepare` refuses to
    pick between breakdowns."""
    if explicit:
        run = Run(runs_root(ctx.common) / explicit)
        if not run.exists():
            die(f"no run '{explicit}' — `clerk step --status` from the default branch lists them")
        return run
    slug = ctx.prepare.get("run")
    if slug:
        return Run(runs_root(ctx.common) / slug)
    open_runs = ctx.prepare.get("runs_open") or []
    on_feature = ctx.branch and ctx.branch not in (ctx.default, "HEAD")
    if len(open_runs) > 1 and not on_feature:
        emit({"step": "start", "blocked": True,
              "reason": f"{len(open_runs)} runs are open; name the one this call is for with --run <slug>",
              "open_runs": open_run_summaries(ctx)}, 3)
    return None


def open_run_summaries(ctx):
    return [run_summary(Run(runs_root(ctx.common) / slug), ctx.cwd)
            for slug in ctx.prepare.get("runs_open") or []]


def worktree_of(ctx, branch):
    """The worktree holding `branch`, from the list `clerk prepare` reported."""
    for wt in ctx.prepare.get("worktrees") or []:
        if wt.get("branch") == branch:
            return wt.get("path")
    return None


# --------------------------------------------------------------------------------
# Instructions — the method text for a step, or a built-in summary of it
# --------------------------------------------------------------------------------

# The method's step files are the instructions, and `clerk step` prints the one for the
# step it returns. Only two steps have no file: `start`, because a run that has not
# opened has nothing to render yet, and `finished`, which is a sentence. Every other
# step used to carry a built-in copy of its text as well, for a machine without the
# method — a second source, and it drifted from the first within a week.
BUILTIN = {
    "start": "No run is open here. Record the request verbatim: `clerk step --start <kebab-slug> --request \"<the request>\"`. The slug becomes the branch name.",
    "finished": "The run is complete.",
}


def method_dir():
    return Path(os.environ.get("CLERK_METHOD_DIR") or Path.home() / ".config" / "ai" / "method" / "implement")


def render_method(text, harness):
    """Resolve {{seam:name}} and {{include:path}} the way gen-skills.sh does, for one harness."""
    mdir = method_dir()
    out = []
    for line in text.splitlines():
        m = re.match(r"^\{\{seam:([a-z-]+)\}\}$", line)
        if m:
            p = mdir / "seams" / harness / f"{m.group(1)}.md"
            out.append(p.read_text().rstrip("\n") if p.exists() else f"<!-- no seam {harness}/{m.group(1)} -->")
            continue
        m = re.match(r"^\{\{include:([a-z0-9/-]+\.md)\}\}$", line)
        if m:
            p = mdir.parent / m.group(1)
            out.append(p.read_text().rstrip("\n") if p.exists() else f"<!-- no include {m.group(1)} -->")
            continue
        out.append(line)
    return "\n".join(out).strip("\n")


# The gears pause is a moment inside the task step, and the method text for it is the
# task's; the built-in summary says what to show and where to stop.
STEP_TEXT_ALIAS = {"tests": "task"}

# How long a printed text is taken to still be in the caller's view. Claude Code names
# its session, so a new session is told apart outright; a harness that does not gets
# the window alone.
SHOWN_FOR = 2 * 60 * 60


def session_id():
    return os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("OPENCODE_SESSION_ID") or None


def age_seconds(at):
    try:
        then = datetime.strptime(at, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except (TypeError, ValueError):
        return float("inf")
    return (datetime.now(timezone.utc) - then).total_seconds()


def instructions_for(step_id, harness):
    p = method_dir() / "steps" / f"{STEP_TEXT_ALIAS.get(step_id, step_id)}.md"
    if p.exists():
        return render_method(p.read_text(), harness)
    if step_id in BUILTIN:
        return BUILTIN[step_id]
    return (f"no method text for the {step_id} step: {p} does not exist. `done_by` names "
            f"the command that moves the run on; set CLERK_METHOD_DIR to the implement "
            f"method directory for the full text.")


def instructions_text(ctx, step_id):
    """(text, elided) — the method text in full the first time this session reaches a
    step, and a one-line pointer while the same text would only be repeated. The task
    text is ten kilobytes and the task row comes back once per task; printing it every
    time was most of what a run paid clerk for, and all of it sat in the caller's context
    already. The pointer goes only to the session that saw the text, within SHOWN_FOR;
    `--full` prints it again on demand, after a context compaction say."""
    key = STEP_TEXT_ALIAS.get(step_id, step_id)
    text = instructions_for(step_id, ctx.harness)
    if ctx.run is None or ctx.full or step_id in BUILTIN:
        return text, False
    shown = ctx.run.read("shown.json") or {}
    if (shown.get("text") == key and shown.get("session") == session_id()
            and age_seconds(shown.get("at")) < SHOWN_FOR):
        return (f"unchanged: the {key} step's text was printed by the reply that first reached this "
                f"step, and `done_by` says what to run; `clerk step --full` prints it again"), True
    if not ctx.read_only:
        ctx.run.write("shown.json", {"text": key, "at": now(), "session": session_id()})
    return text, False


# --------------------------------------------------------------------------------
# The step table. Each row answers: is it done, and if not, why and what does it.
# --------------------------------------------------------------------------------

def row(step_id, done, **fields):
    r = {"step": step_id, "done": done}
    r.update(fields)
    return r


def breakdown_files(ctx):
    """(tasks_file, sidecar, archived) for the bound breakdown. `clerk land` moves both
    into tasks/completed/, and a run that has landed still reads them from there."""
    bd = ctx.run.read("breakdown.json")
    if not bd:
        return None, None, False
    tf, side = Path(bd["tasks_file"]), Path(bd["sidecar"])
    if tf.exists():
        return tf, side, False
    home = Path(ctx.prepare.get("tasks_home") or ctx.cwd)
    atf = home / "tasks" / "completed" / tf.name
    if atf.exists():
        return atf, atf.with_suffix(".json"), True
    return tf, side, False


def sidecar_tasks(ctx):
    bd = ctx.run.read("breakdown.json")
    if not bd:
        return None, None
    _, side, _ = breakdown_files(ctx)
    if not side.exists():
        return bd, None
    return bd, json.loads(side.read_text()).get("tasks", [])


def row_ground(ctx):
    rec = guidelines_read(ctx.run) or ctx.run.done.get("ground")
    if rec and rec.get("caller"):
        return row("ground", True, caller=rec["caller"], source=rec.get("source", "asserted"))
    if not ctx.prepare.get("clean"):
        return row("ground", False, blocked=True, stop=True, kind="derived",
                   reason="the tree is dirty — never build on top of someone else's loose work; stop and ask",
                   why_not_done="tree dirty")
    return row("ground", False, kind="derived",
               why_not_done="no `clerk guidelines --caller <pattern>` has run for this run",
               done_by="clerk guidelines; then clerk guidelines --caller <pattern> [--dom] [--state]; then clerk step. "
                       "(A repo with no guidelines directory: clerk step --done ground --caller <pattern>)")


def landed_elsewhere(ctx):
    """True when the run has left its branch for a reason the table accepts: the branch
    was merged or deleted, or its worktree holds the archive record."""
    slug = ctx.run.slug
    if not ctx.run.read("breakdown.json"):
        return False
    if not ref_exists(slug, ctx.cwd):
        return True
    if ctx.default and is_ancestor(slug, ctx.default, ctx.cwd):
        return True
    wt = worktree_of(ctx, slug)
    if wt:
        gd = gitout("rev-parse", "--absolute-git-dir", cwd=wt)
        if gd and (Path(gd) / "clerk" / "archived.json").exists():
            return True
    return False


def row_isolate(ctx):
    slug = ctx.run.slug
    if ctx.branch == slug:
        in_place = bool(ctx.flags.get("in_place"))
        mode = "worktree" if ctx.in_worktree else "in-place"
        fallback = (not ctx.in_worktree) and (not in_place)
        return row("isolate", True, mode=mode, fallback=fallback, path=ctx.work_tree)
    if landed_elsewhere(ctx):
        return row("isolate", True, mode="landed", note="the run has left its branch; it landed")
    if ref_exists(slug, ctx.cwd):
        wt = worktree_of(ctx, slug)
        if wt:
            return row("isolate", False, kind="derived", action="enter", path=wt,
                       why_not_done=f"the run's worktree is {wt} and this call is not in it",
                       done_by=f"enter {wt} (EnterWorktree with that path on Claude Code; cd elsewhere), then clerk step")
        return row("isolate", False, kind="derived", action="switch",
                   why_not_done=f"branch {slug} exists with no worktree; this run builds in place",
                   done_by=f"clerk branch {slug} — it returns the step that follows as next")
    if ctx.flags.get("in_place"):
        return row("isolate", False, kind="derived", action="branch",
                   why_not_done="in_place is on and the run has no branch yet",
                   done_by=f"clerk branch {slug} — it returns the step that follows as next")
    return row("isolate", False, kind="derived", action="worktree",
               why_not_done="the run has no worktree yet",
               done_by=f"clerk worktree {slug}; enter the path it reports; then clerk step")


def lint_sidecar(side_path, cwd):
    rc, data, err = clerk("lint", "--rule", "certainty-unevidenced", "--json", str(side_path), cwd=cwd)
    if rc not in (0, 1):
        die(f"clerk lint failed: {err}")
    return data or []


def file_hash(path):
    return hashlib.sha1(Path(path).read_bytes()).hexdigest()


def row_plan(ctx):
    bd = ctx.run.read("breakdown.json")
    resume = ctx.prepare.get("resume")
    if not bd:
        return row("plan", False, kind="asserted",
                   why_not_done="no breakdown is bound to this run",
                   resume=resume, breakdowns=ctx.prepare.get("breakdowns"),
                   done_by="clerk step --done plan --tasks-file <tasks/<story>.md> [--approved]")
    tf, side, archived = breakdown_files(ctx)
    if archived:
        return row("plan", True, tasks_file=str(tf), sidecar=str(side), archived=True)
    if not side.exists():
        return row("plan", False, kind="derived", tasks_file=bd["tasks_file"],
                   why_not_done=f"no sidecar at {side} — run `clerk sidecar` to recover one, then bind again",
                   done_by=f"clerk sidecar; clerk step --done plan --tasks-file {bd['tasks_file']}")
    if file_hash(side) != bd.get("lint_hash"):
        findings = lint_sidecar(side, ctx.cwd)
        if findings:
            return row("plan", False, kind="derived", tasks_file=bd["tasks_file"], findings=findings,
                       why_not_done="the sidecar changed and `lint certainty-unevidenced` now reports findings",
                       done_by="correct the assessments, then clerk step --done plan --tasks-file again")
    if ctx.flags.get("review_plan") and not bd.get("approved"):
        return row("plan", False, kind="asserted", stop=True, tasks_file=bd["tasks_file"],
                   why_not_done="review_plan is on and the plan is not approved",
                   done_by=f"show the plan and wait for approval; then clerk step --done plan --tasks-file {bd['tasks_file']} --approved")
    return row("plan", True, tasks_file=bd["tasks_file"], sidecar=bd["sidecar"])


def row_task(ctx):
    tf, side, _ = breakdown_files(ctx)
    if tf is None or not side.exists():
        return row("task", False, kind="derived", why_not_done="no sidecar to read tasks from")
    # `clerk next` owns which task is ready — the dependency rule is applied, not repeated.
    # --allow-dirty because a dirty tree is reported on the row, not a reason to stop asking.
    rc, nx, err = clerk("next", "--allow-dirty", "--tasks-file", str(tf), cwd=ctx.cwd)
    if nx is None:
        die(f"clerk next failed: {err}")
    total, remaining = nx.get("total", 0), nx.get("remaining", 0)
    progress = {"done": total - remaining, "total": total, "remaining": remaining, "blocked": nx.get("blocked", 0)}
    if nx.get("done"):
        return row("task", True, progress=progress)
    cur = nx.get("task")
    if cur is None:
        return row("task", False, blocked=True, stop=True, kind="derived", progress=progress,
                   reason="open tasks remain but none is unblocked — the dependency graph has a cycle or names a task that is not there",
                   why_not_done="no ready task")
    n = cur["n"]
    gears = bool(ctx.flags.get("gears"))
    certainty = cur.get("certainty")
    blast = cur.get("blast_radius")
    signals, order = task_signals(ctx.run)
    g = gear(signals, order)
    reasons = [r for r, hit in (("certainty low", certainty == "low"), ("blast radius high", blast == "high"),
                                ("the run downshifted", g == "low")) if hit]
    pauses = gears and bool(reasons)
    shown = str(n) in (ctx.run.done.get("tests") or {})
    fields = dict(n=n, task=cur, certainty=certainty, blast_radius=blast,
                  unassessed=(certainty is None and blast is None), gear=g,
                  last_task_signals=(signals.get(order[-1]) if order else None),
                  tree_dirty=not ctx.prepare.get("clean"), progress=progress,
                  commit_skill=ctx.prepare.get("commit_skill"))
    if pauses and not shown:
        return row("tests", False, kind="asserted", stop=True,
                   why_not_done=f"task {n} pauses after its tests ({', '.join(reasons)}) and they were not shown",
                   done_by=f"write the tests, run them red, show the assertions, stop; then clerk step --done tests {n}",
                   **fields)
    return row("task", False, kind="derived", pause_after_tests=pauses,
               why_not_done=f"task {n} is open",
               done_by=f"clerk finish {n} [--retried] -- <files> (it lints the staged set and returns the step after the commit as after_commit); commit with the {fields['commit_skill']} skill; then act on after_commit",
               **fields)


def receipt_state(ctx):
    """(fresh, receipt, why) as `clerk prepare` judged it — fresh when the receipt passed
    and describes HEAD's code tree. The same judgment gate and verify make."""
    rs = ctx.prepare.get("receipt") or {}
    rec = rs if rs.get("recorded") else None
    return bool(rs.get("fresh")), rec, rs.get("why")


def row_suite(ctx):
    fresh, rec, why = receipt_state(ctx)
    if fresh:
        return row("suite", True, receipt={"sha": rec["sha"], "command": rec["command"], "at": rec.get("at")})
    cmd = ctx.prepare.get("test_command")
    return row("suite", False, kind="derived", why_not_done=why, test_command=cmd, work_tree=ctx.work_tree,
               done_by=f"run `{cmd}` in {ctx.work_tree}; clerk receipt --command \"{cmd}\" --passed --output-file <file>")


def row_audit(ctx):
    aud = ctx.run.read("audit.json", {})
    rounds = aud.get("rounds", [])
    accepted = aud.get("accepted")
    fields = dict(story=ctx.run.meta.get("request"), base=ctx.prepare.get("base"),
                  test_commands=ctx.prepare.get("test_commands"),
                  rounds_planned=aud.get("rounds_planned"), rounds_done=len(rounds),
                  last_round_fresh=bool(rounds) and rounds[-1].get("code_tree") == ctx.head_ct)
    if accepted and accepted.get("code_tree") == ctx.head_ct:
        return row("audit", True, rounds_done=len(rounds), accepted_at=accepted.get("at"))
    if not rounds:
        why = "no audit round is recorded for this run"
    elif not accepted:
        why = f"{len(rounds)} round(s) recorded, findings not yet accepted"
    else:
        why = "the acceptance describes an earlier code tree — the code changed since"
    return row("audit", False, kind="asserted", why_not_done=why,
               done_by="clerk audit plan --rounds <n>; audit-implement; clerk audit round --report <json>; fix + clerk fixup + suite + clerk receipt; ...; clerk audit accept",
               **fields)


def row_validate(ctx):
    rec = ctx.run.read("validate.json")
    base = ctx.prepare.get("base")
    log = gitout("log", "--oneline", f"{base}..HEAD", cwd=ctx.cwd) if base else gitout("log", "--oneline", "-20", cwd=ctx.cwd)
    fields = dict(story=ctx.run.meta.get("request"), log=(log or "").splitlines(), questions=VALIDATE_QUESTIONS)
    if rec and rec.get("code_tree") == ctx.head_ct:
        if rec.get("mismatches") and not rec.get("resolved"):
            return row("validate", False, blocked=True, stop=True, kind="asserted",
                       reason="mismatches were recorded; put them to the user and stop. After the decision: clerk step --done validate --resolved",
                       mismatches=rec["mismatches"], why_not_done="unresolved mismatches", **fields)
        return row("validate", True, mismatches=rec.get("mismatches", []))
    why = "the request was not re-read against this code tree" if not rec else "validated at an earlier code tree — the code changed since"
    return row("validate", False, kind="asserted", why_not_done=why,
               done_by="clerk step --done validate [--mismatch \"<quoted words>\"]...", **fields)


def row_theory(ctx):
    tf, _, archived = breakdown_files(ctx)
    if tf is None:
        return row("theory", False, kind="derived", why_not_done="no breakdown is bound to this run")
    text = tf.read_text() if tf.exists() else ""
    if not re.search(r"^## Theory\b", text, re.M):
        return row("theory", False, kind="derived", tasks_file=str(tf),
                   why_not_done=f"no `## Theory` section in {tf}",
                   done_by="write the section; commit it when the breakdown is tracked; then clerk step")
    if ctx.prepare.get("tasks_tracked") and not archived:
        dirty = git("status", "--porcelain", "--", str(tf), cwd=ctx.cwd).stdout.strip()
        if dirty:
            return row("theory", False, kind="derived", tasks_file=str(tf),
                       why_not_done="the Theory is written but not committed",
                       done_by="commit the breakdown as its own commit; then clerk step")
    return row("theory", True, tasks_file=str(tf))


def row_verify(ctx):
    # A pass is recorded at its code tree, so the tasks/-only commits that follow — the
    # Theory, the archive — do not send the run back through git grep, and a run that has
    # landed is not re-verified against a receipt `clerk verify` still compares by SHA.
    passed = ctx.run.done.get("verify")
    if passed and passed.get("code_tree") == ctx.head_ct:
        return row("verify", True, cached=True)
    tf, _, archived = breakdown_files(ctx)
    args = ["verify", "--all-closed"]
    if tf is not None and not archived:
        args += ["--tasks-file", str(tf)]
    rc, data, err = clerk(*args, cwd=ctx.cwd)
    if data is None:
        die(f"clerk verify failed: {err}")
    clean = bool(data.get("clean"))
    not_checked = data.get("not_checked", [])
    residue = ctx.run.done.get("verify-residue")
    residue_ok = bool(residue) and residue.get("code_tree") == ctx.head_ct
    if clean and (not not_checked or residue_ok):
        if not ctx.read_only:
            ctx.run.mark("verify", {"at": now(), "code_tree": ctx.head_ct, "not_checked": not_checked})
        return row("verify", True, findings=data.get("findings", []), not_checked=not_checked)
    if not clean:
        why = "clerk verify reports a block"
        done_by = "fix the block; then clerk step"
    else:
        why = "clerk verify left checks in not_checked that need judgment"
        done_by = "spawn run-verifier for the residue only; then clerk step --done verify-residue"
    return row("verify", False, kind="derived" if not clean else "asserted", why_not_done=why,
               verify=data, done_by=done_by)


def row_land(ctx):
    slug = ctx.run.slug
    stamp = ctx.run.read("land.json")
    if stamp and stamp.get("landed"):
        return row("land", True, archived=True, integrated=True, source="land.json")
    if ctx.branch == slug:
        archived = bool(stamp) or (Path(ctx.git_dir) / "clerk" / "archived.json").exists()
        if not archived:
            return row("land", False, kind="derived", why_not_done="the breakdown is not archived",
                       integrate=ctx.flags.get("integrate"),
                       done_by="clerk land [--integrate|--no-integrate] — it returns the step that follows as next")
        integrate = stamp.get("integrate") if stamp else ctx.flags.get("integrate")
        if integrate and ctx.in_worktree:
            return row("land", False, kind="derived",
                       why_not_done="archived; integration is on and cannot finish from inside the worktree",
                       done_by=f"leave the worktree keeping the branch (ExitWorktree keep on Claude Code), run the command `clerk land` printed in {ctx.repo_root}, then clerk step there")
        return row("land", True, archived=True, integrated=False)
    if not ref_exists(slug, ctx.cwd):
        return row("land", True, archived=True, integrated=True)
    wt = worktree_of(ctx, slug)
    if ctx.default and is_ancestor(slug, ctx.default, ctx.cwd):
        if wt:
            return row("land", False, kind="derived", why_not_done=f"merged; the worktree at {wt} remains",
                       done_by=f"git worktree remove {wt} && git branch -d {slug}; then clerk step")
        return row("land", False, kind="derived", why_not_done=f"merged; branch {slug} remains",
                   done_by=f"git branch -d {slug}; then clerk step")
    cmd = f"git -C {ctx.repo_root} merge --ff-only {slug}"
    if wt:
        cmd += f" && git -C {ctx.repo_root} worktree remove {wt}"
    cmd += f" && git -C {ctx.repo_root} branch -d {slug}"
    return row("land", False, kind="derived", why_not_done=f"archived on {slug}, not yet on {ctx.default}",
               done_by=f"{cmd}; then clerk step")


def plan_signals(ctx):
    """What this run observed about the plan, for the reflection: the tasks the plan
    called routine that were not, the ones it called hard that were, and the fixups that
    found a task boundary drawn across one file."""
    _, tasks = sidecar_tasks(ctx)
    signals, order = task_signals(ctx.run)
    by_n = {t["n"]: t for t in (tasks or [])}
    hard = lambda n: bool(signals.get(n, {}).get("retried") or signals.get(n, {}).get("lint_findings"))
    return {
        "signals": {str(n): signals[n] for n in sorted(signals)},
        "high_certainty_but_hard": [n for n in order if by_n.get(n, {}).get("certainty") == "high" and hard(n)],
        "low_certainty_but_clean": [n for n in order if by_n.get(n, {}).get("certainty") == "low" and not hard(n)],
        "fixup_ambiguous": fixup_ambiguities(ctx.run),
    }


def row_learn(ctx):
    rec = learn_written(ctx.run) or ctx.run.done.get("learn")
    if rec:
        return row("learn", True, none=bool(rec.get("none")), source=rec.get("source", "asserted"))
    return row("learn", False, kind="derived", why_not_done="no learning was written for this run",
               learnings_path=ctx.prepare.get("learnings_path"), plan_signals=plan_signals(ctx),
               done_by=f"clerk learn --list; clerk learn --type ... --title ... --learning ... --apply-when ... --feature {ctx.run.slug}; "
                       f"or, for a run with nothing that generalises: clerk step --done learn --none")


ROWS = [("ground", row_ground), ("isolate", row_isolate), ("plan", row_plan), ("task", row_task),
        ("suite", row_suite), ("audit", row_audit), ("validate", row_validate), ("theory", row_theory),
        ("verify", row_verify), ("land", row_land), ("learn", row_learn)]


def active_rows(ctx):
    """A run that has left its branch by landing is past everything the branch held: only
    the integration and the learnings remain, and both are read from the main checkout."""
    if ctx.branch != ctx.run.slug and landed_elsewhere(ctx):
        return [(n, f) for n, f in ROWS if n in ("land", "learn")]
    return ROWS


def evaluate(ctx):
    """The first row that is not done, or the finished marker."""
    for _, fn in active_rows(ctx):
        r = fn(ctx)
        if not r["done"]:
            return r
    return row("finished", True)


def next_step(ctx):
    """The step that follows, as `clerk step` would print it. Returned by every command
    that closes a step — --start, each --done, audit accept — so the caller acts on it
    instead of asking for it in a second call. The one write is the run's own
    `finished`, stamped the first time the table is walked to its end."""
    r = evaluate(ctx)
    if r["step"] == "finished" and not ctx.run.finished and not ctx.read_only:
        meta = ctx.run.meta
        meta["finished"] = True
        meta["finished_at"] = now()
        ctx.run.write("run.json", meta)
    return present(ctx, r)


# What the caller reads from `facts`: the repo as prepare resolved it, minus what clerk
# keeps for itself — the receipt, the run, the worktrees, the breakdown list, the code
# tree (its own field). Every row already carries the fact it turns on, so the rest is
# orientation; the rest was also a third of every reply, repeated on every call.
FACTS_KEYS = ("repo_root", "work_tree", "in_worktree", "branch", "default_branch", "base", "clean",
              "languages", "test_commands", "test_command", "go_tool_prefix",
              "learnings_path", "learnings_path_source", "commit_skill",
              "tasks_file", "tasks_home", "tasks_tracked", "flags", "flag_sources", "resume")


def facts_for(ctx):
    return {k: ctx.prepare.get(k) for k in FACTS_KEYS if k in ctx.prepare}


def present(ctx, r):
    out = {"run": ctx.run.slug, "step": r["step"]}
    for k, v in r.items():
        if k in ("step", "done"):
            continue
        out[k] = v
    out.setdefault("stop", False)
    out.setdefault("blocked", False)
    out["code_tree"] = ctx.head_ct
    out["harness"] = ctx.harness
    out["instructions"], out["instructions_elided"] = instructions_text(ctx, r["step"])
    out["facts"] = facts_for(ctx)
    return out


# --------------------------------------------------------------------------------
# clerk step
# --------------------------------------------------------------------------------

def parse(argv, spec):
    """Tiny flag parser: spec maps --flag to 'bool' | 'value' | 'list'."""
    opts = {k: ([] if t == "list" else (False if t == "bool" else None)) for k, t in spec.items()}
    rest = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a.startswith("--") and "=" in a and a.split("=", 1)[0] in spec and spec[a.split("=", 1)[0]] != "bool":
            # --flag=value, the spelling every other clerk command takes as well.
            a, v = a.split("=", 1)
            argv = argv[:i] + [a, v] + argv[i + 1:]
        if a in spec:
            t = spec[a]
            if t == "bool":
                opts[a] = True
                i += 1
            else:
                if i + 1 >= len(argv):
                    die(f"{a} needs a value")
                if t == "list":
                    opts[a].append(argv[i + 1])
                else:
                    opts[a] = argv[i + 1]
                i += 2
        elif a.startswith("--") and a not in spec:
            die(f"unknown argument '{a}'")
        else:
            rest.append(a)
            i += 1
    return opts, rest


def cmd_start(slug, request, harness):
    if not slug or not request:
        die("--start <slug> needs --request \"<the request, verbatim>\"")
    cwd = os.getcwd()
    if git("check-ref-format", "--branch", slug, cwd=cwd).returncode != 0:
        die(f"'{slug}' is not a usable branch name")
    common = gitout("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=cwd)
    if not common:
        die("not a git repository")
    rc, prep, err = clerk("prepare", cwd=cwd)
    if rc != 0 or not prep:
        die(f"clerk prepare failed: {err}")
    if slug == prep.get("default_branch"):
        die(f"'{slug}' is the default branch; a run needs a branch of its own")
    run = Run(runs_root(common) / slug)
    if run.exists() and not run.finished:
        emit({"started": False, "reason": f"run '{slug}' is open — continue it with `clerk step`, or `clerk step --rm {slug}` to abandon it",
              "run": run_summary(run, cwd)}, 3)
    if run.exists():
        for p in run.dir.iterdir():
            p.unlink()
    run.write("run.json", {"slug": slug, "request": request, "started_at": now(), "launch_cwd": cwd,
                           "launch_branch": prep.get("branch"), "harness": harness or detect_harness(),
                           "finished": False})
    return {"started": True, "run": slug, "ledger": str(run.dir), "request": request,
            "next": next_step(build_ctx(slug, harness))}


def resolve_tasks_path(ctx, p):
    cand = [Path(p)]
    if not Path(p).is_absolute():
        cand = [Path(ctx.cwd) / p, Path(ctx.prepare.get("tasks_home") or ctx.cwd) / p]
    for c in cand:
        if c.exists():
            return c.resolve()
    die(f"no breakdown at {p}", 1)


def done_ground(ctx, argv):
    o, _ = parse(argv, {"--caller": "value", "--dom": "bool", "--state": "bool"})
    if o["--caller"] not in CALLERS:
        die(f"--caller must be one of {', '.join(CALLERS)}")
    ctx.run.mark("ground", {"caller": o["--caller"], "dom": o["--dom"], "state": o["--state"],
                            "at": now(), "code_tree": ctx.head_ct})
    return {"done": "ground", "caller": o["--caller"]}


def done_plan(ctx, argv):
    o, _ = parse(argv, {"--tasks-file": "value", "--approved": "bool"})
    if not o["--tasks-file"]:
        die("--done plan needs --tasks-file <tasks/<story>.md>")
    tf = resolve_tasks_path(ctx, o["--tasks-file"])
    side = tf.with_suffix(".json")
    if not side.exists():
        emit({"bound": False, "reason": f"no sidecar beside {tf} — run `clerk sidecar` to recover one, then bind again"}, 1)
    findings = lint_sidecar(side, ctx.cwd)
    if findings:
        emit({"bound": False, "reason": "lint certainty-unevidenced reports findings — correct the assessment, do not delete the reference",
              "findings": findings}, 1)
    prev = ctx.run.read("breakdown.json") or {}
    approved = bool(o["--approved"]) or bool(prev.get("approved"))
    ctx.run.write("breakdown.json", {"tasks_file": str(tf), "sidecar": str(side), "approved": approved,
                                     "lint_hash": file_hash(side), "at": now()})
    rc, st, _ = clerk("status", "--tasks-file", str(tf), cwd=ctx.cwd)
    return {"bound": True, "tasks_file": str(tf), "approved": approved,
            "plan": (st or {}).get("progress"), "gears": (st or {}).get("gears")}


def done_tests(ctx, argv):
    _, rest = parse(argv, {})
    if len(rest) != 1 or not rest[0].isdigit():
        die("--done tests <n>")
    tests = ctx.run.done.get("tests") or {}
    tests[rest[0]] = {"at": now(), "code_tree": ctx.head_ct}
    ctx.run.mark("tests", tests)
    return {"done": "tests", "n": int(rest[0])}


def done_validate(ctx, argv):
    o, _ = parse(argv, {"--mismatch": "list", "--resolved": "bool"})
    rec = ctx.run.read("validate.json") or {}
    if o["--resolved"]:
        if rec.get("code_tree") != ctx.head_ct:
            die("nothing to resolve: no validation is recorded at this code tree", 1)
        rec["resolved"] = True
        rec["resolved_at"] = now()
    else:
        rec = {"code_tree": ctx.head_ct, "at": now(), "mismatches": o["--mismatch"], "resolved": False}
    ctx.run.write("validate.json", rec)
    return {"done": "validate", "mismatches": rec["mismatches"], "resolved": rec["resolved"]}


def done_verify_residue(ctx, argv):
    ctx.run.mark("verify-residue", {"at": now(), "code_tree": ctx.head_ct})
    return {"done": "verify-residue"}


def done_learn(ctx, argv):
    o, _ = parse(argv, {"--none": "bool"})
    ctx.run.mark("learn", {"none": o["--none"], "at": now()})
    return {"done": "learn", "none": o["--none"]}


# The steps whose completion is a judgment: recorded with `--done`, never derived.
DONE = {"ground": done_ground, "plan": done_plan, "tests": done_tests, "validate": done_validate,
        "verify-residue": done_verify_residue, "learn": done_learn}


def cmd_done(ctx, step_id, argv):
    if ctx.run is None:
        die("no run is open here — `clerk step --start <slug> --request ...` first", 3)
    handler = DONE.get(step_id)
    if handler is None:
        die(f"unknown step '{step_id}' — --done takes {', '.join(DONE)}")
    payload = handler(ctx, argv)
    payload["next"] = next_step(ctx)
    return payload


def cmd_status(ctx):
    """Every row, evaluated in order and only up to the first that is not done: every later
    row reads state the earlier ones produce, and verify runs git grep over the diff. The
    context is read-only, so looking records nothing."""
    if ctx.run is None:
        return {"run": None, "step": "start", "open_runs": open_run_summaries(ctx)}
    rows = []
    current = "finished"
    active = dict(active_rows(ctx))
    for name, fn in ROWS:
        if name not in active:
            rows.append({"step": name, "done": True, "note": "landed"})
            continue
        if current != "finished":
            rows.append({"step": name, "done": None})
            continue
        r = fn(ctx)
        rows.append({k: v for k, v in r.items() if k in ("step", "done", "why_not_done", "n", "mode", "fallback", "path", "progress", "blocked")})
        if not r["done"]:
            current = r["step"]
    return {"run": ctx.run.slug, "request": ctx.run.meta.get("request"), "finished": ctx.run.finished,
            "current": current, "rows": rows}


def cmd_step(ctx):
    """The next step, or `start` when no run is open here."""
    if ctx.run is None:
        return {"run": None, "step": "start", "stop": False, "blocked": False,
                "why_not_done": "no run is open for this branch",
                "done_by": "clerk step --start <slug> --request \"<the request, verbatim>\"",
                "open_runs": open_run_summaries(ctx), "resume": ctx.prepare.get("resume"),
                "instructions": instructions_for("start", ctx.harness), "facts": facts_for(ctx)}
    return next_step(ctx)


def cmd_rm(slug):
    cwd = os.getcwd()
    common = gitout("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=cwd)
    if not common:
        die("not a git repository")
    run = Run(runs_root(common) / slug)
    if not run.exists():
        die(f"no run '{slug}'")
    for p in run.dir.iterdir():
        p.unlink()
    run.dir.rmdir()
    return {"removed": slug}


STEP_SPEC = {"--start": "value", "--request": "value", "--done": "value", "--status": "bool",
             "--rm": "value", "--run": "value", "--harness": "value", "--full": "bool",
             "-h": "bool", "--help": "bool"}


def main_step(argv):
    """Every branch ends in emit(), which prints and exits; nothing falls through."""
    if "--done" in argv:
        # --done's own flags belong to the step; split them off before parsing ours.
        i = argv.index("--done")
        o, _ = parse(argv[: i + 2], STEP_SPEC)
        ctx = build_ctx(o["--run"], o["--harness"], full=o["--full"])
        emit(cmd_done(ctx, o["--done"], argv[i + 2:]))
    o, rest = parse(argv, STEP_SPEC)
    if o["-h"] or o["--help"]:
        print(__doc__.strip().splitlines()[0])
        print("\nusage: clerk step [--start <slug> --request <text>] [--done <step> ...] [--status] [--full] [--rm <slug>] [--run <slug>] [--harness <name>]")
        sys.exit(0)
    if rest:
        die(f"unexpected argument '{rest[0]}'")
    if o["--start"]:
        emit(cmd_start(o["--start"], o["--request"], o["--harness"]))
    if o["--rm"]:
        emit(cmd_rm(o["--rm"]))
    ctx = build_ctx(o["--run"], o["--harness"], read_only=bool(o["--status"]), full=bool(o["--full"]))
    if o["--status"]:
        emit(cmd_status(ctx))
    emit(cmd_step(ctx))


# --------------------------------------------------------------------------------
# clerk audit — the rounds and the acceptance the audit step reads
# --------------------------------------------------------------------------------

def report_summary(path):
    text = sys.stdin.read() if path == "-" else Path(path).read_text()
    try:
        rep = json.loads(text)
    except json.JSONDecodeError:
        die(f"{path} is not valid JSON")
    if not isinstance(rep, dict):
        rep = {}

    def count(k):
        v = rep.get(k)
        return len(v) if isinstance(v, list) else None

    def texts(k):
        v = rep.get(k)
        return [str(x) for x in v] if isinstance(v, list) else []

    return {"findings": count("findings"), "refuted": count("refuted"), "coverage_gaps": count("coverage_gaps"),
            "lenses": rep.get("lenses"), "lenses_not_run": rep.get("lenses_not_run"),
            # Kept, not just counted. A gap that comes back is the audit saying it will
            # never cover that ground however many rounds run, and a count cannot say it.
            "gaps_text": texts("coverage_gaps")}


GAP_NOISE = {
    "a", "an", "and", "any", "are", "as", "at", "be", "been", "but", "by", "can", "could",
    "did", "do", "does", "for", "from", "had", "has", "have", "in", "is", "it", "its",
    "no", "not", "of", "on", "or", "so", "that", "the", "their", "them", "there", "these",
    "they", "this", "those", "to", "was", "were", "which", "with", "would",
}


def gap_key(text):
    """A gap's content words, for recognising one an earlier round already reported.

    Gaps are prose an agent writes fresh every round, so the same uncovered ground comes
    back reworded and exact matching sees two unrelated gaps."""
    return frozenset(w for w in re.findall(r"[a-z0-9_]+", str(text).lower()) if w not in GAP_NOISE)


def repeated_gaps(current, earlier):
    """Gaps in `current` that one of `earlier` already covers.

    Measured by containment rather than similarity: one round names the same uncovered
    ground in half the words of another, and set similarity reads a shorter retelling as
    a different gap — which is the case this exists to catch."""
    out = []
    for gap in current:
        key = gap_key(gap)
        if len(key) < 4:
            continue
        for prior in earlier:
            smaller = min(len(key), len(prior))
            if smaller and len(key & prior) / smaller >= 0.6:
                out.append(gap)
                break
    return out


def audit_status(ctx, aud, o):
    return aud


def audit_plan(ctx, aud, o):
    if not o["--rounds"] or not o["--rounds"].isdigit():
        die("plan needs --rounds <n>")
    aud["rounds_planned"] = int(o["--rounds"])
    ctx.run.write("audit.json", aud)
    return {"rounds_planned": aud["rounds_planned"], "rounds_done": len(aud["rounds"])}


def audit_round(ctx, aud, o):
    if not o["--report"]:
        die("round needs --report <findings.json> (or - for stdin)")
    fresh, rec, why = receipt_state(ctx)
    if not fresh:
        emit({"recorded": False, "reason": f"the suite must be green at this code tree before an audit round counts: {why}"}, 3)
    if not ctx.prepare.get("clean"):
        emit({"recorded": False, "reason": "the tree is dirty — a verifier left residue or work is in flight; restore the branch tip first"}, 3)
    planned = aud.get("rounds_planned")
    if o["--replan"]:
        if not o["--replan"].isdigit():
            die("--replan needs a number")
        planned = aud["rounds_planned"] = int(o["--replan"])
    if planned is not None and len(aud["rounds"]) >= planned:
        emit({"recorded": False, "reason": f"{planned} round(s) were planned and {len(aud['rounds'])} recorded — say why another is needed with --replan <n>"}, 3)
    summary = report_summary(o["--report"])
    gaps = summary["gaps_text"]
    again = repeated_gaps(gaps, [gap_key(g) for r in aud["rounds"] for g in r.get("gaps_text", [])])
    entry = {"n": len(aud["rounds"]) + 1, "at": now(), "sha": ctx.head, "code_tree": ctx.head_ct,
             "report": None if o["--report"] == "-" else str(Path(o["--report"]).resolve()), **summary}
    aud["rounds"].append(entry)
    ctx.run.write("audit.json", aud)
    out = {"recorded": True, "round": entry, "rounds_planned": planned}
    # Surfaced on the round that repeats it, not left for a reader to notice across three
    # JSON blobs. This is the one signal that says a further round will not reach it.
    if again:
        out["gaps_repeated"] = again
    return out


def audit_accept(ctx, aud, o):
    rounds = aud.get("rounds", [])
    planned = aud.get("rounds_planned")
    at_head = [r for r in rounds if r.get("code_tree") == ctx.head_ct]
    if not rounds:
        emit({"accepted": False, "reason": "no audit round is recorded — record one first"}, 3)
    if not at_head and not o["--early"]:
        emit({"accepted": False, "reason": "no round describes this code tree — run a round, or pass --early \"<why the fixes need no re-audit>\""}, 3)
    if planned is not None and len(rounds) < planned and not o["--early"]:
        emit({"accepted": False, "reason": f"{planned} rounds planned, {len(rounds)} recorded — run the rest, or pass --early \"<why>\""}, 3)
    aud["accepted"] = {"at": now(), "code_tree": ctx.head_ct, "sha": ctx.head,
                       "rounds": len(rounds), "reason": o["--early"]}
    ctx.run.write("audit.json", aud)
    return {"accepted": True, "rounds": len(rounds), "early": o["--early"], "next": next_step(ctx)}



# ---------------------------------------------------------------------------------
# The audit as a phase machine. `next` hands the caller one phase's batch of agents to
# spawn; `record` takes their results and advances. Every decision between the two —
# which lenses, what remit, what a later round's fixes still reach, how many verifiers a
# claim earns and whether one needs a tree — is made here, so the two harnesses differ
# only in how they spawn an agent. Before this, that judgment was JavaScript on one side
# and prose on the other and nothing checked they agreed.
# ---------------------------------------------------------------------------------

PHASES = ("scope", "review", "dedupe", "verify", "report", "done")


def live_of(aud):
    return aud.get("live")


def audit_begin(ctx, aud, o):
    if live_of(aud) and not o["--restart"]:
        lv = aud["live"]
        emit({"began": False, "phase": lv["phase"], "round": lv["round"],
              "reason": "a round is already in flight here — continue it with `clerk audit next`, "
                        "or start it over with --restart"}, 3)
    args = {
        "target": o["--target"] or "branch",
        "base_ref": o["--base"],
        "brief": o["--brief"] or "",
        "story": o["--story"] or "",
        "depth": o["--depth"] or "standard",
        "fixed_files": o["--fixed-file"] or [],
        "lenses": o["--lens"] or [],
        "recheck": json.loads(o["--recheck"]) if o["--recheck"] else [],
        "test_commands": json.loads(o["--test-commands"]) if o["--test-commands"] else
                         (ctx.prepare.get("test_commands") or {}),
    }
    prior = None
    if aud.get("rounds"):
        prior = (aud.get("last_scope") or None)
    aud["live"] = {"round": len(aud.get("rounds", [])) + 1, "phase": "scope", "args": args,
                   "scope": None, "reviews": [], "candidates": [], "verdicts": [],
                   "not_run": [], "lens_notes": [], "report": None, "prior_scope": prior,
                   "started_at": now()}
    ctx.run.write("audit.json", aud)
    return {"began": True, "round": aud["live"]["round"], "phase": "scope",
            "next": audit_next(ctx, aud, o)}


def _spawn(job_id, prompt, schema, agent=None, isolation="none"):
    return {"id": job_id, "prompt": prompt, "schema_name": schema,
            "agent": agent, "isolation": isolation}


def audit_next(ctx, aud, o):
    lv = live_of(aud)
    if not lv:
        emit({"phase": None, "reason": "no round is in flight — `clerk audit begin` first"}, 3)
    a = lv["args"]
    prompts = panel.load_prompts()
    if not prompts:
        die(f"no audit prompt fragments under {panel.prompts_dir()} — set CLERK_AUDIT_PROMPTS "
            f"or CLERK_METHOD_DIR to the method directory")
    phase = lv["phase"]

    if phase == "scope":
        return {"phase": "scope", "round": lv["round"], "concurrent": False,
                "spawn": [_spawn("scope", panel.scope_prompt(
                    prompts, target=a["target"], base_ref=a["base_ref"],
                    prior_scope=lv.get("prior_scope")), "SCOPE_SCHEMA")],
                "record_with": "clerk audit record --phase scope --results <file>"}

    if phase == "review":
        lenses, not_run = panel.build_panel(
            lv["scope"], prompts, fixed_files=a["fixed_files"], lenses_override=a["lenses"],
            story=a["story"], brief=a["brief"], recheck=a["recheck"],
            test_commands=a["test_commands"])
        lv["not_run"] = not_run
        ctx.run.write("audit.json", aud)
        return {"phase": "review", "round": lv["round"], "concurrent": True,
                "spawn": [_spawn(f"review:{l['key']}", l["prompt"], "REVIEW_SCHEMA", l["agent"])
                          for l in lenses],
                "held_back": not_run,
                "record_with": "clerk audit record --phase review --results <file>"}

    if phase == "dedupe":
        ctxb = panel._PromptCtx(lv["scope"], prompts, a["story"], a["brief"], (), a["test_commands"])
        return {"phase": "dedupe", "round": lv["round"], "concurrent": False,
                "spawn": [_spawn("dedupe", ctxb.dedupe(lv["candidates"]), "DEDUP_SCHEMA")],
                "record_with": "clerk audit record --phase dedupe --results <file>"}

    if phase == "verify":
        jobs = panel.verify_jobs(lv["scope"], prompts, lv["candidates"], a["depth"],
                                 story=a["story"], brief=a["brief"],
                                 test_commands=a["test_commands"])
        return {"phase": "verify", "round": lv["round"], "concurrent": True,
                "spawn": [_spawn(f"verify:{j['id']}", j["prompt"], "VERDICT_SCHEMA",
                                 isolation=j["isolation"]) for j in jobs],
                "record_with": "clerk audit record --phase verify --results <file>"}

    if phase == "report":
        confirmed, refuted = _tally(lv)
        ctxb = panel._PromptCtx(lv["scope"], prompts, a["story"], a["brief"], (), a["test_commands"])
        return {"phase": "report", "round": lv["round"], "concurrent": False,
                "spawn": [_spawn("report", ctxb.synth(confirmed, refuted, lv["lens_notes"],
                                                      lv["not_run"]), "SYNTH_SCHEMA")],
                "record_with": "clerk audit record --phase report --results <file>"}

    return {"phase": "done", "round": lv["round"],
            "report": lv.get("report"),
            "record_with": "clerk audit round --report <the report you were handed>"}


def _tally(lv):
    """Majority over the verifiers on each claim. A verifier that could not run has not
    refuted anything: counting it as a vote would let a missing toolchain delete a real
    defect, silently."""
    by_finding = {}
    for v in lv["verdicts"]:
        by_finding.setdefault(v.get("finding_id") or v.get("id"), []).append(v)
    confirmed, refuted = [], []
    for f in lv["candidates"]:
        votes = by_finding.get(f["id"], [])
        usable = [v for v in votes if not v.get("blocked")]
        blocked = bool(votes) and not usable
        against = [v for v in usable if v.get("refuted")]
        basis = (votes[0].get("basis") if votes else "no verifier returned a result")
        if usable and len(against) * 2 > len(usable):
            refuted.append({"finding": f, "basis": (against[0].get("basis") or basis)})
        else:
            confirmed.append({"finding": f, "basis": basis, "blocked": blocked})
    return confirmed, refuted


def _read_results(pathish):
    raw = sys.stdin.read() if pathish == "-" else Path(pathish).read_text(encoding="utf-8")
    try:
        return json.loads(raw)
    except json.JSONDecodeError as e:
        die(f"--results is not JSON: {e}")


def audit_record(ctx, aud, o):
    lv = live_of(aud)
    if not lv:
        emit({"recorded": False, "reason": "no round is in flight — `clerk audit begin` first"}, 3)
    if not o["--phase"]:
        die("record needs --phase <scope|review|dedupe|verify|report>")
    if o["--phase"] != lv["phase"]:
        emit({"recorded": False, "phase": lv["phase"],
              "reason": f"this round is on '{lv['phase']}', not '{o['--phase']}' — "
                        f"`clerk audit next` says what it wants"}, 3)
    if not o["--results"]:
        die("record needs --results <file|-> ")
    data = _read_results(o["--results"])
    ph = lv["phase"]

    if ph == "scope":
        lv["scope"] = data if isinstance(data, dict) else (data[0] if data else {})
        aud["last_scope"] = lv["scope"]
        lv["phase"] = "review"
    elif ph == "review":
        rows = data if isinstance(data, list) else [data]
        lv["reviews"] = rows
        cands, notes = [], []
        for r in rows:
            if not isinstance(r, dict):
                continue
            if r.get("note"):
                notes.append(f"{r.get('lens', r.get('id', 'lens'))}: {r['note']}")
            for f in r.get("findings") or []:
                f.setdefault("lens", r.get("lens") or r.get("id"))
                cands.append(f)
        lv["candidates"], lv["lens_notes"] = cands, notes
        # One finding needs no grouping pass, and none needs no verification either.
        lv["phase"] = "dedupe" if len(cands) > 1 else ("verify" if cands else "report")
    elif ph == "dedupe":
        clusters = data.get("clusters") if isinstance(data, dict) else None
        merged, collapsed, why = panel.merge_clusters(lv["candidates"], clusters)
        lv["candidates"] = merged
        if why:
            lv["not_run"].append(f"dedupe — {why}")
        lv["dedupe_collapsed"] = collapsed
        lv["phase"] = "verify" if lv["candidates"] else "report"
    elif ph == "verify":
        lv["verdicts"] = data if isinstance(data, list) else [data]
        lv["phase"] = "report"
    elif ph == "report":
        lv["report"] = data if isinstance(data, dict) else (data[0] if data else {})
        lv["phase"] = "done"
    else:
        die(f"unknown phase '{ph}'")

    ctx.run.write("audit.json", aud)
    return {"recorded": True, "phase": ph, "next": audit_next(ctx, aud, o)}



def audit_run(ctx, aud, o):
    """Drive a whole round from here: no model reads the phase table, walks it, or decides
    what to spawn. The loop is this function; the model is called only where a judgment is
    actually wanted, and `clerk audit next` still describes each phase for a reader or for
    a harness that would rather drive it by hand."""
    import clerk_audit_exec as ex
    harness = o["--harness-cmd"] or ex.detect_harness()
    if not harness and not o["--dry-run"]:
        die("no coding harness found on PATH — install `claude` or `opencode`, or pass "
            "--harness-cmd, or use --dry-run to see the plan without spawning anything", 3)
    schemas = panel.load_schemas()
    if not schemas and not o["--dry-run"]:
        die(f"no schemas.json beside {panel.prompts_dir()} — a headless agent has no schema "
            f"enforced for it, so the runner cannot validate what comes back")

    if not live_of(aud) or o["--restart"]:
        o2 = dict(o); o2["--restart"] = True
        audit_begin(ctx, aud, o2)
        aud = ctx.run.read("audit.json", aud)

    trace, spent = [], 0.0
    while True:
        nxt = audit_next(ctx, aud, o)
        if nxt["phase"] == "done":
            break
        jobs = nxt.get("spawn") or []
        if o["--dry-run"]:
            trace.append({"phase": nxt["phase"], "jobs": [
                {"id": j["id"], "agent": j.get("agent"), "isolation": j.get("isolation"),
                 "schema": j.get("schema_name"), "prompt_chars": len(j["prompt"])} for j in jobs],
                "held_back": nxt.get("held_back") or []})
            # Nothing came back, so nothing can advance; a dry run reports the first phase
            # and stops rather than inventing results for the ones after it.
            return {"dry_run": True, "phase": nxt["phase"], "plan": trace,
                    "note": "no agent was spawned; record a phase to advance"}
        results = ex.run_batch(jobs, schemas, harness=harness, cwd=ctx.cwd,
                               concurrent=bool(nxt.get("concurrent")), model=o["--model"],
                               log=lambda m: None)
        spent += sum(r.get("cost_usd") or 0 for r in results)
        failed = [r for r in results if not r.get("ok")]
        if failed and nxt["phase"] in ("scope", "report"):
            # These phases are one agent and everything after depends on it.
            emit({"ran": False, "phase": nxt["phase"], "cost_usd": round(spent, 4),
                  "reason": failed[0].get("error")}, 3)
        payload = _payload_for(nxt["phase"], jobs, results)
        trace.append({"phase": nxt["phase"], "jobs": len(jobs),
                      "failed": [r["id"] for r in failed],
                      "cost_usd": round(sum(r.get("cost_usd") or 0 for r in results), 4)})
        tmp = Path(tempfile.mkdtemp(prefix="clerk-audit-")) / "results.json"
        tmp.write_text(json.dumps(payload), encoding="utf-8")
        o3 = dict(o); o3["--phase"] = nxt["phase"]; o3["--results"] = str(tmp)
        audit_record(ctx, aud, o3)
        aud = ctx.run.read("audit.json", aud)

    lv = live_of(aud)
    return {"ran": True, "round": lv["round"], "cost_usd": round(spent, 4),
            "phases": trace, "held_back": lv.get("not_run") or [], "report": lv.get("report"),
            "next": "clerk audit round --report <write the report above to a file>"}


def _payload_for(phase, jobs, results):
    """Shape each phase's replies the way `record` reads them."""
    ok = {r["id"]: r.get("data") for r in results if r.get("ok")}
    if phase in ("scope", "dedupe", "report"):
        return next(iter(ok.values()), {})
    if phase == "review":
        rows = []
        for j in jobs:
            d = ok.get(j["id"])
            if isinstance(d, dict):
                d.setdefault("lens", j["id"].split("review:", 1)[-1])
                rows.append(d)
        return rows
    if phase == "verify":
        rows = []
        for j in jobs:
            d = ok.get(j["id"])
            if isinstance(d, dict):
                d.setdefault("finding_id", j["id"].split("verify:", 1)[-1].split("#", 1)[0])
                rows.append(d)
            else:
                # A verifier that could not run has refuted nothing, and saying so is what
                # keeps a missing toolchain from deleting a real defect.
                rows.append({"finding_id": j["id"].split("verify:", 1)[-1].split("#", 1)[0],
                             "refuted": False, "blocked": True,
                             "basis": "the verifier returned nothing usable"})
        return rows
    return []


AUDIT = {"plan": audit_plan, "round": audit_round, "accept": audit_accept,
         "status": audit_status, "begin": audit_begin, "next": audit_next,
         "record": audit_record, "run": audit_run}


def main_audit(argv):
    """As main_step: every branch ends in emit()."""
    if not argv or argv[0] in ("-h", "--help"):
        print("usage: clerk audit run [--rounds <n>] [--base <ref>] [--brief <s>] [--story <s>]\n            [--fixed-file <p>]... [--model <m>] [--dry-run]   drive a round from here\n       clerk audit begin … | next | record --phase <p> --results <json|->  drive it by hand\n       clerk audit plan --rounds <n> | round --report <json|-> [--replan <n>]\n       clerk audit accept [--early <why>] | status")
        sys.exit(0)
    verb, args = argv[0], argv[1:]
    handler = AUDIT.get(verb)
    if handler is None:
        die(f"unknown verb '{verb}' — {', '.join(AUDIT)}")
    o, _ = parse(args, {"--rounds": "value", "--report": "value", "--replan": "value",
                    "--early": "value", "--run": "value", "--phase": "value",
                    "--results": "value", "--target": "value", "--base": "value",
                    "--brief": "value", "--story": "value", "--depth": "value",
                    "--recheck": "value", "--test-commands": "value",
                    "--fixed-file": "list", "--lens": "list", "--restart": "bool",
                    "--dry-run": "bool", "--model": "value",
                    "--harness-cmd": "value"})
    ctx = build_ctx(o["--run"])
    if ctx.run is None:
        die("no run is open here — `clerk step --start` first", 3)
    aud = ctx.run.read("audit.json", {"rounds_planned": None, "rounds": [], "accepted": None})
    emit(handler(ctx, aud, o))


if __name__ == "__main__":
    if NAME == "audit":
        main_audit(sys.argv[1:])
    else:
        main_step(sys.argv[1:])
