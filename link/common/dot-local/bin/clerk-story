#!/usr/bin/env python3
"""clerk story — a story's deliverables, with their state DERIVED rather than read.

A plan records the cut and the dependency order. Those are decisions, and they belong in
a file. Whether a deliverable has started, finished or landed is an observation, and an
observation copied into the plan is a mirror that goes stale while still reading as
authoritative. Nothing below reads `status:`.

`clerk story stack create [<plan.yaml>]` opens the deliverables as stacked draft PRs,
in dependency order; see clerk_stack.py.

Dispatched to by `clerk` when invoked as `clerk story`, and runnable on its own.
"""

import json
import os
import re
import subprocess
import sys
from functools import lru_cache
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from clerk_lib import Parser, die, git_ok, gitout, repo, worktree_for  # noqa: E402
from clerk_repo import find_archived, resolve_tasks_arg  # noqa: E402

GITHUB_REMOTE = re.compile(r"github\.com[:/](?P<owner>[^/]+)/(?P<name>[^/]+?)(?:\.git)?/?$")
PR_FIELDS = (
    "number state isDraft headRefOid reviewDecision url "
    "commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }"
)
REVIEWS = {"APPROVED": "approved", "CHANGES_REQUESTED": "changes-requested", "REVIEW_REQUIRED": "review-required"}
CHECKS = {"SUCCESS": "pass", "FAILURE": "fail", "ERROR": "fail", "PENDING": "pending", "EXPECTED": "pending"}


def git(*args):
    """stdout, stripped. A failing git call answers with the empty string: every caller
    here is asking a question whose 'no' is an empty answer, not an error."""
    return gitout(*args) or ""


@lru_cache(maxsize=None)
def commit_of(ref):
    return git("rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}") or None


def fetch(default_branch):
    """False when origin did not answer. True when there is no origin to ask."""
    if not git_ok("remote", "get-url", "origin"):
        return True
    try:
        p = subprocess.run(
            ["git", "fetch", "--quiet", "origin", default_branch],
            capture_output=True, text=True, timeout=30,
            env={**os.environ, "GIT_TERMINAL_PROMPT": "0"},
        )
    except subprocess.TimeoutExpired:
        return False
    return p.returncode == 0


def local_branches():
    return [ref.removeprefix("refs/heads/") for ref in git("for-each-ref", "--format=%(refname)", "refs/heads").splitlines()]


def find_plans(tasks_home):
    """Every plan under tasks/ that has not been archived. Archived ones are still plans;
    they describe work that is over, and listing them would bury the live ones."""
    root = Path(tasks_home) / "tasks"
    found = []
    for path in sorted(root.rglob("*")):
        if path.name not in ("plan.yaml", "plan.yml") or not path.is_file():
            continue
        if "completed" in path.parts:
            continue
        found.append(str(path))
    return found


def load_plan(path):
    """yq parses, this shapes. The only YAML in clerk's world is the plan, and one
    conversion to JSON is cheaper than teaching every reader about YAML."""
    try:
        p = subprocess.run(
            ["yq", "-o=json", "-I=0", ".", path], capture_output=True, text=True, check=False
        )
    except FileNotFoundError:
        die("missing required tool: yq")
    if p.returncode != 0:
        die(f"could not read {path}: {p.stderr.strip()}")
    try:
        return json.loads(p.stdout or "{}") or {}
    except json.JSONDecodeError:
        die(f"{path} is not valid YAML")


def task_files_of(deliverable):
    files = deliverable.get("tasks") or []
    return [files] if isinstance(files, str) else list(files)


def task_record_progress(tasks_home, task_files):
    """(total, done) from the breakdowns' task records, which are the run's own record of what
    it finished — written in the same commit as the code they stand for."""
    total = done = 0
    for rel in task_files:
        side = Path(tasks_home) / (rel[:-3] + ".json" if rel.endswith(".md") else rel + ".json")
        # `clerk land` moves a landed deliverable's breakdown into tasks/completed/.
        side = side if side.is_file() else (find_archived(side) or side)
        try:
            data = json.loads(side.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        tasks = data.get("tasks") or []
        total += len(tasks)
        done += sum(1 for t in tasks if t.get("done") is True)
    return total, done


def branch_alias_for(deliverable_id, branches):
    """A branch not carrying the planned name is what makes a driver scaffold a second
    worktree for work already under way. Find the one that looks like it and answer for
    that, rather than reporting the deliverable as untouched."""
    # The id as a whole path segment or dash-separated word: `auth` is found in
    # `feat/auth` and `auth-v2`, and not inside `reauth-fix`.
    pat = re.compile(rf"(^|[/-]){re.escape(deliverable_id)}([/-]|$)")
    for name in branches:
        if pat.search(name):
            return name
    return None


def unmerged_count(ref, branch):
    """`--is-ancestor` asks whether the branch TIP is in the default branch's history,
    which is false for every rebase- or squash-merged branch: the work is in, under new
    SHAs. `git cherry` compares patch ids and marks `+` only what has no counterpart
    upstream, so no `+` lines means everything here already landed, however it got there.
    A squash of more than one commit has a patch id of its own, so only its PR can say."""
    out = git("cherry", ref, branch)
    return sum(1 for line in out.splitlines() if line.startswith("+"))


def base_commit(base, described):
    """A base naming a sibling deliverable means this one stacks on that branch — the
    branch the sibling is really on, alias included, which is why this runs after every
    deliverable is described. Anything else names a ref, preferring its remote: local and
    origin can diverge, and branching from the wrong one silently omits work already
    pushed."""
    if not base:
        return None
    for sib in described:
        if sib.get("id") == base:
            return commit_of(sib.get("branch_alias") or sib.get("branch") or "")
    return commit_of(f"origin/{base}") or commit_of(base)


def tmux_panes():
    """(window, path) for every tmux pane, as `session:index`. None outside tmux."""
    try:
        p = subprocess.run(
            ["tmux", "list-panes", "-a", "-F", "#{session_name}:#{window_index}\t#{pane_current_path}"],
            capture_output=True, text=True, timeout=5,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return []
    if p.returncode != 0:
        return []
    return [tuple(line.split("\t", 1)) for line in p.stdout.splitlines() if "\t" in line]


def windows_by_worktree(worktrees, panes):
    """{worktree path: the first window with a pane inside it}."""
    # Deepest first: the main checkout holds every path under .worktrees/ as well.
    paths = sorted((w["path"] for w in worktrees if w.get("path")), key=len, reverse=True)
    found = {}
    for window, cwd in panes:
        owner = next((p for p in paths if cwd == p or cwd.startswith(p + "/")), None)
        if owner:
            found.setdefault(owner, window)
    return found


def pull_request(node):
    commits = (node.get("commits") or {}).get("nodes") or [{}]
    rollup = ((commits[-1].get("commit") or {}).get("statusCheckRollup") or {}).get("state")
    return {
        "number": node.get("number"),
        "state": (node.get("state") or "").lower(),
        "draft": bool(node.get("isDraft")),
        "review": REVIEWS.get(node.get("reviewDecision")),
        "checks": CHECKS.get(rollup),
        "head": node.get("headRefOid"),
        "url": node.get("url"),
    }


def pull_requests(branches):
    """({branch: its PR}, the error when GitHub could not say). One query for every branch,
    because a list of the repo's PRs takes longer than ten seconds on a large repo. An open
    PR wins over a merged one, and a merged one over a closed one."""
    m = GITHUB_REMOTE.search(git("remote", "get-url", "origin"))
    if not branches or not m:
        return {}, None
    aliases = " ".join(
        f"b{i}: pullRequests(headRefName: {json.dumps(b)}, first: 5, "
        f"orderBy: {{field: CREATED_AT, direction: DESC}}) {{ nodes {{ {PR_FIELDS} }} }}"
        for i, b in enumerate(branches)
    )
    query = f"query($owner: String!, $name: String!) {{ repository(owner: $owner, name: $name) {{ {aliases} }} }}"
    try:
        p = subprocess.run(
            ["gh", "api", "graphql", "-f", f"query={query}", "-f", f"owner={m['owner']}", "-f", f"name={m['name']}"],
            capture_output=True, text=True, timeout=30,
        )
    except FileNotFoundError:
        return {}, "gh is not installed"
    except subprocess.TimeoutExpired:
        return {}, "gh did not answer in 30 seconds"
    if p.returncode != 0:
        return {}, (p.stderr.strip().splitlines() or [f"gh exited {p.returncode}"])[-1]
    try:
        found = json.loads(p.stdout)["data"]["repository"] or {}
    except (json.JSONDecodeError, KeyError, TypeError):
        return {}, "gh did not return the PRs"
    prs = {}
    for i, branch in enumerate(branches):
        nodes = (found.get(f"b{i}") or {}).get("nodes") or []
        pick = next((n for s in ("OPEN", "MERGED", "CLOSED") for n in nodes if n.get("state") == s), None)
        if pick:
            prs[branch] = pull_request(pick)
    return prs, None


def landed_through(pr, branch):
    if not pr or pr["state"] != "merged":
        return False
    # A head this clone never fetched, as the Update branch button on GitHub makes, holds no
    # commit made here.
    if not git_ok("cat-file", "-e", f"{pr['head']}^{{commit}}"):
        return True
    return git_ok("merge-base", "--is-ancestor", branch, pr["head"])


def describe(deliverable, tasks_home, ref, checkout, branches, prefix):
    d = deliverable
    did = d.get("id") or ""
    branch = d.get("branch") or ""
    task_files = task_files_of(d)
    total, done = task_record_progress(tasks_home, task_files)

    alias = None
    effective = branch
    exists = bool(branch) and branch in branches
    if not exists:
        alias = branch_alias_for(did, branches)
        if alias:
            effective, exists = alias, True

    # A worktree is a claim on the deliverable, not evidence of work in it — one standing
    # at the base with no commits is scaffolding a launch left behind, which is resumable
    # and must not read as work under way.
    ahead = unmerged = 0
    worktree = None
    if exists:
        ahead = int(git("rev-list", "--count", f"{ref}..{effective}") or 0)
        unmerged = unmerged_count(ref, effective)
        worktree = worktree_for(effective, checkout.worktrees)
    linked = worktree if worktree and worktree != checkout.repo_root else None

    return {
        "id": did,
        "title": d.get("title") or "",
        "wave": d.get("wave", 1),
        "branch": branch,
        "tasks_file": str(Path(tasks_home) / task_files[0]) if task_files else "",
        "base": d.get("base") or None,
        "base_commit": None,
        "depends_on": list(d.get("depends_on") or []),
        "branch_exists": exists,
        "branch_alias": alias,
        "worktree": worktree,
        "handle": Path(linked).name if linked else f"{prefix}-{did}",
        "window": None,
        "pr": None,
        "ahead": ahead,
        "unmerged_commits": unmerged,
        "total": total,
        "done": done,
    }


def merge_evidence(d):
    """Why the deliverable counts as merged, or None when it does not. A branch deleted after
    merging leaves nothing to compare, so its task record answers for it."""
    landed_by_pr = d.pop("landed_by_pr", False)
    finished = d["total"] > 0 and d["done"] >= d["total"]
    if not d["branch_exists"]:
        return f"branch {d['branch']} is gone and the task record reports {d['done']}/{d['total']}" if finished else None
    if d["ahead"] == 0:
        return "branch carries no commit the default branch lacks" if finished else None
    if d["unmerged_commits"] == 0:
        return "every commit on the branch is patch-present in the default branch"
    if landed_by_pr:
        return f"PR #{d['pr']['number']} is merged on GitHub"
    return None


def settle(deliverables):
    """Merged first, because it decides what unblocks everything else."""
    for d in deliverables:
        d["evidence"] = merge_evidence(d)
        d["merged"] = d["evidence"] is not None

    landed = {d["id"] for d in deliverables if d["merged"]}
    for d in deliverables:
        blocked = [dep for dep in d["depends_on"] if dep not in landed]
        d["blocked_by"] = blocked
        if d["merged"]:
            d["state"] = "merged"
        elif d["total"] > 0 and d["done"] >= d["total"]:
            d["state"] = "awaiting-merge"
        elif d["done"] > 0 or d["ahead"] > 0:
            d["state"] = "in-progress"
        elif blocked:
            d["state"] = "blocked"
        elif d["worktree"] is not None:
            d["state"] = "scaffolded"
        else:
            d["state"] = "ready"
    return deliverables


def pr_label(d, pr_error):
    pr = d["pr"]
    if not pr:
        return "?" if pr_error and d["unmerged_commits"] > 0 else "-"
    number = f"#{pr['number']}"
    if pr["state"] != "open":
        return f"{number} {pr['state']}"
    if pr["checks"] == "fail":
        return f"{number} failing"
    if pr["review"] == "changes-requested":
        return f"{number} changes-requested"
    if pr["draft"]:
        return f"{number} draft"
    if pr["review"] == "approved":
        return f"{number} approved"
    return f"{number} open"


def render_table(stories):
    pr_width = max([len(pr_label(d, s["pr_error"])) for s in stories for d in s["deliverables"]] + [1])
    window_width = max([len(d["window"] or "-") for s in stories for d in s["deliverables"]] + [1])
    lines = []
    for s in stories:
        lines.append(f"{s['story_slug'] or s['plan']}   ({s['story']})")
        if s["pr_error"]:
            lines.append(f"  (gh could not list the PRs: {s['pr_error']})")
        for d in s["deliverables"]:
            # 15, not 14: `awaiting-merge` is exactly 14 characters and would touch the
            # column beside it.
            progress = f"{d['done']}/{d['total']}"
            row = (
                f"  {d['state']:<15}w{d['wave']}  {progress:<6}{pr_label(d, s['pr_error']):<{pr_width}}  "
                f"{d['window'] or '-':<{window_width}}  {d['id']}"
            )
            if d["blocked_by"]:
                row += "  blocked by " + ", ".join(d["blocked_by"])
            if d["branch_alias"]:
                row += f"  ** plan names {d['branch']}, on disk {d['branch_alias']} **"
            elif not d["branch_exists"] and d["state"] != "merged":
                row += "  (no branch yet)"
            lines.append(row)
        lines.append("")
    return "\n".join(lines)


def main(argv):
    if argv and argv[0] == "stack":
        from clerk_stack import main as stack_main
        return stack_main(argv[1:])
    ap = Parser()
    ap.add_argument("--table", action="store_true", help="a table for a human instead of JSON")
    ap.add_argument("--no-fetch", action="store_true", help="compare against origin as it was last fetched")
    ap.add_argument("plan", nargs="?", help="a plan.yaml; default: every live plan under tasks/")
    args = ap.parse_args(argv)
    if args.help:
        print(__doc__.strip())
        print("\nUSAGE\n  clerk story [<plan.yaml>] [--table] [--no-fetch]"
              "\n  clerk story stack [<plan.yaml>] [--json]          print the stack"
              "\n  clerk story stack create [<plan.yaml>] [--json]   open and retarget the PRs")
        return 0
    table, plan_arg = args.table, args.plan

    r = repo()
    tasks_home = r.tasks_home or r.repo_root
    default_branch = r.default_branch
    if not default_branch:
        die("no default branch resolved, and every merged test is taken against one")

    if not args.no_fetch and not fetch(default_branch):
        print(f"clerk story: could not fetch origin {default_branch}; the states are as of the last fetch",
              file=sys.stderr)

    # Compare against origin/<default> when it exists, not the local branch of that name.
    # A local default left unpulled is behind the remote, and every branch cut from the
    # remote then measures as that many commits "ahead" — work that is really the gap
    # between the two, which reads as a deliverable under way when nothing was built.
    ref = default_branch
    if commit_of(f"origin/{default_branch}"):
        ref = f"origin/{default_branch}"

    if plan_arg:
        plan = resolve_tasks_arg(plan_arg, tasks_home)
        if not Path(plan).is_file():
            die(f"plan not found: {plan}")
        plans = [plan]
    else:
        plans = find_plans(tasks_home)
        if not plans:
            die(f"no plan.yaml under {tasks_home}/tasks outside completed/ — name one, or decompose a story first")

    branches = local_branches()
    windows = windows_by_worktree(r.worktrees, tmux_panes())
    described_plans = []
    for path in plans:
        doc = load_plan(path)
        prefix = (doc.get("ticket") or doc.get("story_slug") or "").lower()
        siblings = doc.get("deliverables") or []
        described = [describe(d, tasks_home, ref, r, branches, prefix) for d in siblings if d.get("id")]
        for d in described:
            d["base_commit"] = base_commit(d["base"], described)
            d["window"] = windows.get(d["worktree"])
        described_plans.append((path, doc, described))

    unlanded = [d for _, _, described in described_plans for d in described if d["unmerged_commits"] > 0]
    prs, pr_error = pull_requests([d["branch_alias"] or d["branch"] for d in unlanded])
    for d in unlanded:
        d["pr"] = prs.get(d["branch_alias"] or d["branch"])
        d["landed_by_pr"] = landed_through(d["pr"], d["branch_alias"] or d["branch"])

    stories = [
        {
            "plan": path,
            "story": doc.get("story") or "",
            "story_slug": doc.get("story_slug") or "",
            "ticket": doc.get("ticket") or None,
            "approved": doc.get("approved") or None,
            "default_branch": default_branch,
            "pr_error": pr_error,
            "deliverables": settle(described),
        }
        for path, doc, described in described_plans
    ]

    if table:
        print(render_table(stories))
    else:
        print(json.dumps(stories, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
