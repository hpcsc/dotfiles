#!/usr/bin/env python3
"""clerk guidelines — the project's rules, loaded rather than looked up.

Nothing hands a run the guidelines it is judged against, so the skill described how to
fetch them: read line 1 for the `<!-- index: N-M -->` marker, read that range for the
section names, grep the heading map, then read each wanted section from its offset to
the next heading. Correct, and about twenty tool calls before the first line of code —
which makes it the step that quietly gets shortened when a run is in a hurry, and the
rules that go unread are then found at review, which is the expensive end.

None of it is judgment. Which files a language needs is a table, section bounds are
`^## ` to the next `^## `, and the sections a run must have loaded are the same every
time. So it is one call.

The heading names drift, which is the other reason this stopped being prose. The skill
asked for "Unit of Behavior" and "Assertion Strictness"; Go spells the first "What is a
Unit of Behavior?", and JavaScript has no assertion-strictness section at all — it has
"Assertion Patterns". A prompt matching those by eye succeeds or fails silently. Slots
below carry every spelling, and a slot that matches nothing is reported rather than
dropped, because a section missing from the output reads exactly like a section the
guideline does not have.

Dispatched to by `clerk` when invoked as `clerk guidelines`, and runnable on its own.
"""

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from clerk_lib import clerk, die  # noqa: E402

DEFAULT_ROOT = Path.home() / ".config" / "ai" / "guidelines"

HEADING = re.compile(r"^## +(.*?)\s*$")
USE_WHEN = re.compile(r"^> *Use when: *(.*?)\s*$", re.I)
CONCEPT_MARKER = re.compile(r"^<!--\s*concept:\s*([a-z0-9-]+)\s*-->")

# The caller patterns, as concepts. `--caller ui` is sugar for `--concept caller-ui`,
# kept because which caller a component has is a per-task judgment rather than a fixed
# part of any role's reading.
CALLERS = {c: f"caller-{c}" for c in ("ui", "inbound", "outbound", "async", "exported")}

# The testing guidelines the slot list was written against. Membership, not the
# filename, is what earns the slot treatment: `cue/testing-patterns.md` matches the same
# suffix and shares none of the headings, so cutting it to slots emitted nothing at all
# and four complaints about sections it never claimed to have.
LANGUAGE_FILES = {
    "Go": ["go/testing-patterns.md", "go/naming-patterns.md",
           "go/architecture-principles.md", "go/development-workflow.md"],
    "JavaScript/TypeScript": ["javascript/testing-patterns.md", "javascript/naming-patterns.md",
                              "javascript/architecture-principles.md",
                              "javascript/development-workflow.md"],
    "Elixir": ["elixir/testing-patterns.md", "elixir/naming-patterns.md",
               "elixir/architecture-principles.md", "elixir/development-workflow.md"],
}

# Asked for by flag, because whether a task touches the DOM or shared state is the
# caller's judgment and not a property of the repo.
OPTIONAL_FILES = {
    "dom": "javascript/dom-patterns.md",
    "state": "javascript/state-management.md",
}

ALWAYS = ["testing/caller-patterns.md", "comments.md"]

# The guidelines that declare concepts, and so are read in parts. Everything else is
# short enough that slicing would cost a heading map to save nothing, and arrives whole.
# Membership is explicit rather than inferred from the filename: `cue/testing-patterns.md`
# matches the same suffix, declares no concepts, and is meant to arrive whole.
SLICED = {"testing/caller-patterns.md", "testing/patterns.md",
          "go/testing-patterns.md", "javascript/testing-patterns.md",
          "elixir/testing-patterns.md"}


# tree-sitter's markdown grammar, via ast-grep. `atx_h2_marker` matches only a genuine
# `##` — a line inside a fenced block is example content, and the grammar knows the
# difference where a regex cannot. Two guidelines contain exactly that: a fenced review
# template in domain-modeling.md and one in event-driven-patterns.md, each of which the
# regex reads as a section boundary and splits on.
AST_GREP_RULE = "id: h2\nlanguage: md\nrule: {kind: atx_h2_marker}"


def h2_lines_for(paths):
    """{path: [line index, ...]} for real `## ` headings, or None if ast-grep cannot say.

    One call for the whole plan rather than one per file. None means fall back — the
    regex is worse but it is what a machine without ast-grep has.
    """
    if not paths:
        return {}
    try:
        r = subprocess.run(["ast-grep", "scan", "--json=compact", "--inline-rules",
                            AST_GREP_RULE, *paths], capture_output=True, text=True)
    except OSError:
        return None
    if r.returncode != 0 or not r.stdout.strip():
        return None
    try:
        found = {}
        for m in json.loads(r.stdout):
            found.setdefault(m["file"], []).append(m["range"]["start"]["line"])
    except (ValueError, KeyError, TypeError):
        return None
    return {f: sorted(v) for f, v in found.items()}


def headings(lines, h2=None):
    """Every `## ` heading as (name, start_index, end_index), bounds over `lines`.

    `h2` is the line list ast-grep resolved. Falling back when it is empty but the file
    plainly has headings is deliberate: a parse that returns nothing for a file full of
    `##` has gone wrong, and emitting a guideline with no sections at all is the failure
    that is hardest to notice downstream.
    """
    marks = [(m.group(1), i) for i, line in enumerate(lines) if (m := HEADING.match(line))]
    if h2 is not None and (h2 or not marks):
        keep = set(h2)
        marks = [(n, i) for n, i in marks if i in keep]
    out = []
    for pos, (name, start) in enumerate(marks):
        end = marks[pos + 1][1] if pos + 1 < len(marks) else len(lines)
        out.append((name, start, end))
    return out


def concepts_in(sections, lines):
    """{concept: (heading, start, end)} — what this guideline declares it carries.

    The marker is the contract and the heading above it is prose, so rewording,
    requalifying or renumbering a heading moves nothing a consumer depends on.
    """
    found = {}
    for name, start, end in sections:
        for line in lines[start + 1:min(start + 4, end)]:
            if (m := CONCEPT_MARKER.match(line.strip())):
                found[m.group(1)] = (name, start, end)
                break
    return found


def find_heading(sections, spelling):
    """--section FILE:HEADING, for a section that declares no concept."""
    for name, start, end in sections:
        if name.lower().startswith(spelling.lower()):
            return name, start, end
    return None


def section_index(sections, lines):
    """The section list, computed from the headings rather than read from the file.

    A stored index is a second copy of the headings kept in step by hand, and it went
    stale in the one way nothing notices: it was addressed by a literal line range, so a
    range that no longer covered the table dropped rows with nothing to say they were
    missing. Deriving it means there is no copy to drift.

    Each section may carry a `> Use when:` line of its own, which travels with the
    section through any edit that moves or renames it.
    """
    rows = []
    for name, start, end in sections:
        note = ""
        for line in lines[start + 1:min(start + 4, end)]:
            if (m := USE_WHEN.match(line.strip())):
                note = m.group(1)
                break
        rows.append((name, note))
    if not rows:
        return None
    if any(n for _, n in rows):
        body = "".join(f"| {name} | {note} |\n" for name, note in rows)
        return "| Section | Use when |\n|---|---|\n" + body
    return "".join(f"- {name}\n" for name, _ in rows)


def emit_whole(path, lines, out):
    out.append(f"\n<!-- {path} — whole file -->\n")
    out.append("".join(lines))


def emit_sections(path, lines, wanted, out, resolved, literals=(), h2=None):
    """Emit the sections this file declares for `wanted`, plus any `literals` by heading.

    A concept this file does not carry is not an error — `assertions` lives in the
    testing guidelines and not in caller-patterns, and both are in the same plan. What
    counts as missing is a concept no file in the plan carried at all, which the caller
    settles after every file has been read.
    """
    sections = headings(lines, h2)
    index = section_index(sections, lines)
    if index:
        out.append(f"\n<!-- {path} — every section it has; ask for one with --concept -->\n")
        out.append(index)
    available = concepts_in(sections, lines)
    seen = set()
    for concept in wanted:
        if concept not in available or concept in resolved:
            continue
        name, start, end = available[concept]
        if name in seen:
            continue
        seen.add(name)
        resolved.add(concept)
        out.append(f"\n<!-- {path} § {name}  (concept: {concept}) -->\n")
        out.append("".join(lines[start:end]).rstrip() + "\n")
    for spelling in literals:
        hit = find_heading(sections, spelling)
        if not hit:
            continue
        name, start, end = hit
        if name in seen:
            continue
        seen.add(name)
        resolved.add(f"{path}:{spelling}")
        out.append(f"\n<!-- {path} § {name} -->\n")
        out.append("".join(lines[start:end]).rstrip() + "\n")


def detect_languages(cwd):
    """Ask clerk, so this agrees with what the rest of the run was told."""
    rc, data, err = clerk("prepare", cwd=cwd)
    if rc != 0 or data is None:
        # Pass its reason through. "clerk prepare failed" sent the reader looking at this
        # command, when what it actually says is "not a git repository".
        die(f"{err or f'clerk prepare exited {rc}'} — pass --language explicitly to skip detection")
    return data.get("languages", [])


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--language", action="append", default=[],
                    help="repeatable; defaults to what `clerk prepare` detects")
    ap.add_argument("--caller", choices=sorted(CALLERS),
                    help="sugar for --concept caller-<name>")
    ap.add_argument("--concept", action="append", default=[], metavar="NAME",
                    help="repeatable; a section by the concept it declares")
    ap.add_argument("--file", action="append", default=[], dest="files", metavar="FILE",
                    help="repeatable; a guideline file outside any language bundle")
    ap.add_argument("--only", action="store_true",
                    help="emit only what --file/--section/--caller named: no language "
                         "bundle, no detection, no caller-patterns or comments by default")
    ap.add_argument("--section", action="append", default=[], metavar="FILE:HEADING",
                    help="repeatable; a section by name, e.g. "
                         "go/testing-patterns.md:'Independent Verification'")
    ap.add_argument("--dom", action="store_true", help="add the DOM guideline")
    ap.add_argument("--state", action="store_true", help="add the shared-state guideline")
    ap.add_argument("--guidelines-dir", default=os.environ.get("CLERK_GUIDELINES_DIR"))
    ap.add_argument("--list", action="store_true", help="name the files and sections, no bodies")
    ap.add_argument("-h", "--help", action="store_true")
    args = ap.parse_args()

    if args.help:
        print(__doc__.strip())
        print("\nUSAGE\n  clerk guidelines [--language <L>]... [--caller ui|inbound|outbound|async|exported]"
              "\n                   [--file FILE]... [--section FILE:HEADING]... [--only]"
              "\n                   [--dom] [--state] [--list] [--guidelines-dir <d>]")
        return 0

    root = Path(args.guidelines_dir) if args.guidelines_dir else DEFAULT_ROOT
    if not root.is_dir():
        die(f"no guidelines directory at {root}")

    # --only is the reviewer's mode: name what you want and get that. Detection is
    # skipped too, because a concurrency reviewer in a Go repo wants the concurrency
    # guideline, not everything Go — and being handed the bundle anyway is how a precise
    # request turns back into reading whatever was going.
    if args.only and not (args.files or args.section or args.caller):
        die("--only needs at least one --file, --section or --caller to emit")
    languages = [] if args.only else (args.language or detect_languages(Path.cwd()))

    # Ordered, deduped: caller patterns and comments first because they apply whatever
    # the language is, and they are the two an audit most often finds broken.
    # Files that arrived as part of a set get that set's treatment. A file reached ONLY
    # by --section was asked for one section by name, and giving it the bundle's four
    # instead answers a precise request with whatever was going.
    plan, bundled = [], set()
    if not args.only:
        for f in ALWAYS:
            plan.append(f); bundled.add(f)
    elif args.caller:
        plan.append("testing/caller-patterns.md"); bundled.add("testing/caller-patterns.md")
    for lang in languages:
        for f in LANGUAGE_FILES.get(lang, []):
            if f not in plan:
                plan.append(f)
            bundled.add(f)
    # After the language bundle, not before: a concept is taken from the first file in
    # the plan that declares it, so `--file testing/patterns.md` backs up whatever the
    # language guideline does not carry rather than shadowing what it does.
    for f in args.files:
        if f not in plan:
            plan.append(f)
        bundled.add(f)
    for flag, f in OPTIONAL_FILES.items():
        if getattr(args, flag):
            if f not in plan:
                plan.append(f)
            bundled.add(f)

    # Split on the FIRST colon only: headings contain them ("Assertion Strictness:
    # Match to What You're Testing"), filenames do not.
    wanted = {}
    for spec in args.section:
        rel, sep, heading = spec.partition(":")
        if not sep or not heading.strip():
            die(f"--section {spec!r} needs the form FILE:HEADING")
        wanted.setdefault(rel, []).append(heading.strip())
    for rel in wanted:
        if rel not in plan:
            plan.append(rel)

    unknown = [l for l in languages if l not in LANGUAGE_FILES]

    # Resolve every heading in the plan in one ast-grep call, before reading anything.
    present = [str(root / rel) for rel in plan if (root / rel).is_file()]
    h2_map = h2_lines_for(present)

    # What was asked for, by concept. --caller is the one bit of sugar: which caller a
    # component has is a per-task judgment, not a fixed part of any role's reading.
    asked = list(dict.fromkeys(args.concept + ([CALLERS[args.caller]] if args.caller else [])))

    out, resolved, absent = [], set(), []
    listing = []
    for rel in plan:
        path = root / rel
        if not path.is_file():
            absent.append(rel)
            continue
        lines = path.read_text().splitlines(keepends=True)

        literals = wanted.get(rel, [])
        # A file is read in parts when something was asked of it by name; otherwise it
        # arrives whole. Sliced files are all long, and a caller that named no concept
        # still gets their index, which says what there is to ask for.
        sliced = rel in SLICED or bool(literals)

        listing.append({"file": rel, "lines": len(lines),
                        "read": "in parts" if sliced else "whole"})
        if args.list:
            continue
        if sliced:
            emit_sections(rel, lines, asked, out, resolved, literals,
                          None if h2_map is None else h2_map.get(str(path), []))
        else:
            emit_whole(rel, lines, out)

    if args.list:
        print(json.dumps({"files": listing, "languages": languages,
                          "unknown_languages": unknown, "absent": absent}, indent=2))
        return 0

    if args.only:
        print("# Required reading, as asked for")
    else:
        print(f"# Required reading for: {', '.join(languages) or 'no detected language'}")
    print("\nEverything below is the guideline text itself. Read it; do not re-fetch it.")
    if args.caller:
        print(f"Caller pattern requested: {args.caller}.")
    elif "testing/caller-patterns.md" in plan:
        print("No --caller given, so only the identification section and the Quick Reference "
              "are here.\nOnce you know which pattern this work is, re-run with --caller to "
              "get that section.")
    print("".join(out))

    # What it could not settle, said out loud. A section silently absent reads the same
    # as a section the guideline never had, and only one of those is a problem.
    unresolved = [c for c in asked if c not in resolved]
    unresolved += [f"{rel}:{h}" for rel, hs in wanted.items() for h in hs
                   if f"{rel}:{h}" not in resolved]
    if unresolved or absent or unknown:
        print("\n---\n\n## Not loaded\n")
        for c in unresolved:
            print(f"- **{c}** — no guideline in this set declares it. Either the concept "
                  f"was renamed, or the guideline that carried it was not loaded.")
        for a in absent:
            print(f"- **{a}** does not exist under {root}.")
        for u in unknown:
            print(f"- **{u}** has no guideline set, so nothing language-specific was loaded for it.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
