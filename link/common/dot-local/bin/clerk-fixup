#!/usr/bin/env python3
"""clerk fixup — fold an audit fix into the commit that introduced the defect.

A finding is almost always a defect in one task's work, and the honest place for the
correction is that task's commit. Collecting every fix into a trailing "address audit
findings" commit leaves the branch reading as though each task was right when it landed
and something unnamed happened afterwards, and it trips `clerk verify`'s commit-boundary
check by construction — that check counts the commits touching each task's recorded
files and warns above one.

The skill described the moves: `git log --oneline <base>..HEAD -- <file>`, read the
list, pick, `git commit --fixup=<sha>`, and once all are marked
`GIT_SEQUENCE_EDITOR=true git rebase --autosquash <base>`. Most of that is arithmetic —
and it is the most error-prone shell in the method, run at the point where a mistake
rewrites history.

What is NOT arithmetic is picking between several commits that touched one file. A
catalog, a shared type or a snapshot names the last task that edited it, which is not
necessarily the one the defect came in with; only the finding's evidence settles that.
So this refuses the ambiguous case and prints the candidates, rather than taking the
newest and being quietly wrong. Where a file has one commit in range there is nothing to
weigh, and where several files all point at one commit there is nothing to weigh either.

A repo whose commit-msg hook rejects `fixup!` subjects would otherwise have no fold at
all; `mark_fixup` says how that one check is stepped around, and why the rest are not.

Dispatched to by `clerk` when invoked as `clerk fixup`, and runnable on its own.
"""

import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from clerk_lib import Parser, die, emit, facts  # noqa: E402
from clerk_lib import git as git_raw  # noqa: E402


def git(*args, check=True):
    r = git_raw(*args)
    if check and r.returncode != 0:
        die(f"git {' '.join(args)}: {r.stderr.strip()}")
    return r


def resolve_base(explicit):
    if explicit:
        r = git("rev-parse", "--verify", f"{explicit}^{{commit}}", check=False)
        if r.returncode != 0:
            die(f"--base {explicit} is not a commit")
        return r.stdout.strip()
    # The merge-base `clerk prepare` reports — the one `verify` scopes its own checks by —
    # so a caller that passes neither gets the branch point rather than a guess.
    f = facts()
    if f.get("base") and f.get("branch") != f.get("default_branch"):
        return f["base"]
    # Standing on the default branch there is no other branch to fork from, which is the
    # ordinary shape of an --in-place run: the work is a run of local commits that have
    # not been pushed. Their base is where the branch and its upstream last agreed.
    up = git("rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}", check=False)
    if up.returncode == 0:
        mb = git("merge-base", "HEAD", up.stdout.strip(), check=False)
        if mb.returncode == 0 and mb.stdout.strip():
            return mb.stdout.strip()
    die("could not resolve a base: this branch has no other branch to fork from and no "
        "upstream to compare against. Pass --base <ref> — the commit the work started from")


def git_err(r):
    return r.stderr.strip() or r.stdout.strip()


def mark_fixup(target, subject):
    """Commit the staged fix as `fixup! <subject>`. Returns whether the commit-msg hook
    had to be stepped around to get the marker in.

    A repo whose commit-msg hook validates every subject — conventional commits, a ticket
    prefix, a house linter — rejects `fixup!` outright, and there the whole fold is
    unavailable, because the marker is the only thing `--replay` can find. The hook is not
    wrong about the history it guards: a fixup commit never becomes part of it. `--replay`
    squashes it into the target, whose message the hook already passed, and rebase runs no
    commit-msg hook. So the rejection is of a string that will not exist.

    Which is why the retry steps around that one check and nothing else. The commit is made
    first with the target's own message — one this repo demonstrably accepts, since it is
    in the history — so a pre-commit hook still runs over the content, and a real complaint
    about the fix still stops it. Only the amend that installs the marker is --no-verify,
    and it changes the message alone.
    """
    r = git("commit", f"--fixup={target}", check=False)
    if r.returncode == 0:
        confirm_marker(subject)
        return False

    reuse = git("commit", f"--reuse-message={target}", check=False)
    if reuse.returncode != 0:
        die(f"git commit --fixup failed (files are staged): {git_err(r)}")

    amend = git("commit", "--amend", "--no-verify", "-m", f"fixup! {subject}", check=False)
    if amend.returncode != 0:
        git("reset", "--soft", "HEAD~1", check=False)
        die(f"git commit --fixup failed (files are staged): {git_err(r)}")

    confirm_marker(subject)
    return True


def confirm_marker(subject):
    """`--replay` finds fixups by subject, so a subject that is not one folds nothing."""
    head = git("log", "-1", "--format=%s").stdout.strip()
    if head.startswith(f"fixup! {subject}"):
        return
    git("reset", "--soft", "HEAD~1", check=False)
    emit({"ok": False, "reason": "subject-rewritten", "subject": head,
          "detail": f"the commit was made but its subject is {head!r} rather than 'fixup! "
                    f"{subject}' — a prepare-commit-msg hook rewrote it. `--replay` finds fixups "
                    f"by subject, so the fold would silently never happen. The commit is undone "
                    f"and the files are staged again: keep this fix as its own commit, saying in "
                    f"the message which commit it corrects."}, 3)


def commits_touching(base, path):
    r = git("log", "--format=%H\t%s", f"{base}..HEAD", "--", path, check=False)
    rows = []
    for line in r.stdout.splitlines():
        if "\t" in line:
            sha, subject = line.split("\t", 1)
            rows.append({"sha": sha[:12], "full": sha, "subject": subject})
    return rows


def cmd_apply(args):
    base = resolve_base(args.base)
    files = args.files
    if not files:
        die("name the files this fix touched, after --")

    per_file = {f: commits_touching(base, f) for f in files}

    untouched = [f for f, c in per_file.items() if not c]
    if untouched:
        emit({"ok": False, "reason": "untouched", "files": untouched,
              "detail": f"no commit in {base[:12]}..HEAD touches {', '.join(untouched)} — this "
                        f"is new work rather than a correction to work already committed, so it "
                        f"wants its own commit with a message saying why"}, 3)

    if args.onto:
        r = git("rev-parse", "--verify", f"{args.onto}^{{commit}}", check=False)
        if r.returncode != 0:
            die(f"--onto {args.onto} is not a commit")
        target = r.stdout.strip()
    else:
        ambiguous = {f: c for f, c in per_file.items() if len(c) > 1}
        if ambiguous:
            emit({"ok": False, "reason": "ambiguous",
                 "detail": "more than one commit in range touches these files. The last "
                           "one to edit a file is not necessarily the one the defect came "
                           "in with — read the finding's evidence and name it with --onto.",
                  "candidates": ambiguous}, 3)

        targets = {c[0]["full"] for c in per_file.values()}
        if len(targets) > 1:
            groups = {}
            for f, c in per_file.items():
                groups.setdefault(c[0]["sha"], []).append(f)
            emit({"ok": False, "reason": "spans-commits",
                 "detail": "each file has one unambiguous target, but they differ. Run "
                           "once per group so each correction lands on the commit it "
                           "belongs to.",
                  "groups": groups}, 3)
        target = targets.pop()

    # Commits that touched these files AFTER the target. Staging is whole-file, so
    # everything uncommitted in them rides along, and the fold can only carry hunks whose
    # surrounding lines already exist at the target. That is what makes a shared test file
    # conflict at replay, long after the work that caused it. Said here it costs a
    # regrouping; said by the rebase it costs the round trip that got you there.
    later = {}
    for f in files:
        # target..HEAD, not a slice of base..HEAD: an --onto target that never touched the
        # file is not in that list, and slicing at it reported every commit as "later".
        newer = commits_touching(target, f)
        if newer:
            later[f] = [f"{c['sha']} {c['subject']}" for c in newer]

    subject = git("log", "-1", "--format=%s", target).stdout.strip()
    if args.dry_run:
        emit({"ok": True, "dry_run": True, "target": target[:12], "subject": subject,
              "files": files, **({"also_touched_later": later} if later else {})})

    git("add", "--", *files)
    # Staged but not committed is the tail `clerk verify` reports; if the commit fails
    # the caller needs to know the index was already touched.
    bypassed = mark_fixup(target, subject)
    out_payload = {"ok": True, "target": target[:12], "subject": subject, "files": files,
                   "next_step": "clerk fixup --replay, once every fix is marked"}
    if bypassed:
        out_payload["commit_msg_hook_bypassed"] = True
        out_payload["hook_note"] = (
            "this repo's commit-msg hook rejects fixup! subjects, so the marker went in "
            "with --amend --no-verify over a commit the hook accepted; the content still "
            "passed pre-commit. The branch now carries a subject this repo refuses, which "
            "the replay removes — replay before pushing, and do not push if it refuses.")
    if later:
        out_payload["also_touched_later"] = later
        out_payload["warning"] = (
            "these files are also changed by commits after the target. Staging is "
            "whole-file, so anything else uncommitted in them is in this fixup too, and "
            "the fold can only carry hunks whose surrounding lines already exist at the "
            "target. If the fix spans work belonging to more than one commit, revert the "
            "later-owned hunks, fold this one, then restore them and fold the rest.")
    return out_payload


def cmd_replay(args):
    base = resolve_base(args.base)

    # A rebase needs a clean tree, and in a repo with unrelated work always in flight —
    # a dotfiles checkout, a shared branch mid-experiment — that refusal makes the
    # command unusable rather than safe. --autostash is git's own answer: it sets the
    # loose work aside and puts it back. Opt-in, because if the replay touches a file
    # the working tree also modifies, restoring it can conflict and the caller is the
    # one who knows whether that is likely.
    if git("status", "--porcelain").stdout.strip() and not args.autostash:
        emit({"ok": False, "reason": "dirty-tree",
              "detail": "the tree is dirty; a rebase needs it clean. Commit or stash the loose "
                        "work, or pass --autostash to set it aside and put it back around the "
                        "replay"}, 3)

    pending = [l for l in git("log", "--format=%s", f"{base}..HEAD").stdout.splitlines()
               if l.startswith("fixup!") or l.startswith("squash!")]
    if not pending:
        emit({"ok": True, "folded": 0, "note": "nothing marked for fixup; nothing to replay"})

    # Rewriting a published commit rewrites history someone else may have. The skill
    # says keep the fix as its own commit in that case; this refuses rather than
    # discovering it after the force-push.
    upstream = git("rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}",
                   check=False)
    if upstream.returncode == 0 and not args.force:
        u = upstream.stdout.strip()
        published = git("rev-list", "--count", f"{base}..{u}", check=False).stdout.strip()
        if published.isdigit() and int(published) > 0:
            emit({"ok": False, "reason": "published", "upstream": u, "commits": int(published),
                  "detail": f"{published} commit(s) in this range are already on {u}; folding "
                            f"would rewrite history someone else may have. Keep the fix as its "
                            f"own commit and say why in the message, or pass --force if this "
                            f"branch is yours alone"}, 3)

    before = git("rev-parse", "HEAD").stdout.strip()
    # Both editors, because --autosquash opens the sequence editor and a fixup commit
    # being folded can still reach the message editor on some configurations.
    rebase = ["git", "rebase", "--autosquash"] + (["--autostash"] if args.autostash else []) + [base]
    r = subprocess.run(rebase, capture_output=True,
                       text=True,
                       env={**os.environ, "GIT_SEQUENCE_EDITOR": "true", "GIT_EDITOR": "true"})
    if r.returncode != 0:
        # Read the conflict before aborting throws it away: which paths failed is the
        # whole of what tells you how to regroup.
        conflicted = [l for l in git("diff", "--name-only", "--diff-filter=U",
                                     check=False).stdout.splitlines() if l]
        git("rebase", "--abort", check=False)
        emit({"ok": False, "reason": "conflicted", "conflicted": conflicted,
              "git": r.stderr.strip().splitlines()[-1] if r.stderr.strip() else "conflict",
              "detail": "the replay conflicted and was aborted; the branch is exactly as it was. "
                        "Keep the fix as its own commit — untangling a conflicted replay of your "
                        "own branch costs more than the tidier history is worth."}, 3)

    return {"ok": True, "folded": len(pending), "autostashed": args.autostash,
            "was": before[:12],
            "now": git("rev-parse", "HEAD").stdout.strip()[:12],
            "note": "every SHA from the earliest target onward is new; any receipt taken "
                    "before this describes commits that no longer exist"}


def main():
    ap = Parser()
    ap.add_argument("--base")
    ap.add_argument("--onto", help="name the target commit yourself when several are plausible")
    ap.add_argument("--replay", action="store_true", help="autosquash every marked fixup")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--force", action="store_true", help="replay even if the range is published")
    ap.add_argument("--autostash", action="store_true",
                    help="set unrelated working-tree changes aside and restore them after")
    ap.add_argument("files", nargs="*")
    args = ap.parse_args()

    if args.help:
        print(__doc__.strip())
        print("\nUSAGE\n  clerk fixup [--base <ref>] [--onto <sha>] [--dry-run] -- <files...>"
              "\n  clerk fixup --replay [--base <ref>] [--force] [--autostash]")
        return 0

    if git("rev-parse", "--git-dir", check=False).returncode != 0:
        die("not a git repository")

    # --force is asserted, not inferred: only the caller knows whether the branch is
    # shared, so cmd_replay refuses a published range unless told otherwise.
    if args.replay:
        emit(cmd_replay(args))
    emit(cmd_apply(args))


if __name__ == "__main__":
    sys.exit(main())
