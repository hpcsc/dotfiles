#!/usr/bin/env python3
"""clerk design — the types, fields, methods and names a change adds, drawn from its code.

A run decides the design of a change one task at a time, and a reader used to meet those
decisions only in the finished diff. This command reads them from the code and draws
them, so the decisions are visible at a glance: the exported names and who uses them,
the new and changed types as a class diagram, and the parameters that functions keep
passing together.

    clerk design show [--built] [--base <ref>] [--head <ref>] [--out <file>] [--json]
    clerk design show --planned [<design.yaml>] [--out <file>]
    clerk design show --changes [--out <file>]
    clerk design note <name> "<reason>" [--affects <n>[,<n>...]]
    clerk design words --file <file>
    clerk design prompt <id>

`--base` defaults to the commit the open run started from, else to the merge-base with
the default branch, and `--head` to the working tree. The view is Markdown with Mermaid
diagrams: read it in an editor preview or on GitHub, because a terminal does not draw
Mermaid. With `--out` the view goes to that file and the reply is JSON; `--json` prints
the design itself rather than the view.

`--planned` draws a planned design, the run's own when no file is named. `--changes`
draws the code against the planned design the run bound, with each design change and
its reason. `note` records why the code differs from the planned design; `words` keeps
the table of words the design check wrote, for the view. `prompt` prints the prompt for
the design check of one design change.
"""

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import clerk_design  # noqa: E402
from clerk_lib import die, emit, gitout, parse, repo, take_verb, usage_if_asked  # noqa: E402
from clerk_repo import breakdown_side, now, run_section  # noqa: E402
from clerk_tasks import load_task_record, next_task  # noqa: E402

VERBS = ("show", "note", "words", "prompt")
SHOW_SPEC = {"--built": "bool", "--planned": "bool", "--changes": "bool", "--base": "value",
             "--head": "value", "--out": "value", "--json": "bool"}
NOTE_SPEC = {"--affects": "value"}
WORDS_SPEC = {"--file": "value"}


def run_dir(r):
    """The open run's ledger, when this checkout is on the run's branch."""
    ld = r.ledger_dir
    return ld if ld and Path(ld).name == r.current_branch else None


def default_base(r):
    ld = run_dir(r)
    if ld:
        start = clerk_design.run_base(ld, r.work_tree)
        if start:
            return start
    if not r.default_branch:
        die("no default branch to compare with — pass --base <ref>")
    base = gitout("merge-base", "HEAD", r.default_branch, cwd=r.work_tree)
    if not base:
        die(f"no merge-base between HEAD and {r.default_branch} — pass --base <ref>")
    return base


def write_view(view, out):
    if out:
        Path(out).write_text(view)
        emit({"written": out})
    sys.stdout.write(view)
    sys.exit(0)


def show_planned(r, rest, out):
    if rest:
        planned, errors = clerk_design.load_planned(rest[0])
        if errors:
            emit({"read": False, "errors": errors}, 1)
        title = f"Planned design: {Path(rest[0]).name}"
    else:
        ld = run_dir(r)
        planned = clerk_design.load_state(ld).get("planned") if ld else None
        if not planned:
            die("no planned design is bound to a run here — name the file: clerk design show --planned <design.yaml>")
        title = f"Planned design: {Path(ld).name}"
    write_view(clerk_design.render_planned(planned, title=title), out)


def show_changes(r, out):
    ld = run_dir(r)
    if not ld:
        die("no run is open on this branch — --changes compares the code with the planned design a run bound")
    state = clerk_design.load_state(ld)
    planned = state.get("planned")
    base = default_base(r)
    extra = clerk_design.planned_dirs(planned, r.work_tree) if planned else ()
    try:
        design = clerk_design.built(r.work_tree, base, None, with_uses=True, extra_dirs=extra)
    except RuntimeError as e:
        die(str(e), 1)
    view = clerk_design.render_changes(design, planned, state, title=f"Design changes: {Path(ld).name}")
    if not planned:
        view += "\nThe run bound no planned design, so nothing above is compared with one.\n"
    write_view(view, out)


def cmd_show(argv):
    o, rest = parse(argv, SHOW_SPEC)
    r = repo()
    if not r.work_tree:
        die("not a git repository")
    if o["--planned"]:
        show_planned(r, rest, o["--out"])
    if rest:
        die(f"unexpected argument '{rest[0]}'")
    if o["--changes"]:
        show_changes(r, o["--out"])
    base = o["--base"] or default_base(r)
    head = o["--head"]
    try:
        design = clerk_design.built(r.work_tree, base, head, with_uses=head is None)
    except RuntimeError as e:
        die(str(e), 1)
    if o["--json"]:
        emit(design)
    title = f"Built design: {head or r.current_branch or 'working tree'}"
    view = clerk_design.render_built(design, title=title)
    write_view(view, o["--out"])


def open_task(ld):
    """The task the run has in flight: the first unblocked one not done, or None."""
    bd = run_section(ld, "breakdown")
    side = breakdown_side(bd)
    if not side or not Path(side).is_file():
        return None
    task = next_task(load_task_record(side).get("tasks") or []).get("task")
    return task["n"] if task else None


def cmd_note(argv):
    o, rest = parse(argv, NOTE_SPEC)
    if len(rest) != 2 or not rest[1].strip():
        die('clerk design note <name> "<reason>" — the reason is the point of the note')
    r = repo()
    ld = run_dir(r)
    if not ld:
        die("no run is open on this branch — a design change is recorded against a run")
    affects = []
    for part in (o["--affects"] or "").split(","):
        if part.strip():
            if not part.strip().isdigit():
                die(f"--affects takes task numbers, not '{part.strip()}'")
            affects.append(int(part))
    state = clerk_design.load_state(ld)
    notes = state.setdefault("notes", [])
    note = {"id": f"D{len(notes) + 1}", "name": rest[0], "reason": rest[1].strip(), "task": open_task(ld),
            "affects": affects, "at": now(), "check": None}
    notes.append(note)
    clerk_design.save_state(ld, state)
    return {"recorded": note["id"], "note": note}


def cmd_words(argv):
    o, rest = parse(argv, WORDS_SPEC)
    if rest or not o["--file"]:
        die("clerk design words --file <file>")
    text = Path(o["--file"]).read_text() if Path(o["--file"]).is_file() else None
    if not text or not text.strip():
        die(f"no words table in {o['--file']}", 1)
    r = repo()
    ld = run_dir(r)
    if not ld:
        die("no run is open on this branch — the words table belongs to a run's design view")
    state = clerk_design.load_state(ld)
    state["words"] = text.strip() + "\n"
    clerk_design.save_state(ld, state)
    return {"recorded": "words", "lines": len(text.strip().splitlines())}


def cmd_prompt(argv):
    _, rest = parse(argv, {})
    if len(rest) != 1:
        die("clerk design prompt <id>")
    r = repo()
    ld = run_dir(r)
    if not ld:
        die("no run is open on this branch")
    change = next((n for n in clerk_design.load_state(ld).get("notes") or [] if n["id"] == rest[0]), None)
    if change is None:
        die(f"no design change {rest[0]} in this run", 1)
    import clerk_audit_panel as panel
    from clerk_repo import detect_languages
    prompts = panel.load_prompts()
    if "lens-design" not in prompts:
        die(f"no lens-design prompt under {panel.prompts_dir()} — set CLERK_AUDIT_PROMPTS or CLERK_METHOD_DIR", 1)
    langs = [panel.canonical_lang(l) for l in detect_languages(r.work_tree)]
    lang = next((l for l in langs if l in panel.NAMING_PATTERNS), "Generic")
    sys.stdout.write(panel.design_check_prompt(prompts, change, r.head_sha, lang) + "\n")
    sys.exit(0)


def main(argv):
    usage_if_asked(argv, __doc__)
    verb, rest = take_verb(argv, VERBS, {**SHOW_SPEC, **NOTE_SPEC, **WORDS_SPEC})
    if verb is None:
        die("clerk design <verb> — one of " + ", ".join(VERBS))
    if verb == "show":
        return cmd_show(rest)
    if verb == "prompt":
        return cmd_prompt(rest)
    emit({"note": cmd_note, "words": cmd_words}[verb](rest))


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except json.JSONDecodeError as e:
        die(f"the design reader returned something that is not JSON: {e}", 1)
