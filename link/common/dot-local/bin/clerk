#!/usr/bin/env bash
# clerk — the deterministic mechanics of an implementation run.
#
# It keeps the docket and checks the paperwork; it never judges the work. Everything
# here is something a program does more reliably than a prompt: resolving facts about
# the repo, selecting the next unblocked task, deciding whether a branch may land.
# Writing the code, reviewing it, and deciding a fix is right stay with the model.
#
# Targets bash 3.2 (macOS /bin/bash): no associative arrays, no ${v,,}, no mapfile.
# Requires: git, jq.
#
# If you are an agent reading this to work out what a command would have done: don't.
# The files under <git-dir>/clerk are internal bookkeeping, not an interface, and doing
# a failed command's work by hand defeats the point of it being a command — the
# guarantees live in doing the steps together, not in the end state resembling theirs.
# When a command fails, report the failure and stop.

set -uo pipefail

CLERK_VERSION=0.4.0

die() { printf 'clerk: %s\n' "$1" >&2; exit 2; }

need() { command -v "$1" >/dev/null 2>&1 || die "missing required tool: $1"; }

# The directory this script really lives in, through any symlink. `dirname "$0"` alone
# answers ~/.local/bin when clerk is linked there, which is the one directory a plugin
# missing from PATH is guaranteed not to be in.
self_dir() {
  local p=$0 d
  while [ -L "$p" ]; do
    d=$(dirname "$p"); p=$(readlink "$p")
    case "$p" in /*) ;; *) p="$d/$p" ;; esac
  done
  (cd "$(dirname "$p")" 2>/dev/null && pwd -P)
}

# The executable behind `clerk <name>`: clerk-<name> on PATH, else beside this script.
# One resolution for every caller — the dispatcher looked on PATH alone while `finish`
# also tried its own directory, so a plugin not yet linked into ~/.local/bin ran inside
# `clerk finish` and was "unknown" to `clerk lint` a moment later.
plugin_bin() {
  local p
  p=$(command -v "clerk-$1" 2>/dev/null) && { printf '%s' "$p"; return 0; }
  p="$(self_dir)/clerk-$1"
  [ -x "$p" ] && { printf '%s' "$p"; return 0; }
  return 1
}

# Guards every flag that takes a value, called as `need_value $# --flag`.
#
# `shift 2` with one argument left does nothing and returns 1. Nothing here runs under
# `set -e`, so the argument loop comes round to the same flag and never advances — a
# dangling `--tasks-file` hangs until whatever is driving clerk times out, and a caller
# reading that timeout has no reason to suspect the command line.
need_value() {
  [ "$1" -ge 2 ] || die "$2 needs a value"
}

# --------------------------------------------------------------------------------
# Repo facts
# --------------------------------------------------------------------------------

# The tree we are standing in. Never assume the main checkout: inside a worktree it is
# on another branch entirely, and a suite or verifier pointed there tests code that
# does not contain the feature. This is the resolution the skill prose kept getting
# wrong by saying "the main tree".
#
# The helper keeps git's name because git's is what it returns; `prepare` reports it as
# `build_tree`, because a reader who sees `work_tree` beside `in_worktree` reads it as
# "the worktree" and it is the main checkout whenever there is not one.
work_tree() { git rev-parse --show-toplevel 2>/dev/null; }

# The main repo root, which is NOT the work tree inside a worktree. tasks/ and the
# learnings file live here.
repo_root() {
  local common
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  dirname "$common"
}

# Per-worktree, inside the git dir, so state is never committed and needs no ignore
# entry. --absolute-git-dir resolves to .git/worktrees/<name> in a worktree.
state_dir() {
  local gd
  gd=$(git rev-parse --absolute-git-dir 2>/dev/null) || return 1
  printf '%s/clerk' "$gd"
}

# Where `finish` records which files belonged to which task, one directory per breakdown.
#
# Keyed on the task number alone these collided: a repo delivering its second story wrote
# a task 1 record over the first story's, and nothing removed any of them at landing. A
# tree that had run a ten-task story and then a four-task one kept records 5 through 10
# from a breakdown archived weeks earlier, and verify's commit-boundary check read every
# one — warning about a task number the current breakdown does not contain.
run_records_dir() {
  printf '%s/tasks/%s' "$1" "$(basename "${2%.md}")"
}

# --------------------------------------------------------------------------------
# The run ledger — opened and read by `clerk step`, appended to here.
#
# `clerk step` derives a run's position from evidence, and most of that evidence is a
# clerk command having run: the guidelines were printed, a task was finished, the suite
# was recorded. So every command that produces evidence appends one line to the run's
# events file on its way out — what ran, with what arguments, how it exited, at which
# HEAD — and `land` leaves a stamp with what it decided. Nothing here judges anything;
# the ledger is a record and `clerk step` is its reader. A command with no run to log
# against logs nothing, which is every invocation outside a step-driven run, so nothing
# about these commands changes there.
# --------------------------------------------------------------------------------

# The ledger this invocation belongs to, or nothing. On a feature branch it is the run
# named by the branch; on the default branch it is the one unfinished run, if there is
# exactly one — the rule `clerk step` resolves by, so the two never disagree about which
# run a command served.
ledger_dir() {
  local common runs branch def open n
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  runs="$common/clerk/runs"
  [ -d "$runs" ] || return 1
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  def=$(default_branch)
  if [ -n "$branch" ] && [ "$branch" != HEAD ] && [ "$branch" != "$def" ]; then
    [ -f "$runs/$branch/run.json" ] && { printf '%s' "$runs/$branch"; return 0; }
    return 1
  fi
  open=$(open_runs)
  n=$(printf '%s\n' "$open" | grep -c '[^[:space:]]')
  [ "$n" -eq 1 ] && { printf '%s/%s' "$runs" "$open"; return 0; }
  return 1
}

# Every run under <git-common-dir>/clerk/runs that has not finished, one slug per line.
open_runs() {
  local common runs d
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  runs="$common/clerk/runs"
  [ -d "$runs" ] || return 0
  for d in "$runs"/*/; do
    [ -f "${d}run.json" ] || continue
    [ "$(jq -r '.finished // false' "${d}run.json" 2>/dev/null)" != true ] && basename "$d"
  done
  return 0
}

# Appends one event to the ledger at $1. Never fails the command it records and never
# prints: a logging error must not turn a finished task into a failed one.
ledger_log() {  # <ledger-dir> <cmd> <exit> <argv...>
  local dir=$1 cmd=$2 rc=$3 head; shift 3
  [ -n "$dir" ] && [ -d "$dir" ] || return 0
  head=$(git rev-parse HEAD 2>/dev/null)
  # argv goes in NUL-separated on stdin: jq reads its own options from anywhere on the
  # command line, so an argv carrying --command or --rule would be parsed as jq's.
  printf '%s\0' "$@" | jq -R -s -c --arg cmd "$cmd" --arg rc "$rc" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg head "$head" \
    '{cmd: $cmd, argv: (split("\u0000") | map(select(length > 0))), exit: ($rc | tonumber), at: $at, head: $head}' \
    >> "$dir/events.jsonl" 2>/dev/null || true
}

# Writes one stamp file into the ledger at $1, whole or not at all.
ledger_put() {  # <ledger-dir> <file> <json>
  local dir=$1
  [ -n "$dir" ] && [ -d "$dir" ] || return 0
  printf '%s\n' "$3" > "$dir/$2.tmp" 2>/dev/null && /bin/mv -f "$dir/$2.tmp" "$dir/$2" 2>/dev/null || true
}

# Commands whose success closes a step. Their reply carries the step that follows, as
# `clerk step` would print it — under `next`, or `after_commit` for finish, whose own
# next move is the commit clerk cannot make — so the caller acts on it rather than
# spending a round trip asking. Computed after the event is logged, so the row reads the
# evidence this very command produced: a `--retried` finish shifts the gear it reports.
# Never for the commands `clerk step` itself runs (verify, lint), which would recurse.
INLINE_NEXT=' finish branch land learn '

with_next() {  # <name> <rc> <ledger-dir> <output-file>
  local key=next step_bin nxt
  case "$INLINE_NEXT" in *" $1 "*) ;; *) cat "$4"; return 0 ;; esac
  if [ "$2" -ne 0 ] || [ -z "$3" ] || ! step_bin=$(plugin_bin step) \
     || ! jq -e 'type == "object"' "$4" >/dev/null 2>&1; then
    cat "$4"; return 0
  fi
  [ "$1" = finish ] && key=after_commit
  if nxt=$("$step_bin" 2>/dev/null) && printf '%s' "$nxt" | jq -e . >/dev/null 2>&1; then
    jq --arg k "$key" --argjson n "$nxt" '. + {($k): $n}' "$4"
  else
    cat "$4"
  fi
}

# Runs a built-in and logs it. The ledger is resolved BEFORE the command runs: `land
# --integrate` ends on the default branch, where the run can no longer be named by the
# branch it just merged. The output goes through a file rather than $(...): die() must
# still exit the process, unlogged — a usage error is not evidence of anything.
logged() {  # <name> <function> <args...>
  local name=$1 fn=$2 rc ldir; shift 2
  ldir=$(ledger_dir 2>/dev/null) || ldir=
  CLERK_OUT=$(mktemp "${TMPDIR:-/tmp}/clerk.XXXXXX") || die "cannot create a temp file"
  trap 'rm -f "$CLERK_OUT"' EXIT
  "$fn" "$@" > "$CLERK_OUT"; rc=$?
  ledger_log "$ldir" "$name" "$rc" "$@"
  with_next "$name" "$rc" "$ldir" "$CLERK_OUT"
  return $rc
}

default_branch() {
  local d=
  # Only ask git when origin/HEAD actually exists. Without a remote, `rev-parse
  # --abbrev-ref origin/HEAD` echoes the literal string back, which sed reduces to
  # "HEAD" — and a base of HEAD makes every base..HEAD diff silently empty, so the
  # run's own commits vanish and every scoped check reports nothing to find.
  if git show-ref --verify --quiet refs/remotes/origin/HEAD 2>/dev/null; then
    d=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed 's#^origin/##')
  fi
  case "$d" in ''|HEAD|origin/HEAD) d= ;; esac
  if [ -z "$d" ]; then
    for c in main master; do
      if git show-ref --verify --quiet "refs/heads/$c"; then d=$c; break; fi
    done
  fi
  printf '%s' "$d"
}

tree_is_clean() { [ -z "$(git status --porcelain 2>/dev/null)" ]; }

# The identity of the code at a revision: its tree listing minus the plan files under
# tasks/ — breakdowns, sidecars, the deliverable manifest, the archive. The gate and
# verify compare a receipt by this rather than by SHA, because the Theory section and the
# archive land as tasks/-only commits after the last green, and a SHA comparison called
# that green stale and sent the run back to the suite for a documentation change. A
# source package that happens to be called tasks/ keeps counting as code.
#
# `prepare` reports it for HEAD, and `clerk step` reads it from there rather than
# computing one of its own.
code_tree() {
  local listing
  listing=$(git ls-tree -r "$1" 2>/dev/null) || return 1
  printf '%s' "$(printf '%s\n' "$listing" | grep -vE $'\t''tasks/.*\.(md|json|ya?ml)$')" | shasum -a 1 | cut -d' ' -f1
}

# The recorded suite receipt, and whether it still describes HEAD: it passed, and the
# code it ran against is the code at HEAD — by code tree, not SHA, for the reason above.
# One judgment, read by gate, verify and prepare (where `clerk step` takes it from).
receipt_state() {  # <state-dir> <head-sha>
  local rec="$1/receipt.json" head=$2 rsha rpassed rcmd rat fresh=false why=
  if [ ! -f "$rec" ]; then
    jq -n -c '{recorded: false, fresh: false, passed: false, sha: null, command: null, at: null,
               why: "no suite receipt recorded"}'
    return 0
  fi
  rsha=$(jq -r '.sha // ""' "$rec" 2>/dev/null)
  rpassed=$(jq -r '.passed // false' "$rec" 2>/dev/null)
  rcmd=$(jq -r '.command // ""' "$rec" 2>/dev/null)
  rat=$(jq -r '.at // ""' "$rec" 2>/dev/null)
  if [ "$rpassed" != true ]; then
    why="the recorded receipt failed: $rcmd"
  elif [ "$rsha" != "$head" ] && [ "$(code_tree "$rsha")" != "$(code_tree "$head")" ]; then
    why="the receipt describes ${rsha:0:8}, HEAD is ${head:0:8} — the tree changed after the suite ran, and the code changed with it, not only tasks/; re-run it"
  else
    fresh=true
  fi
  jq -n -c --argjson fresh "$fresh" --argjson passed "$([ "$rpassed" = true ] && printf true || printf false)" \
    --arg sha "$rsha" --arg command "$rcmd" --arg at "$rat" --arg why "$why" \
    '{recorded: true, fresh: $fresh, passed: $passed, sha: $sha, command: $command, at: $at,
      why: (if $why == "" then null else $why end)}'
}


# --------------------------------------------------------------------------------
# tasks/.environment — a gitignored machine-local cache. Written as JSON by the
# opencode sibling; also accept key=value so a hand-written one works.
# --------------------------------------------------------------------------------

env_get() {
  local file=$1 key=$2 v=
  [ -f "$file" ] || return 1
  if head -c1 "$file" 2>/dev/null | grep -q '{'; then
    # `has` rather than `// empty`: jq's alternative operator treats a stored `false`
    # as absent, so a boolean setting could never be turned off by the file that set it.
    v=$(jq -r --arg k "$key" 'if has($k) then .[$k] else empty end' "$file" 2>/dev/null)
  else
    v=$(sed -n "s/^${key}=//p" "$file" 2>/dev/null | head -1 | sed 's/^"//; s/"$//')
  fi
  [ -n "$v" ] && printf '%s' "$v"
}


# --------------------------------------------------------------------------------
# Run flags. A skill flag is often really a property of the repo: one whose build
# cannot run from a worktree wants --in-place on every run, and saying so once in a
# file beats remembering it every time. Precedence mirrors resolve_test_commands — a
# tracked team decision beats a machine-local preference beats the built-in default.
#
# An explicit flag in the request outranks all three, and `prepare --request` applies
# that too. The caller records the request verbatim before anything else, so it can
# hand it over intact; leaving the last step to a prompt made the one resolution that
# had to be redone by hand every run also the one with no test behind it.
# --------------------------------------------------------------------------------

FLAG_KEYS='in_place integrate review_breakdown gears'

# Accepts what a hand-written config plausibly says. Anything unrecognised reads as
# false rather than failing: a typo in this file must never be what turns integration
# on. Off is also what every flag means with nothing set at all, so an unreadable value
# leaves the run behaving exactly as an unconfigured one.
truthy() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    true|1|yes|on) printf 'true' ;;
    *) printf 'false' ;;
  esac
}

# Whether the request switched a flag on or off, or said nothing about it (exit 1).
#
# Matching is on whole whitespace-separated tokens. A request is mostly prose — the
# feature description — and a substring match would let a sentence mentioning
# integration switch integration on. Splitting on whitespace first also keeps a glob
# character in the description from ever reaching the shell as a pattern.
#
# Off wins a request that says both, for the reason truthy() reads an unrecognised
# value as false: off is what a run does with nothing set, so an ambiguous signal must
# never be what changes how one is driven. For the three that decide where the work
# lands, off is the reversible side as well.
request_flag() {
  local request=$1 on=$2 off=$3 toks
  toks=$(printf '%s' "$request" | tr -s '[:space:]' '\n')
  printf '%s\n' "$toks" | grep -Fxq -- "$off" && { printf 'false'; return 0; }
  printf '%s\n' "$toks" | grep -Fxq -- "$on"  && { printf 'true';  return 0; }
  return 1
}

# Prints "<value>\t<source>". The source is reported, not decoration: a run that
# integrated because of a file nobody remembers writing is the failure it prevents.
resolve_flag() {
  # ${3:-} rather than $3: a caller with no request to offer — land, resolving what the
  # repo decided — passes two arguments, and under `set -u` reading the third aborts the
  # subshell this runs in. The caller is left holding an empty string, which reads as a
  # resolution rather than a crash: land reported `integrate: false` with an empty source
  # and a sentence ending "integration is off in ", ignoring a tracked clerk.json that
  # said to integrate.
  local root=$1 key=$2 request=${3:-} cfg="$1/tasks/clerk.json" envf="$1/tasks/.environment" v= on= off=
  # The spelling a request uses for each flag. Kept beside the resolver because the
  # two must agree: a token this does not list is a flag the caller can type and watch
  # be ignored, which is worse than one that is not offered at all.
  case "$key" in
    in_place)    on='--in-place';    off='--worktree' ;;
    integrate)   on='--integrate';   off='--no-integrate' ;;
    review_breakdown) on='--review-breakdown'; off='--no-review-breakdown' ;;
    gears)       on='--gears';       off='--no-gears' ;;
  esac
  if [ -n "$request" ] && v=$(request_flag "$request" "$on" "$off"); then
    printf '%s\trequest' "$v"; return
  fi
  if [ -f "$cfg" ] && jq -e . "$cfg" >/dev/null 2>&1; then
    v=$(jq -r --arg k "$key" 'if has($k) then .[$k] else empty end' "$cfg" 2>/dev/null)
    [ -n "$v" ] && { printf '%s\ttasks/clerk.json' "$(truthy "$v")"; return; }
  fi
  v=$(env_get "$envf" "$key") && { printf '%s\ttasks/.environment' "$(truthy "$v")"; return; }
  printf 'false\tdefault'
}


# Writes the tracked half of the pair above. It goes next to the resolver on purpose:
# the two must agree on the filename and the key spelling, and a scaffold that writes
# a key the resolver does not read is worse than no scaffold, because the setting then
# appears to have been made.
cmd_init() {
  local force=false in_place=false integrate=false review_breakdown=false gears=false root path tracked=true
  while [ $# -gt 0 ]; do
    case "$1" in
      --force)       force=true;       shift ;;
      --in-place)    in_place=true;    shift ;;
      --integrate)   integrate=true;   shift ;;
      --review-breakdown) review_breakdown=true; shift ;;
      --gears)       gears=true;       shift ;;
      *) die "init: unknown argument '$1'" ;;
    esac
  done

  root=$(repo_root) || die "not a git repository"
  path="$root/tasks/clerk.json"
  [ -e "$path" ] && [ "$force" != true ] && die "init: $path already exists (--force overwrites it)"

  mkdir -p "$root/tasks" || die "init: could not create $root/tasks"
  # Every key is written, including the ones left false. JSON takes no comments, so
  # listing them is the file's only way to tell a reader what it accepts — a scaffold
  # holding just the one key you asked for teaches nothing about the rest.
  jq -n --argjson in_place "$in_place" --argjson integrate "$integrate" \
        --argjson review_breakdown "$review_breakdown" --argjson gears "$gears" \
    '{in_place: $in_place, integrate: $integrate, review_breakdown: $review_breakdown, gears: $gears}' > "$path" \
    || die "init: could not write $path"

  # A repo that gitignores tasks/ cannot track this file, so the tracked tier is simply
  # absent there and the settings are this machine's alone. Saying so at the moment of
  # writing beats a teammate wondering why a committed decision never reached them.
  if is_ignored "$root" tasks/clerk.json; then tracked=false; fi
  jq -n --arg path "$path" --argjson tracked "$tracked" --argjson flags "$(jq -c . "$path")" \
    '{created: $path, tracked: $tracked, flags: $flags,
      note: (if $tracked
             then "commit it to make these the defaults for everyone working in this repo"
             else "this repo gitignores tasks/, so it stays machine-local, like tasks/.environment"
             end)}'
}

# --------------------------------------------------------------------------------
# Task file discovery
# --------------------------------------------------------------------------------

# Answers for the path as the repo's own rules see it, which covers .gitignore,
# .git/info/exclude and a global core.excludesFile alike — a repo that keeps tasks/ out
# of history usually does it through info/exclude, where a grep of .gitignore finds
# nothing.
is_ignored() {
  local dir=$1 rel=$2
  (cd "$dir" 2>/dev/null && git check-ignore -q -- "$rel" 2>/dev/null)
}

# Where this repo's breakdowns live, which depends on whether tasks/ is committed.
#
# Tracked: the WORK TREE. The breakdown is content on the branch — inside a worktree it
# is the worktree's copy that gets ticked, staged and committed, and `git add` refuses a
# path from the main checkout as being outside the repository.
#
# Excluded: the MAIN REPO ROOT. Then the breakdown is machine-local and belongs to the
# repository rather than to any one branch, so a fresh worktree is never going to contain
# it — checkout only ever materialises tracked files. Resolving there is what lets a run
# work in a worktree at all; otherwise the only way to see your own breakdown is to build
# in the main checkout, which is exactly the isolation the worktree exists to provide.
tasks_home() {
  local root wt
  root=$(repo_root) || return 1
  wt=$(work_tree)
  if is_ignored "$root" tasks; then printf '%s' "$root"; else printf '%s' "$wt"; fi
}

# find, not a glob: `decompose-to-deliverables` puts one breakdown per deliverable under
# tasks/<story>/<deliverable>/tasks.md, and a glob over tasks/*.md sees none of them —
# which reads as "this repo has no breakdown" rather than as a miss, and sends a run off
# to decompose a story that was already decomposed.
#
# Archived breakdowns are excluded unless asked for. They are still .md files under
# tasks/, so counting them would make a repo with any history look ambiguous to
# find_tasks_file and refuse to resolve at all.
breakdown_paths() {
  local home=$1 include_archived=${2:-no} f
  find "$home/tasks" -name '*.md' -type f 2>/dev/null | sort | while IFS= read -r f; do
    case "$(basename "$f")" in learnings.md) continue ;; esac
    if [ "$include_archived" != yes ]; then
      case "$f" in */completed/*) continue ;; esac
    fi
    printf '%s\n' "$f"
  done
}

# A relative --tasks-file is written the way the repo reads on disk, but cwd inside a
# worktree is not where an excluded breakdown lives — so the natural path misses and the
# error says the file does not exist, which is true of the path and false of the file.
# Try the breakdown home before giving up.
resolve_tasks_arg() {
  local p=$1 th
  case "$p" in /*) printf '%s' "$p"; return ;; esac
  [ -f "$p" ] && { printf '%s' "$p"; return; }
  th=$(tasks_home) || { printf '%s' "$p"; return; }
  if [ -f "$th/$p" ]; then printf '%s' "$th/$p"; else printf '%s' "$p"; fi
}

# "no single task file" was one message for two opposite situations — nothing to work
# from, and several to choose between — which left the caller unable to tell whether the
# fix was to decompose or to name one. In a repo planned as deliverables, several IS the
# normal state, so the ambiguous case has to name the candidates rather than read as an
# absence.
tasks_hint() {
  local home=$1 cmd=$2 paths n
  paths=$(breakdown_paths "$home")
  n=$(printf '%s\n' "$paths" | grep -c '[^[:space:]]')
  if [ "${n:-0}" -eq 0 ]; then
    printf '%s: no breakdown under %s/tasks — decompose the story first, or name one with --tasks-file' "$cmd" "$home"
  else
    printf '%s: %s breakdowns under %s/tasks; name the one this run is building with --tasks-file:\n%s' \
      "$cmd" "$n" "$home" "$(printf '%s\n' "$paths" | sed 's/^/  /')"
  fi
}

find_tasks_file() {
  local root=$1 f n=0 found=
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    found=$f; n=$((n + 1))
  done <<EOF
$(breakdown_paths "$root")
EOF
  [ "$n" -eq 1 ] && { printf '%s' "$found"; return 0; }
  [ "$n" -eq 0 ] && return 1
  return 3
}

# The breakdown a command works on: --tasks-file when given, else the one breakdown under
# tasks/ — exit 1 when there is none, 3 when there are several. What a command does about
# either is its own: next, finish and status cannot proceed and die with tasks_hint; gate
# and verify carry on with a predicate to fail or a gap to report; land dies on several
# and accepts none, because an archived run has no breakdown left to find.
breakdown_for() {  # <--tasks-file value or empty>
  local th found rc
  if [ -n "$1" ]; then resolve_tasks_arg "$1"; return 0; fi
  th=$(tasks_home) || return 1
  found=$(find_tasks_file "$th"); rc=$?
  [ "$rc" -eq 0 ] && { printf '%s' "$found"; return 0; }
  ledger_breakdown && return 0
  return "$rc"
}

# The breakdown the open run bound, for a command that was given none and could not
# resolve one by looking. A repo holding several stories under tasks/ makes every
# hand-typed command ambiguous, and the checks that carry on regardless then report a
# gap rather than run: across ten measured runs a third of `clerk verify` calls arrived
# without --tasks-file and silently skipped the commit-boundary check, which is the one
# thing verify alone can do. The ledger has known the answer since `--done decompose` bound
# it. Only a file still on disk counts, so an archived run falls through to the
# completed/ lookup its caller does rather than resolving to a path that is gone.
ledger_breakdown() {
  local dir tf
  dir=$(ledger_dir) || return 1
  [ -f "$dir/breakdown.json" ] || return 1
  tf=$(jq -r '.tasks_file // empty' "$dir/breakdown.json" 2>/dev/null) || return 1
  [ -n "$tf" ] && [ -f "$tf" ] && { printf '%s' "$tf"; return 0; }
  return 1
}


# --------------------------------------------------------------------------------
# The run's own worktree
#
# Four lines of shell that were pasted into the skill for the caller to retype every
# run, one of them load-bearing for a reason nothing about it suggests: `.worktrees/`
# sits inside the repo, so without the exclude line the new directory shows up as
# untracked, `clean` is `git status --porcelain`, and the next `prepare` from the main
# checkout reports a dirty tree over a directory this tool made. Thirty lines of prose
# defended that line. It is one flag here.
#
# info/exclude rather than .gitignore because editing a tracked file to hide a scratch
# directory is itself an uncommitted change, and the common dir resolves to the main
# .git from inside any worktree, so the line is written once per repo.
#
# The directory itself is not a preference. Claude Code's EnterWorktree allows a path
# under `.claude/worktrees/` without asking and prompts for every other one, as a safety
# check its own permission rules cannot allowlist and auto mode is forbidden to approve
# — so a run there stops on a dialog at the same step every time, and the location is
# the only lever that moves it. No other harness has that rule, or any reason to carry
# Claude's directory in its repos, so everything else keeps `.worktrees/`.
# --------------------------------------------------------------------------------

# CLERK_WORKTREE_DIR wins, then `worktree_dir` in tasks/.environment — machine-local,
# which is the scope this belongs to. tasks/clerk.json is deliberately not read: it is
# tracked, and a value right for the harness of whoever committed it is wrong for the
# next person's.
worktree_dir() {
  local root=$1 v=
  if [ -n "${CLERK_WORKTREE_DIR:-}" ]; then printf '%s' "${CLERK_WORKTREE_DIR%/}"; return; fi
  v=$(env_get "$root/tasks/.environment" worktree_dir) || v=
  if [ -n "$v" ]; then printf '%s' "${v%/}"; return; fi
  if [ -n "${CLAUDECODE:-}" ]; then printf '.claude/worktrees'; else printf '.worktrees'; fi
}

cmd_worktree() {
  local name= base= common parent dir path branch_exists=false existing created=false excluded=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) need_value $# --base; base=$2; shift 2 ;;
      --base=*) base=${1#--base=}; shift ;;
      -*) die "worktree: unknown argument '$1'" ;;
      *) [ -n "$name" ] && die "worktree: one name, not two ('$name' and '$1')"
         name=$1; shift ;;
    esac
  done
  [ -n "$name" ] || die "worktree: name the feature, in kebab-case"
  # Refused here rather than three commands later as a git error about refs.
  git check-ref-format --branch "$name" >/dev/null 2>&1 \
    || die "worktree: '$name' is not a usable branch name"

  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || die "not a git repository"
  parent=$(dirname "$common")
  dir=$(worktree_dir "$parent")
  path="$parent/$dir/$name"

  # Already has a home. Adopting it is the whole point: a second worktree for one
  # feature strands the first one's commits somewhere nobody looks.
  #
  # The main checkout is in `git worktree list` too, and it is the one match that must
  # not be adopted — handing it back as this run's tree is `--in-place` arrived at by
  # accident, with none of the isolation the caller asked for and no note that it lost.
  # One pass: the adoptable path, the sentinel, or nothing. Two passes would have to
  # agree on what "no match" looks like, which is where the first version of this got
  # it wrong — awk exits 0 having matched nothing, and every fresh name read as the
  # main tree. A worktree path is absolute, so it can never collide with the sentinel.
  existing=$(git worktree list --porcelain 2>/dev/null | awk -v b="refs/heads/$name" -v main="$parent" '
    /^worktree /{p=$2} $0 == "branch " b {print (p == main ? "MAIN" : p); exit}')
  if [ "$existing" = MAIN ]; then
    die "worktree: '$name' is checked out in the main tree at $parent — switch it away, or build there with --in-place"
  fi
  if [ -n "$existing" ]; then
    jq -n --arg path "$existing" --arg branch "$name" \
      '{path: $path, branch: $branch, created: false, adopted: true, excluded: null,
        note: "this feature already has a worktree; enter it rather than creating a second"}'
    return 0
  fi

  if ! grep -qxF "$dir/" "$common/info/exclude" 2>/dev/null; then
    mkdir -p "$common/info" && printf '%s/\n' "$dir" >> "$common/info/exclude" \
      && excluded=true
  fi

  [ -e "$path" ] && die "worktree: $path exists but is not a worktree of this repo"

  git show-ref --verify --quiet "refs/heads/$name" && branch_exists=true
  if [ "$branch_exists" = true ]; then
    # The branch is there without a worktree — a run whose tree was removed and whose
    # commits are still on the branch. Checking it out is a resume, not a fresh start.
    git worktree add "$path" "$name" >/dev/null 2>&1 || die "worktree: git worktree add failed for existing branch '$name'"
  else
    git worktree add -b "$name" "$path" ${base:+"$base"} >/dev/null 2>&1 \
      || die "worktree: git worktree add failed (is '$name' checked out elsewhere?)"
    created=true
  fi

  jq -n --arg path "$path" --arg branch "$name" --arg base "$base" --arg dir "$dir" \
    --argjson created "$created" --argjson excluded "$excluded" \
    --argjson adopted "$([ "$branch_exists" = true ] && printf true || printf false)" \
    '{path: $path, branch: $branch, dir: $dir, created: $created, adopted: $adopted, excluded: $excluded,
      base: (if $base == "" then null else $base end),
      note: (if $adopted
             then "the branch already existed; its commits are here"
             else "branched from HEAD" + (if $base == "" then "" else " via " + $base end)
             end)}'
}

# --------------------------------------------------------------------------------
# The in-place counterpart of `clerk worktree`. With in_place on there is no worktree,
# and the method says to create a feature branch when standing on the default one — a
# sentence that reads as optional and got skipped, putting nine commits and two audit
# rounds straight onto main with nothing reviewable to hand over. With --no-integrate the
# same miss leaves unreviewed work on the default branch permanently.
#
# The flag turns off the worktree, not the branch. Same shape as `clerk worktree` so
# neither path has a step the other lacks.
# --------------------------------------------------------------------------------

cmd_branch() {
  # ${1:-} rather than $1: under `set -u` a missing argument aborts the shell before the
  # check below can say what was missing.
  local name=${1:-} def cur
  [ -n "$name" ] || die "branch: name the feature, in kebab-case"
  git check-ref-format --branch "$name" >/dev/null 2>&1 \
    || die "branch: '$name' is not a usable branch name"
  git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"

  def=$(default_branch)
  cur=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

  if [ "$cur" != "$def" ]; then
    jq -n --arg branch "$cur" --arg default "$def" \
      '{branch: $branch, default_branch: $default, created: false, switched: false,
        note: "already off the default branch; the work has somewhere of its own to land"}'
    return 0
  fi

  if git show-ref --verify --quiet "refs/heads/$name"; then
    git switch -q "$name" || die "branch: could not switch to existing branch '$name'"
    jq -n --arg branch "$name" --arg default "$def" \
      '{branch: $branch, default_branch: $default, created: false, switched: true,
        note: "the branch already existed; its commits are here"}'
    return 0
  fi

  git switch -qc "$name" || die "branch: could not create '$name'"
  jq -n --arg branch "$name" --arg default "$def" \
    '{branch: $branch, default_branch: $default, created: true, switched: true,
      note: "branched from the default branch; the work lands here rather than on it"}'
}




# --------------------------------------------------------------------------------
# gate — the four landing predicates, reported with their evidence.
#
# Three are computable. "The audit's findings are fixed or accepted" is a judgment, so
# it is asserted by the caller rather than guessed at here; without the assertion the
# gate simply does not open. In a run driven by `clerk step` that assertion is `clerk
# audit accept`, and `land` reads it — with every other row's evidence — through step's
# answer rather than here.
# --------------------------------------------------------------------------------

sidecar_for() {
  local j="${1%.md}.json"
  [ -f "$j" ] || return 1
  printf '%s' "$j"
}

cmd_gate() {
  local audit_accepted=false tasks_override= dir root wt th head checks ok
  while [ $# -gt 0 ]; do
    case "$1" in
      --audit-accepted) audit_accepted=true; shift ;;
      --tasks-file) need_value $# --tasks-file; tasks_override=$2; shift 2 ;;
      *) die "gate: unknown argument '$1'" ;;
    esac
  done

  root=$(repo_root) || die "not a git repository"
  wt=$(work_tree); th=$(tasks_home)
  dir=$(state_dir)
  head=$(git rev-parse HEAD 2>/dev/null)
  checks="[]"

  # 1. every task checked off
  local tasks detail passed
  tasks=$(breakdown_for "$tasks_override") || tasks=""
  if [ -z "$tasks" ] && [ -f "$dir/archived.json" ]; then
    # The breakdown having been archived IS the evidence every task closed — archiving
    # is gated on it. Without this, a second `land` (say, to integrate after a rebase)
    # finds no breakdown in tasks/ and refuses on a run that already satisfied it.
    passed=true; detail="breakdown already archived at $(jq -r '.path' "$dir/archived.json")"
  elif [ -z "$tasks" ]; then
    passed=false; detail="no task file found under $wt/tasks (pass --tasks-file to name it)"
  elif [ ! -f "$tasks" ]; then
    passed=false; detail="task file not found: $tasks"
  else
    local side donej open
    side=$(sidecar_for "$tasks") || side=""
    if [ -n "$side" ]; then
      donej=$(jq -c '[.tasks[] | select(.done == true) | .n]' "$side")
      open=$(jq -c --argjson done "$donej" '[.tasks[] | select(([.n] | inside($done)) | not)] | length' "$side")
      if [ "${open:-1}" -eq 0 ]; then
        passed=true; detail="every task marked done in $(basename "$side")"
      else
        passed=false; detail="$open task(s) still open in $(basename "$side")"
      fi
    else
      passed=false; detail="no sidecar beside $tasks — run 'clerk sidecar' to recover one"
    fi
  fi
  checks=$(printf '%s' "$checks" | jq -c --argjson ok "$passed" --arg d "$detail" \
    '. + [{name: "tasks-complete", ok: $ok, detail: $d}]')

  # 2. nothing left loose in the tree
  local dirty
  dirty=$(git status --porcelain 2>/dev/null)
  if [ -z "$dirty" ]; then
    passed=true; detail="working tree clean"
  else
    passed=false; detail="uncommitted changes: $(printf '%s' "$dirty" | head -5 | tr '\n' ';')"
  fi
  checks=$(printf '%s' "$checks" | jq -c --argjson ok "$passed" --arg d "$detail" \
    '. + [{name: "tree-clean", ok: $ok, detail: $d}]')

  # 3. the receipt must describe the tree being landed, not an earlier one
  local rs
  rs=$(receipt_state "$dir" "$head")
  if [ "$(printf '%s' "$rs" | jq -r '.fresh')" = true ]; then
    passed=true; detail="green at ${head:0:8}: $(printf '%s' "$rs" | jq -r '.command')"
  else
    passed=false; detail=$(printf '%s' "$rs" | jq -r '.why')
    [ "$(printf '%s' "$rs" | jq -r '.recorded')" = true ] \
      || detail="$detail — run the suite and 'clerk receipt --command ... --passed'"
  fi
  checks=$(printf '%s' "$checks" | jq -c --argjson ok "$passed" --arg d "$detail" \
    '. + [{name: "receipt-fresh", ok: $ok, detail: $d}]')

  # 4. the judgment one — asserted, never inferred.
  if [ "$audit_accepted" = true ]; then
    passed=true; detail="caller asserted audit findings are fixed or explicitly accepted"
  else
    passed=false; detail="pass --audit-accepted once the audit's findings are fixed or the user has accepted them"
  fi
  checks=$(printf '%s' "$checks" | jq -c --argjson ok "$passed" --arg d "$detail" \
    '. + [{name: "audit-accepted", ok: $ok, detail: $d}]')

  ok=$(printf '%s' "$checks" | jq -c 'all(.[]; .ok)')
  printf '%s' "$checks" | jq --argjson ok "$ok" '{ok: $ok, checks: .}'
  [ "$ok" = "true" ]
}

# --------------------------------------------------------------------------------
# verify — the mechanical half of what the run-verifier agent does.
#
# Three of its four checks need no judgment at all, and one of them a script does more
# correctly than the agent currently does: the agent hunts dead code with `rg -w`, which
# the project's own guidelines forbid for symbol questions because text matches prefixes,
# comments and strings. Text search IS sound in one direction though — no textual match
# anywhere means no reference, since text is a superset of identity. Only that direction
# is used here, and anything it cannot settle is reported as not-checked rather than
# guessed at.
# --------------------------------------------------------------------------------

VACUITY_RE='no files changed|no tests to run|no test files|0 passed|0 tests|skip running tests|no tests ran'

cmd_verify() {
  local all_closed=false tasks_override= root th tasks dir def base head findings notchecked rec

  while [ $# -gt 0 ]; do
    case "$1" in
      --all-closed) all_closed=true; shift ;;
      --tasks-file) need_value $# --tasks-file; tasks_override=$2; shift 2 ;;
      *) die "verify: unknown argument '$1'" ;;
    esac
  done

  root=$(repo_root) || die "not a git repository"
  th=$(tasks_home)
  tasks=$(breakdown_for "$tasks_override") || tasks=""
  dir=$(state_dir)
  def=$(default_branch)
  head=$(git rev-parse HEAD 2>/dev/null)
  base=""
  [ -n "$def" ] && base=$(git merge-base HEAD "$def" 2>/dev/null)
  findings="[]"
  notchecked="[]"
  hints="[]"

  add_finding() {
    findings=$(printf '%s' "$findings" | jq -c \
      --arg c "$1" --arg s "$2" --arg d "$3" '. + [{check: $c, severity: $s, detail: $d}]')
  }
  # Two different answers, and conflating them cost a full agent. `not_checked` is ground
  # this check could not JUDGE — a caller has to look. A hint is ground it could not RUN,
  # because it was not given what it needed; the fix is a flag, and there is nothing for a
  # reader to judge. Measured over twelve runs, every residue that spawned the verifier
  # was one of the four hints below.
  add_gap()  { notchecked=$(printf '%s' "$notchecked" | jq -c --arg g "$1" '. + [$g]'); }
  add_hint() { hints=$(printf '%s' "$hints" | jq -c --arg g "$1" '. + [$g]'); }

  # 1. staged-tail — a task that did not close leaves its work staged, so a plain
  #    `git diff` looks empty and the run reads as finished.
  local staged dirty
  staged=$(git diff --cached --name-only 2>/dev/null)
  dirty=$(git status --porcelain 2>/dev/null | grep -v '^??' | head -10)
  if [ -n "$staged" ]; then
    add_finding staged-tail block \
      "staged but uncommitted: $(printf '%s' "$staged" | tr '\n' ' ')— an unfinished task, not a stray edit; inspect 'git diff --staged'"
  elif [ -n "$dirty" ]; then
    add_finding staged-tail warn \
      "tracked files modified but not staged: $(printf '%s' "$dirty" | tr '\n' ';')"
  fi

  # 2. vacuous-receipt — judged from the recorded receipt rather than by re-running,
  #    because the receipt is what the gate trusts and it is what must not be hollow.
  rec="$dir/receipt.json"
  local rs rtail
  rs=$(receipt_state "$dir" "$head")
  if [ "$(printf '%s' "$rs" | jq -r '.fresh')" != true ]; then
    add_finding vacuous-receipt block "$(printf '%s' "$rs" | jq -r '.why')"
  else
    rtail=$(jq -r '.output_tail // ""' "$rec")
    local vac=
    if [ -n "$rtail" ]; then
      # `go test ./...` prints `?  <pkg>  [no test files]` for every package without tests,
      # beside the `ok` lines of the packages that have them. That line is a fact about one
      # package, not a suite that ran nothing, so it only counts when no package ran.
      # `ok <pkg> [no tests to run]` is the same shape: the package built and ran, and
      # none of its tests matched — every test in it sits behind a build tag the suite
      # did not ask for. One of those beside 613 `ok` lines blocked the whole receipt.
      vac=$(printf '%s' "$rtail" | grep -iE "$VACUITY_RE" \
        | grep -viE 'no test files|^ok[[:space:]].*no tests to run' | head -1)
      # "did any package actually run" cannot just look for an `ok` line: a package with
      # no tests to run prints one too, so a suite made entirely of those would answer yes
      # and exempt itself. Only an `ok` line that is not one of those counts as a run.
      if [ -z "$vac" ] && ! printf '%s' "$rtail" | grep -E '^ok[[:space:]]' | grep -qvE 'no tests to run'; then
        vac=$(printf '%s' "$rtail" | grep -iE 'no test files|no tests to run' | head -1)
      fi
    fi
    if [ -n "$vac" ]; then
      add_finding vacuous-receipt block "the receipt's output shows nothing ran: $vac"
    elif [ -z "$rtail" ]; then
      add_hint "vacuous-receipt — the receipt carries no output tail, so it could not be checked for vacuity; record it with --output-file"
    fi
  fi

  # 3. dead-code — new exported symbols with no reference outside their own file and
  #    the tests. Sound-direction-only: zero textual matches proves no reference.
  if [ -n "$base" ]; then
    local gofiles sym deffile hits foreign
    # Extract from production files only. The rule below asks a symbol to prove it has a
    # caller outside the tests, and a symbol *defined* in a _test.go file can never answer
    # it — a `Test…` function least of all, since `go test` discovers it by name and
    # nothing ever references it. Extracted from the whole diff, every new top-level test
    # function blocked the gate.
    gofiles=$(git diff --name-only "$base"..HEAD -- '*.go' ':!*_test.go' 2>/dev/null)
    if [ -n "$gofiles" ]; then
      local kind decl
      for decl in $(git diff "$base"..HEAD -- '*.go' ':!*_test.go' 2>/dev/null \
          | sed -n 's/^+func \([A-Z][A-Za-z0-9_]*\)(.*/func:\1/p; s/^+func ([^)]*) \([A-Z][A-Za-z0-9_]*\)(.*/func:\1/p; s/^+type \([A-Z][A-Za-z0-9_]*\) .*/type:\1/p' \
          | sort -u); do
        kind=${decl%%:*}
        sym=${decl#*:}
        # A method that satisfies a standard-library interface is called by the runtime or
        # by a package that never spells its name — encoding/json for MarshalJSON, fmt for
        # String and Error — so zero textual matches proves nothing about it.
        case "$sym" in
          MarshalJSON|UnmarshalJSON|MarshalText|UnmarshalText|MarshalYAML|UnmarshalYAML|MarshalBinary|UnmarshalBinary|\
          String|Error|GoString|Format|Unwrap|Is|As|Scan|Value|Close|Read|Write|ReadFrom|WriteTo|Seek|ServeHTTP|Len|Less|Swap)
            continue ;;
        esac
        # The declaration, not merely the first file that mentions it. `git grep -l -w`
        # returns paths in tree order, so it names a caller far more often than the
        # definition — every one of emod's fixture symbols resolved to a consumer under
        # internal/cli. That misreports the location, and it silently disarms the
        # fixture-package rule below, which reads the directory of whatever this returns.
        deffile=$(git grep -l -E -- "^(func (\([^)]*\) )?${sym}\(|type ${sym}[ 	])" HEAD -- '*.go' 2>/dev/null | head -1)
        [ -n "$deffile" ] || deffile=$(git grep -l -w -- "$sym" HEAD -- '*.go' 2>/dev/null | head -1)
        # Discounting _test.go callers is what makes this check mean anything — a symbol
        # used only by the test written alongside it is not wired up. A fixture package
        # is the exception that breaks it: it exists to be consumed by _test.go files and
        # nothing else, so the rule asks it to prove the one thing it never can, and
        # every symbol in it blocks the gate.
        case "$(basename "$(dirname "${deffile#*:}")")" in
          test|tests|testutil|testutils|testhelper|testhelpers|testfixtures|fixtures)
            hits=$(git grep -l -w -- "$sym" HEAD -- '*.go' 2>/dev/null | wc -l | tr -d ' ') ;;
          *)
            hits=$(git grep -l -w -- "$sym" HEAD -- '*.go' ':!*_test.go' 2>/dev/null | wc -l | tr -d ' ') ;;
        esac
        if [ "${hits:-0}" -le 1 ]; then
          # A function with no caller is dead, and naming it is the whole point. A type
          # is reached through values, fields, constructors and wrapper types, none of
          # which spell it with word boundaries: a closed set read only via ParseX and
          # stored in an exported map type, or a struct named only as another struct's
          # field, both textually orphaned and both breaking the build if deleted. So a
          # type is reported and never gates on it — the check cannot see far enough.
          # A symbol whose only caller is in another language reads as dead to a grep
          # that reads Go. Bindings are the common case: a method registered on a service
          # and called as `WindowService.SetModified(...)` from JavaScript is spelled in
          # no Go file anywhere. Blocking there stops a correct run on a wrong finding,
          # and a block the reader knows is wrong is one they route around — one measured
          # run did exactly that, landing without the step it had failed. So it is
          # reported as ground this check cannot cover, which still asks for a judgment
          # but does not pretend to have made one. Docs and the breakdown are excluded:
          # naming a symbol in prose is not calling it.
          foreign=$(git grep -l -w -- "$sym" HEAD -- ':!*.go' ':!*.md' ':!*.txt' ':!tasks/*' 2>/dev/null | head -1)
          if [ -n "$foreign" ]; then
            add_gap "dead-code — $sym has no Go caller but is named in ${foreign#*:}; a caller in another language is not something this check can follow"
          elif [ "$all_closed" = true ] && [ "$kind" = func ]; then
            # Reported, never gated on. `--all-closed` means this deliverable's tasks are
            # done, not that the story is: a deliverable in a stack is finished with its
            # first consumer still one PR away, which is a shape `decompose-to-deliverables`
            # produces on purpose. The check cannot tell that from dead code. Measured over
            # twelve runs it blocked 89% of the calls the step made — a fixture holding one
            # exported function and a passing receipt was enough — and three of the six runs
            # that landed did so over a block, because a gate that is usually wrong teaches
            # a caller to route around all four checks rather than this one.
            add_finding dead-code warn "$sym is defined but referenced nowhere outside its own file and the tests — dead, or waiting on a consumer this branch does not contain (${deffile#*:})"
          elif [ "$kind" = type ]; then
            add_finding dead-code warn "type $sym is referenced nowhere outside its own file and the tests — check the constructors, wrapper types and struct fields that reach it before removing it (${deffile#*:})"
          else
            add_finding dead-code warn "$sym has no non-test caller yet — a later task may still wire it (${deffile#*:})"
          fi
        fi
      done
    fi
    # Keyed on what this branch changed, not on what the repository contains. Keyed on the
    # repo it fired on every run of a polyglot one, so the residue was never empty and the
    # verifier was spawned to sweep languages the diff had not touched.
    local changed_ext
    # Space-separated, because the case below matches on " $ext " — left newline-separated
    # by `sort -u`, every extension but the first is preceded by a newline and matches
    # nothing, which reads exactly like a branch that changed no such file.
    changed_ext=$(git diff --name-only "$base"..HEAD 2>/dev/null | sed 's/.*\.//' | sort -u | tr '\n' ' ')
    for pair in "JavaScript/TypeScript:js jsx ts tsx mjs cjs" "Elixir:ex exs"; do
      lang=${pair%%:*}
      for ext in ${pair#*:}; do
        case " $changed_ext " in
          *" $ext "*) add_gap "dead-code — $lang symbols this branch adds were not checked; only Go exported funcs and types are extracted mechanically"
                      break ;;
        esac
      done
    done
  else
    add_hint "dead-code — no merge-base with a default branch, so the run's own commits could not be scoped"
  fi

  # 4. commit-boundary — arithmetic, and only possible because `clerk finish` recorded
  #    which files belonged to which task. Scoped to one breakdown's records: a repo
  #    that runs stories one after another holds several sets, and the ones belonging to
  #    a story already landed describe commits this range does not contain.
  local records=
  [ -n "$tasks" ] && records=$(run_records_dir "$dir" "$tasks")
  if [ -n "$records" ] && [ -d "$records" ] && [ -n "$base" ]; then
    local tf n files c count shared exclusive commits
    # A file two tasks both recorded belongs to both: a later task editing an earlier
    # one's file is the breakdown working as intended, not a split. Counting every
    # commit that touches a shared file made the check fire on exactly that shape — one
    # measured run warned on four of its five tasks, and all four were tasks building
    # incrementally on one file. Only a file this task alone touched can say whether its
    # work stayed in one commit.
    shared=$(jq -r -s '[.[].files[]] | group_by(.) | map(select(length > 1) | .[0]) | .[]' "$records"/*.json 2>/dev/null)
    commits=$(git log --format=%H "$base"..HEAD 2>/dev/null)
    for tf in "$records"/*.json; do
      [ -f "$tf" ] || continue
      n=$(jq -r '.n' "$tf")
      files=$(jq -r '.files[]' "$tf")
      exclusive=$files
      [ -n "$shared" ] && exclusive=$(printf '%s\n' "$files" | grep -vxF -f <(printf '%s\n' "$shared") 2>/dev/null)
      if [ -z "$exclusive" ]; then
        add_gap "commit-boundary — every file task $n recorded was also recorded by another task, so whether its work stayed in one commit cannot be told from the file lists"
        continue
      fi
      count=0
      for c in $commits; do
        if git show --name-only --format= "$c" 2>/dev/null | grep -qxF -f <(printf '%s\n' "$exclusive"); then
          count=$((count + 1))
        fi
      done
      if [ "$count" -gt 1 ]; then
        add_finding commit-boundary warn \
          "task $n's files appear in $count commits — its work was split or swept into another task's commit"
      fi
    done
  elif [ -z "$base" ]; then
    add_hint "commit-boundary — no merge-base with a default branch, so the run's own commits could not be scoped"
  elif [ -z "$tasks" ]; then
    add_hint "commit-boundary — no single breakdown under $th/tasks, so this run's task records could not be identified; name it with --tasks-file"
  else
    add_hint "commit-boundary — no per-task file records for $(basename "${tasks%.md}"); run tasks through 'clerk finish' for this check"
  fi

  local clean
  clean=$(printf '%s' "$findings" | jq -c 'map(select(.severity == "block")) | length == 0')
  jq -n --argjson clean "$clean" --argjson findings "$findings" --argjson not_checked "$notchecked" \
    --argjson hints "$hints" \
    '{clean: $clean, findings: ($findings | sort_by(if .severity == "block" then 0 else 1 end)),
      not_checked: $not_checked, hints: $hints}'
  [ "$clean" = "true" ]
}

# --------------------------------------------------------------------------------
# land — archive the breakdown, then optionally put the branch on the default branch.
#
# Integration is opt-in: landing is the one irreversible step, and its inputs are all
# things the caller assessed about its own work. A branch left standing costs one
# ff-merge later; a bad fast-forward costs a history rewrite.
# --------------------------------------------------------------------------------

cmd_land() {
  # Empty, not false: unset has to stay distinguishable from "asked for off", or the
  # repo default would silently overrule a caller who typed --no-integrate.
  local integrate= integrate_src=request resolved audit=false name= tasks_override= root wt th tasks def branch before after dir

  while [ $# -gt 0 ]; do
    case "$1" in
      --integrate) integrate=true; shift ;;
      --no-integrate) integrate=false; shift ;;
      --audit-accepted) audit=true; shift ;;
      --feature-name) need_value $# --feature-name; name=$2; shift 2 ;;
      --tasks-file) need_value $# --tasks-file; tasks_override=$2; shift 2 ;;
      *) die "land: unknown argument '$1'" ;;
    esac
  done

  # In a run driven by `clerk step`, whether the branch may land is step's answer: the
  # land row is reached only past the audit's acceptance, the story re-read and the
  # verify pass at this code tree, so a `land` typed directly cannot walk past any of
  # them. The gate below then keeps what the table does not look at — a dirty tree, a
  # stale receipt — and the acceptance it would ask to be asserted is step's to vouch for.
  # Three of six measured runs landed over a verify block when the gate read only two of
  # the ledger's files; reading step's answer reads all of them.
  local ldir step_bin nxt step_id
  if ldir=$(ledger_dir 2>/dev/null) && step_bin=$(plugin_bin step); then
    nxt=$("$step_bin" 2>/dev/null) && printf '%s' "$nxt" | jq -e . >/dev/null 2>&1 || nxt='{}'
    step_id=$(printf '%s' "$nxt" | jq -r '.step // empty' 2>/dev/null)
    if [ "$step_id" != land ]; then
      printf '%s' "$nxt" | jq --arg s "${step_id:-unknown}" \
        '{landed: false, step: $s, blocked: (.blocked // false),
          reason: ("the run is at the " + $s + " step, not land: " + (.reason // .why_not_done // "clerk step could not answer"))}'
      return 1
    fi
    audit=true
  fi

  # The gate resolves the breakdown itself, so it has to be told which one when the repo
  # holds several. Unforwarded, its tasks-complete predicate fails asking to be passed
  # --tasks-file, on a command that then refuses the flag — a dead end reached with the
  # work finished and every other predicate green.
  local gate_out gate_rc
  set --
  [ "$audit" = true ] && set -- "$@" --audit-accepted
  [ -n "$tasks_override" ] && set -- "$@" --tasks-file "$tasks_override"
  gate_out=$(cmd_gate "$@")
  gate_rc=$?
  if [ "$gate_rc" -ne 0 ]; then
    printf '%s' "$gate_out" | jq '{landed: false, reason: "gate did not open", gate: .}'
    return 1
  fi

  root=$(repo_root); wt=$(work_tree); th=$(tasks_home); dir=$(state_dir)
  def=$(default_branch); branch=$(git rev-parse --abbrev-ref HEAD)

  # Nothing typed means the repo decides. This runs after the gate rather than before
  # it because a config file cannot change whether the branch is fit to land — only
  # whether a fit branch goes on to be merged.
  if [ -z "$integrate" ]; then
    resolved=$(resolve_flag "$root" integrate)
    integrate=$(printf '%s' "$resolved" | cut -f1)
    integrate_src=$(printf '%s' "$resolved" | cut -f2)
  fi
  # Exit 3 is "several breakdowns, name one"; every other command dies on it. Swallowing
  # it here archived nothing and still reported success — `archived: null` in an output
  # whose other fields all say the landing worked, leaving the breakdown in tasks/ to be
  # counted as in-flight by the next run. Exit 1 is "none", which stays fine: the gate
  # accepts an already-archived run on its archive record.
  local rc
  tasks=$(breakdown_for "$tasks_override"); rc=$?
  [ "$rc" -eq 3 ] && die "$(tasks_hint "$th" land)"
  [ "$rc" -ne 0 ] && tasks=""

  # Archive first, on the feature branch, so the archive commit rides with the work it
  # belongs to instead of landing on the default branch behind it. It also has to come
  # before any rebase: `git mv` leaves a dirty tree, and a dirty tree blocks the rebase.
  local archived=null archive_dir archive_path
  if [ -n "$tasks" ] && [ -f "$tasks" ]; then
    [ -n "$name" ] || name=$(basename "${tasks%.md}")
    archive_dir="$th/tasks/completed"
    mkdir -p "$archive_dir"
    if is_ignored "$(dirname "$tasks")" "$(basename "$tasks")"; then
      # Machine-local breakdown: a plain move, and no archive commit. `git mv` would
      # refuse a path it does not track, and committing it would put in history the very
      # thing this repo decided to keep out of it.
      /bin/mv -f "$tasks" "$archive_dir/$(basename "$tasks")" || die "land: could not archive $tasks"
      [ -f "${tasks%.md}.json" ] && /bin/mv -f "${tasks%.md}.json" "$archive_dir/$(basename "${tasks%.md}").json"
      archive_path="$archive_dir/$(basename "$tasks")"
    else
      git mv "$tasks" "$archive_dir/$(basename "$tasks")" 2>/dev/null \
        || die "land: could not archive $tasks"
      if [ -f "${tasks%.md}.json" ]; then
        git mv "${tasks%.md}.json" "$archive_dir/$(basename "${tasks%.md}").json" 2>/dev/null || true
      fi
      git commit -qm "Archive completed task: $name" || die "land: archive commit failed"
      archive_path="tasks/completed/$(basename "$tasks")"
    fi
    archived=$(jq -n --arg p "$archive_path" '$p')
    mkdir -p "$dir"
    jq -n --arg p "$archive_path" --arg n "$name" \
      '{path: $p, name: $n}' > "$dir/archived.json"
    # Archiving is where the records stop meaning anything: the breakdown has left
    # tasks/, so nothing can resolve them again, and left behind they are what a later
    # story's verify reads. Done here rather than after integration because a run that
    # archives and declines to integrate has finished with them just the same.
    /bin/rm -rf "$(run_records_dir "$dir" "$tasks")"
  fi
  # Resolved here, on the feature branch, because integration ends on the default one.
  local ldir
  ldir=$(ledger_dir 2>/dev/null) || ldir=
  ledger_put "$ldir" land.json "$(jq -n -c --argjson archived "$archived" --arg i "$integrate" --arg src "$integrate_src" \
    --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{archived: $archived, integrate: ($i == "true"), integrate_source: $src, landed: false, at: $at}')"

  if [ "$integrate" != true ]; then
    jq -n --arg b "$branch" --arg d "$def" --arg wt "$wt" --arg src "$integrate_src" \
      --argjson archived "$archived" \
      '{landed: false, archived: $archived, branch: $b, default_branch: $d, build_tree: $wt,
        integrate: false, integrate_source: $src,
        note: (if $src == "request" or $src == "default"
               then "integration is opt-in and was not requested"
               else "integration is off in " + $src end),
        to_land: ("git -C <main checkout> merge --ff-only " + $b + " (rebase onto " + $d + " first if the base moved)")}'
    return 0
  fi

  [ -n "$def" ] || die "land: cannot resolve a default branch"
  [ "$branch" != "$def" ] || die "land: already on $def — nothing to integrate"

  before=$(git rev-parse HEAD)
  if ! git rebase "$def" >/dev/null 2>&1; then
    git rebase --abort >/dev/null 2>&1
    jq -n --arg d "$def" '{landed: false, reason: ("rebase onto " + $d + " conflicted; branch left exactly as it was"),
                           note: "resolve it yourself or hand it to the user — do not resolve someone else'"'"'s merge"}'
    return 1
  fi
  after=$(git rev-parse HEAD)

  # Green-before-rebase is not green-after. If commits actually replayed onto a moved
  # base, the recorded receipt describes a tree that no longer exists, so landing stops
  # here until the suite has been re-run against the new HEAD.
  if [ "$before" != "$after" ]; then
    jq -n --arg b "$before" --arg a "$after" \
      '{landed: false, rebased: true, reason: "the rebase replayed commits onto a moved base",
        was: $b, now: $a,
        next_step: "re-run the full suite, record it with '"'"'clerk receipt'"'"', then run '"'"'clerk land --integrate'"'"' again"}'
    return 3
  fi

  if [ "$root" != "$wt" ]; then
    # The order is the whole point. `git branch -d` refuses while a worktree has the
    # branch checked out, and `git worktree prune` does not remove one whose directory is
    # still there — so instructions that end at prune walk the caller into a refusal with
    # no explanation. Remove the worktree first. `git worktree remove` refuses a dirty
    # one, which is the safety check worth keeping rather than working around.
    jq -n --arg b "$branch" --arg d "$def" --arg root "$root" --arg wt "$wt" \
      '{landed: false, rebased: false,
        reason: "this is a worktree; the branch is checked out here so it cannot be merged and deleted from inside it",
        next_step: ("leave the worktree with the branch KEPT (removing it here would delete the branch about to be merged), then run the command below from anywhere"),
        command: ("git -C " + $root + " merge --ff-only " + $b
                  + " && git -C " + $root + " worktree remove " + $wt
                  + " && git -C " + $root + " branch -d " + $b),
        worktree: $wt}'
    return 3
  fi

  git switch -q "$def" || die "land: could not switch to $def"
  if ! git merge --ff-only "$branch" >/dev/null 2>&1; then
    git switch -q "$branch"
    jq -n '{landed: false, reason: "merge --ff-only refused: the base moved again", next_step: "rebase and re-run the suite, then retry"}'
    return 1
  fi
  # `git branch -d` refuses while any worktree has the branch checked out. Discarding that
  # failure reported the branch as deleted when it was still there, so the caller believed
  # a cleanup that never happened. Report what actually holds it.
  local deleted=true holder=
  if ! git branch -d "$branch" >/dev/null 2>&1; then
    deleted=false
    holder=$(git worktree list --porcelain 2>/dev/null | awk -v b="refs/heads/$branch" '
      /^worktree /{p=$2} $0 == "branch " b {print p; exit}')
  fi
  ledger_put "$ldir" land.json "$(jq -n -c --argjson archived "$archived" --arg src "$integrate_src" \
    --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson deleted "$deleted" \
    '{archived: $archived, integrate: true, integrate_source: $src, landed: true, deleted_branch: $deleted, at: $at}')"

  jq -n --arg d "$def" --arg b "$branch" --argjson archived "$archived" \
    --argjson deleted "$deleted" --arg holder "$holder" --arg src "$integrate_src" \
    --arg log "$(git log --oneline -5)" \
    '{landed: true, integrate_source: $src, archived: $archived, base_branch: $d, branch: $b,
      deleted_branch: (if $deleted then $b else null end),
      branch_left: (if $deleted then null
                    elif $holder != "" then ($b + " still exists: the worktree at " + $holder + " has it checked out. Remove that worktree, then: git branch -d " + $b)
                    else ($b + " still exists: git branch -d refused it. Find out why before deleting it by hand.") end),
      pushed: false, log: ($log | split("\n"))}'
}

# --------------------------------------------------------------------------------

usage() {
  cat <<'EOF'
clerk — deterministic mechanics for an implementation run

A run is driven by `clerk step`: open it once with `clerk step --start <slug> --request
"<the request, verbatim>"`, then call `clerk step`, do what it says, and call it again
until it reports finished. The commands below are what those steps run.

USAGE
  clerk init [--force] [--in-place] [--integrate] [--review-breakdown] [--gears]
                                     scaffold tasks/clerk.json with the flags named
                                     set on and the rest written out off
  clerk prepare [--request <text>]   resolve the repo's facts as JSON; the request is
                                     scanned for the flags and --learnings-path it
                                     carries, which outrank every config file
  clerk worktree <kebab-name> [--base <ref>]
                                     create (or adopt) this run's worktree, excluded from
                                     the repo's status; under .claude/worktrees/ when the
                                     harness is Claude Code, else .worktrees/
  clerk branch <kebab-name>          the in-place counterpart: a feature branch when
                                     standing on the default one, else a no-op
  clerk next [--allow-dirty] [--tasks-file <f>]
                                     the first task whose dependencies are all done;
                                     exit 3 if a task is still in flight
  clerk finish <n> [--retried] [--tasks-file <f>] -- <files...>
                                     stage those paths, lint the staged set, and only
                                     then mark the task done; exit 1 on a finding
                                     (`complete` is accepted too, but some sandboxes
                                     refuse that word as the bash builtin)
  clerk status [--all] [--tasks-file <f>]
                                     progress from the sidecar, for a human, plus each
                                     task's assessed certainty and blast radius; --all
                                     walks every breakdown, archived ones included
  clerk receipt --command <cmd> (--passed|--failed) [--output-file <f>]
                                     record a suite run against the SHA it describes
  clerk gate [--audit-accepted] [--tasks-file <f>]
                                     report the landing predicates; exit 0 only if all pass
  clerk land [--integrate|--no-integrate] [--audit-accepted] [--feature-name <n>] [--tasks-file <f>]
                                     archive the breakdown; land the branch only if asked
  clerk verify [--all-closed] [--tasks-file <f>]
                                     the mechanical half of run-verifier
  clerk version

Every flag that takes a value is written --flag <value>.

The commands that resolve a breakdown — next, status, finish, gate, land, verify, and
the sidecar plugin — take --tasks-file to name it when tasks/ holds more than one, and
prepare reports every breakdown it found. verify wants it for the same reason finish
does: per-task file records are filed under the breakdown they belong to, so naming the
wrong one, or none where several are in flight, reads another story's records or no
records at all. land removes a breakdown's records when it archives it.

Per-repo flag defaults — in_place, integrate, review_breakdown, gears — come from
tasks/clerk.json (tracked, a team decision) or tasks/.environment (gitignored,
machine-local), in that order. `clerk init` scaffolds the first one. prepare reports the
resolved values as `flags` and where each came from as `flag_sources`; land applies
`integrate` itself. A flag typed on the command line always wins, and --no-integrate
turns off what a config file switched on. Pass the request to `prepare --request` and it
applies that top layer too, reporting `request` as the source; a request saying both
reads as off.

`gears` alone changes nothing a command does: it tells the skill reading it whether to
act on each task's certainty and blast radius or merely report them. Off — the default —
every task is built straight through, which is what a run does with no configuration at
all. `clerk status` reports the assessment either way.

Everything here is mechanical. Judgment — writing code, reviewing it, deciding a fix
is right — stays with the caller.
EOF
  list_plugins
}

# What a plugin says it is: the first line of its docstring reading `clerk <name> — ...`.
# Read from the file rather than kept here, so the listing cannot go stale; an executable
# that answers to two names (clerk-audit is clerk-step) carries a line for each.
plugin_desc() {  # <file> <name>
  awk -v n="$2" 'NR > 40 { exit } { sub(/^"""/, "") }
    index($0, "clerk " n " — ") == 1 { print substr($0, length("clerk " n " — ") + 1); exit }' "$1" 2>/dev/null
}

# An executable named clerk-<name> on PATH, or beside this script, is a subcommand — the
# same two places plugin_bin looks, in the same order. Listing what is actually installed
# beats naming them here, which would go stale the moment one is added.
list_plugins() {
  local dir f name found=
  printf '\nSUBCOMMANDS  (clerk-<name> on PATH, or beside clerk; `clerk <name> --help` for each)\n'
  IFS=:
  for dir in $PATH $(self_dir); do
    [ -d "$dir" ] || continue
    for f in "$dir"/clerk-*; do
      [ -x "$f" ] && [ -f "$f" ] || continue
      name=$(basename "$f"); name=${name#clerk-}
      case " $found " in *" $name "*) continue ;; esac
      found="$found $name"
      printf '  clerk %-12s %s\n' "$name" "$(plugin_desc "$f" "$name")"
    done
  done
  unset IFS
  [ -n "$found" ] || printf '  (none installed)\n'
}

need git
need jq

# Plugins whose running is evidence `clerk step` reads. Listed rather than "all of them":
# the reads — step itself, audit, stack, story, models — run many times a step and say
# nothing about progress, and the list is what keeps their cost at zero.
LOGGED_PLUGINS=' finish receipt guidelines lint fixup learn sidecar '

case "${1:-}" in
  init)     shift; logged init cmd_init "$@" ;;
  worktree) shift; logged worktree cmd_worktree "$@" ;;
  branch)   shift; logged branch cmd_branch "$@" ;;
  verify)   shift; logged verify cmd_verify "$@" ;;
  land)     shift; logged land cmd_land "$@" ;;
  gate)    shift; cmd_gate "$@" ;;
  version) printf 'clerk %s\n' "$CLERK_VERSION" ;;
  ''|-h|--help|help) usage ;;
  *)
    # git's model: an executable named clerk-<name> becomes `clerk <name>`. The plugin
    # owns stdio either way and its exit status is clerk's; a logged one is called rather
    # than exec'd so its exit can be recorded on the way out. Built-ins are matched first,
    # above — a plugin cannot shadow one, so what `clerk next` does never depends on what
    # happens to be on PATH.
    if sub=$(plugin_bin "$1"); then
      name=$1; shift
      case "$LOGGED_PLUGINS" in
        *" $name "*)
          ldir=$(ledger_dir 2>/dev/null) || ldir=
          CLERK_OUT=$(mktemp "${TMPDIR:-/tmp}/clerk.XXXXXX") || die "cannot create a temp file"
          trap 'rm -f "$CLERK_OUT"' EXIT
          "$sub" "$@" > "$CLERK_OUT"; rc=$?
          # Exit 2 is a usage error in every plugin, as it is in every built-in, and a
          # usage error is not evidence of anything: the built-ins die before the log.
          [ "$rc" -ne 2 ] && ledger_log "$ldir" "$name" "$rc" "$@"
          with_next "$name" "$rc" "$ldir" "$CLERK_OUT"
          exit $rc ;;
        *) exec "$sub" "$@" ;;
      esac
    fi
    die "unknown command '$1' (try: clerk help)" ;;
esac
